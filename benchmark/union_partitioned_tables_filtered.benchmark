# name: benchmark/union_partitioned_tables_filtered.benchmark
# description: UNION ALL over 20 partitioned Hive tables of 100 partitions of 30 rows each, each branch filtering on the partition key so its scan loads the partitions at filter pushdown, in the local Glue (moto) + S3, whose partitions load concurrently (glue_partition_load_parallelism)
# group: [partition_loading_benchmarks]

name UNION ALL of 20 partitioned hive tables filtered on the partition key
group partition_loading_benchmarks
subgroup partition_prefetch

require parquet

require httpfs

require glue

cache union_partitioned_tables.duckdb

load
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
CREATE TABLE IF NOT EXISTS my_datalake.default.union_partitioned_t01 (id BIGINT, v DOUBLE, dt VARCHAR) PARTITIONED BY (dt);
INSERT INTO my_datalake.default.union_partitioned_t01 SELECT d * 30 + r, random(), 'p' || lpad(d::VARCHAR, 3, '0') FROM range(100) t(d), range(30) u(r) WHERE NOT EXISTS (SELECT 1 FROM my_datalake.default.union_partitioned_t01);
CREATE TABLE IF NOT EXISTS my_datalake.default.union_partitioned_t02 (id BIGINT, v DOUBLE, dt VARCHAR) PARTITIONED BY (dt);
INSERT INTO my_datalake.default.union_partitioned_t02 SELECT d * 30 + r, random(), 'p' || lpad(d::VARCHAR, 3, '0') FROM range(100) t(d), range(30) u(r) WHERE NOT EXISTS (SELECT 1 FROM my_datalake.default.union_partitioned_t02);
