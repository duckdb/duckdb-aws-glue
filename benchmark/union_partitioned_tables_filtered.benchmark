reload
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
USE my_datalake.default;
SET enable_external_file_cache=false;

run
SELECT count(*) FROM (
    SELECT v FROM my_datalake.default.union_partitioned_t01 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t02 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t03 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t04 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t05 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t06 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t07 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t08 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t09 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t10 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t11 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t12 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t13 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t14 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t15 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t16 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t17 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t18 WHERE dt = 'p001' UNION ALL
    SELECT v FROM my_datalake.default.union_partitioned_t19 WHERE dt = 'p001' UNION ALL SELECT v FROM my_datalake.default.union_partitioned_t20 WHERE dt = 'p001');

result I
600
