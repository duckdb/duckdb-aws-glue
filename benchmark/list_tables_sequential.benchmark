# name: benchmark/list_tables_sequential.benchmark
# description: list the tables of 16 databases whose GetTables takes 100 ms, in the local Glue (moto) through the fault proxy, one after another (glue_list_tables_parallelism = 1)
# group: [list_tables_benchmarks]

name List the tables of 16 databases, one after another
group list_tables_benchmarks
subgroup list_tables_sequential

require httpfs

require glue

load
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5556',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_00;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_00.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_01;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_01.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_02;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_02.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_03;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_03.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_04;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_04.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_05;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_05.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_06;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_06.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_07;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_07.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_08;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_08.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_09;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_09.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_10;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_10.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_11;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_11.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_12;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_12.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_13;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_13.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_14;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_14.t (id INTEGER);
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_slow_listing_15;
CREATE TABLE IF NOT EXISTS my_datalake.fault_slow_listing_15.t (id INTEGER);

run
DETACH DATABASE IF EXISTS my_datalake;
ATTACH '123456789012' AS my_datalake (TYPE glue, ENDPOINT 'http://localhost:5556');
SET glue_list_tables_parallelism = 1;
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name LIKE 'fault_slow_listing_%';

result I
16
