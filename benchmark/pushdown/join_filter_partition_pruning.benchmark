# name: benchmark/pushdown/join_filter_partition_pruning.benchmark
# description: join a date-partitioned store_returns with a year-partitioned date_dim (TPC-DS SF1) in the local Glue (moto) + S3 (MinIO)
# group: [pushdown]

# The partitions of store_returns are pruned with the join filter on sr_returned_date_sk that d_year = 2000 produces.
# Like benchmark/tpcds/sf1, the load needs a build without assertions (make release): store_returns has rows with a
# NULL sr_returned_date_sk. The load skips tables that already exist in Glue.

name Join filter prunes store_returns partitions
group pushdown
subgroup sf1

require parquet

require httpfs

require glue

require tpcds

cache glue_pushdown_tpcds_sf1.duckdb

load
CALL dsdgen(sf=1);
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
CREATE SCHEMA IF NOT EXISTS my_datalake.bench_pushdown_tpcds_sf1;
CREATE TABLE IF NOT EXISTS my_datalake.bench_pushdown_tpcds_sf1.store_returns PARTITIONED BY (sr_returned_date_sk) AS SELECT * FROM store_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_pushdown_tpcds_sf1.date_dim PARTITIONED BY (d_year) AS SELECT * FROM date_dim;
DROP TABLE store_sales;
DROP TABLE store_returns;
DROP TABLE catalog_sales;
DROP TABLE catalog_returns;
DROP TABLE web_sales;
DROP TABLE web_returns;
DROP TABLE inventory;
DROP TABLE call_center;
DROP TABLE catalog_page;
DROP TABLE customer;
DROP TABLE customer_address;
DROP TABLE customer_demographics;
DROP TABLE date_dim;
DROP TABLE household_demographics;
DROP TABLE income_band;
DROP TABLE item;
DROP TABLE promotion;
DROP TABLE reason;
DROP TABLE ship_mode;
DROP TABLE store;
DROP TABLE time_dim;
DROP TABLE warehouse;
DROP TABLE web_page;
DROP TABLE web_site;
CREATE TABLE glue_pushdown_tpcds_sf1_loaded AS SELECT 1 AS loaded;
USE my_datalake.bench_pushdown_tpcds_sf1;
SET enable_external_file_cache=false;
SET glue_enable_partition_key_statistics=false;

reload
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
USE my_datalake.bench_pushdown_tpcds_sf1;
SET enable_external_file_cache=false;
SET glue_enable_partition_key_statistics=false;

run
SELECT count(*) FROM store_returns, date_dim
WHERE sr_returned_date_sk = d_date_sk AND d_year = 2000;

result I
55820
