# name: benchmark/tpcds/planning/cloud_sf100/q22.benchmark
# description: Plan (EXPLAIN) query 22 from the TPC-DS benchmark at SF100 on the partitioned parquet tables in the AWS Glue catalog
# group: [cloud_sf100]

include benchmark/tpcds/cloud_sf100/tpcds_cloud_glue.benchmark.in

name DSQ22_plan_cloud_sf100_partitioned
group tpcds_glue_cloud_planning
subgroup sf100_partitioned

run
EXPLAIN
SELECT i_product_name ,
       i_brand ,
       i_class ,
       i_category ,
       avg(inv_quantity_on_hand) qoh
FROM inventory ,
     date_dim ,
     item
WHERE inv_date_sk=d_date_sk
  AND inv_item_sk=i_item_sk
  AND d_month_seq BETWEEN 1200 AND 1200 + 11
GROUP BY rollup(i_product_name ,i_brand ,i_class ,i_category)
ORDER BY qoh NULLS FIRST,
         i_product_name NULLS FIRST,
         i_brand NULLS FIRST,
         i_class NULLS FIRST,
         i_category NULLS FIRST
LIMIT 100;
