# name: benchmark/tpcds/planning/cloud_sf100/q55.benchmark
# description: Plan (EXPLAIN) query 55 from the TPC-DS benchmark at SF100 on the partitioned parquet tables in the AWS Glue catalog
# group: [cloud_sf100]

include benchmark/tpcds/cloud_sf100/tpcds_cloud_glue.benchmark.in

name DSQ55_plan_cloud_sf100_partitioned
group tpcds_glue_cloud_planning
subgroup sf100_partitioned

run
EXPLAIN
SELECT i_brand_id brand_id,
       i_brand brand,
       sum(ss_ext_sales_price) ext_price
FROM date_dim,
     store_sales,
     item
WHERE d_date_sk = ss_sold_date_sk
  AND ss_item_sk = i_item_sk
  AND i_manager_id=28
  AND d_moy=11
  AND d_year=1999
GROUP BY i_brand,
         i_brand_id
ORDER BY ext_price DESC,
         i_brand_id
LIMIT 100 ;
