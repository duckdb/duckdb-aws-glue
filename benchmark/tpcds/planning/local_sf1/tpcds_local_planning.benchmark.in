# name: benchmark/tpcds/planning/local_sf1/tpcds_local_planning.benchmark.in
# description: Plan (EXPLAIN) a TPC-DS query at SF1 on daily-partitioned parquet tables in the local Glue (moto) + S3
# group: [local_sf1]

# The layout of benchmark/tpcds/planning/cloud_sf100 at SF1: the fact tables have one partition per day of their date
# key (ss_sold_date_sk, ...; SF1 has as many days as SF100), so planning makes as many Glue and S3 requests. The load
# writes the tables through moto (port 5555) and SeaweedFS (port 9100) directly; the queries are planned through the
# latency proxies of scripts/docker-compose.yml (ports 5558 and 9101, scripts/latency_proxy.py), which delay every
# request the way a round trip to AWS does, so a request made after another one costs time and requests made at the
# same time share it. The load skips tables that already exist in Glue, and needs a build without assertions (make
# release): writing a partition with a NULL value trips a D_ASSERT (see benchmark/tpcds/tpcds.benchmark.in).

require parquet

require httpfs

require glue

require tpcds

cache glue_planning_tpcds_sf1_daily.duckdb

init
SET VARIABLE tpcds_query = (SELECT content FROM read_text('duckdb/extension/tpcds/dsdgen/queries/${QUERY_NUMBER_PADDED}.sql'));

load
CALL dsdgen(sf=1);
CREATE OR REPLACE SECRET glue_s3 (TYPE S3, KEY_ID 'minio', SECRET 'minio123', REGION 'us-east-1', ENDPOINT 'localhost:9100', USE_SSL false, URL_STYLE 'path');
ATTACH '123456789012' AS my_datalake (TYPE glue, ENDPOINT 'http://localhost:5555', DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark');
CREATE SCHEMA IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.store_sales PARTITIONED BY (ss_sold_date_sk) WITH (format = 'parquet') AS SELECT * FROM store_sales;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.store_returns PARTITIONED BY (sr_returned_date_sk) WITH (format = 'parquet') AS SELECT * FROM store_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.catalog_sales PARTITIONED BY (cs_sold_date_sk) WITH (format = 'parquet') AS SELECT * FROM catalog_sales;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.catalog_returns PARTITIONED BY (cr_returned_date_sk) WITH (format = 'parquet') AS SELECT * FROM catalog_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.web_sales PARTITIONED BY (ws_sold_date_sk) WITH (format = 'parquet') AS SELECT * FROM web_sales;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.web_returns PARTITIONED BY (wr_returned_date_sk) WITH (format = 'parquet') AS SELECT * FROM web_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.inventory PARTITIONED BY (inv_date_sk) WITH (format = 'parquet') AS SELECT * FROM inventory;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.call_center WITH (format = 'parquet') AS SELECT * FROM call_center;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.catalog_page WITH (format = 'parquet') AS SELECT * FROM catalog_page;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.customer WITH (format = 'parquet') AS SELECT * FROM customer;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.customer_address WITH (format = 'parquet') AS SELECT * FROM customer_address;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.customer_demographics WITH (format = 'parquet') AS SELECT * FROM customer_demographics;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.date_dim WITH (format = 'parquet') AS SELECT * FROM date_dim;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.household_demographics WITH (format = 'parquet') AS SELECT * FROM household_demographics;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.income_band WITH (format = 'parquet') AS SELECT * FROM income_band;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.item WITH (format = 'parquet') AS SELECT * FROM item;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.promotion WITH (format = 'parquet') AS SELECT * FROM promotion;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.reason WITH (format = 'parquet') AS SELECT * FROM reason;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.ship_mode WITH (format = 'parquet') AS SELECT * FROM ship_mode;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.store WITH (format = 'parquet') AS SELECT * FROM store;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.time_dim WITH (format = 'parquet') AS SELECT * FROM time_dim;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.warehouse WITH (format = 'parquet') AS SELECT * FROM warehouse;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.web_page WITH (format = 'parquet') AS SELECT * FROM web_page;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1_daily.web_site WITH (format = 'parquet') AS SELECT * FROM web_site;
DROP TABLE store_sales;
DROP TABLE store_returns;
DROP TABLE catalog_sales;
DROP TABLE catalog_returns;
DROP TABLE web_sales;
DROP TABLE web_returns;
DROP TABLE inventory;
DROP TABLE call_center;
DROP TABLE catalog_page;
DROP TABLE customer;
DROP TABLE customer_address;
DROP TABLE customer_demographics;
DROP TABLE date_dim;
DROP TABLE household_demographics;
DROP TABLE income_band;
DROP TABLE item;
DROP TABLE promotion;
DROP TABLE reason;
DROP TABLE ship_mode;
DROP TABLE store;
DROP TABLE time_dim;
DROP TABLE warehouse;
DROP TABLE web_page;
DROP TABLE web_site;
CREATE TABLE glue_planning_tpcds_sf1_daily_loaded AS SELECT 1 AS loaded;
DETACH my_datalake;
CREATE OR REPLACE SECRET glue_s3 (TYPE S3, KEY_ID 'minio', SECRET 'minio123', REGION 'us-east-1', ENDPOINT 'localhost:9101', USE_SSL false, URL_STYLE 'path');
ATTACH '123456789012' AS my_datalake (TYPE glue, ENDPOINT 'http://localhost:5558', READ_ONLY);
USE my_datalake.bench_tpcds_sf1_daily;
SET enable_external_file_cache=false;

reload
CREATE OR REPLACE SECRET glue_s3 (TYPE S3, KEY_ID 'minio', SECRET 'minio123', REGION 'us-east-1', ENDPOINT 'localhost:9101', USE_SSL false, URL_STYLE 'path');
ATTACH '123456789012' AS my_datalake (TYPE glue, ENDPOINT 'http://localhost:5558', READ_ONLY);
USE my_datalake.bench_tpcds_sf1_daily;
SET enable_external_file_cache=false;

name DSQ${QUERY_NUMBER_PADDED}_plan_local_sf1_daily
group tpcds_glue_planning
subgroup local_sf1_daily

run
EXPLAIN FROM query(getvariable('tpcds_query'))
