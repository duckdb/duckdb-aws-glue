# name: benchmark/tpcds/cloud_sf100/partitioned/q14.benchmark
# description: Run query 14 from the TPC-DS benchmark at SF100 on the partitioned parquet tables in the AWS Glue catalog
# group: [partitioned]

include benchmark/tpcds/cloud_sf100/tpcds_cloud_glue.benchmark.in

name DSQ14_cloud_sf100_partitioned
group tpcds_glue_cloud
subgroup sf100_partitioned

run duckdb/extension/tpcds/dsdgen/queries/14.sql

result duckdb/extension/tpcds/dsdgen/answers/sf100/14.csv
