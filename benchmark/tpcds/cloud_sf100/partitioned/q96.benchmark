# name: benchmark/tpcds/cloud_sf100/partitioned/q96.benchmark
# description: Run query 96 from the TPC-DS benchmark at SF100 on the partitioned parquet tables in the AWS Glue catalog
# group: [partitioned]

include benchmark/tpcds/cloud_sf100/tpcds_cloud_glue.benchmark.in

name DSQ96_cloud_sf100_partitioned
group tpcds_glue_cloud
subgroup sf100_partitioned

run duckdb/extension/tpcds/dsdgen/queries/96.sql

result duckdb/extension/tpcds/dsdgen/answers/sf100/96.csv
