# name: benchmark/heavily_partitioned_table.benchmark
# description: read 20 of the 300 partitions of a heavily partitioned Hive table in the local Glue (moto) + S3 (MinIO)
# group: [file_pruning_benchmarks]

name Read 20 of 300 partitions of a heavily partitioned hive table
group file_pruning_benchmarks
subgroup partition_pruning

require parquet

require httpfs

require glue

cache check_file_prune.duckdb

load
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
CREATE TABLE IF NOT EXISTS my_datalake.default.many_partitioned_tables (
    id BIGINT,
    payload VARCHAR,
    value DOUBLE,
    dt VARCHAR
) PARTITIONED BY (dt);
INSERT INTO my_datalake.default.many_partitioned_tables
SELECT
    d * 100 + r                                                  AS id,
    (d * 100 + r)::VARCHAR                                       AS payload,
    random() * 1000                                              AS value,
    strftime(DATE '2026-01-01' + d::INTEGER, '%Y-%m-%d')         AS dt
FROM range(0, 300) AS t(d)
CROSS JOIN range(1, 10001) AS u(r)
WHERE NOT EXISTS (SELECT 1 FROM my_datalake.default.many_partitioned_tables);

reload
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
USE my_datalake.default;
SET enable_external_file_cache=false;
SET debug_fs_delay_mean_ms=20;

run
SET enable_external_file_cache=false;
SET debug_fs_delay_mean_ms=20;
SELECT sum(value)
FROM my_datalake.default.many_partitioned_tables
WHERE dt in (
'2026-04-30',
'2026-09-30',
'2026-05-05',
'2026-09-18',
'2026-04-24',
'2026-04-27',
'2026-03-24',
'2026-07-25',
'2026-01-27',
'2026-09-24',
'2026-02-01',
'2026-04-29',
'2026-01-29',
'2026-01-30',
'2026-03-04',
'2026-05-15',
'2026-10-13',
'2026-08-05',
'2026-01-03',
'2026-08-26'
);
