# name: test/sql/hive/ddl/ctas/ctas_hugeint.test
# description: HUGEINT columns (e.g. sum() of an integer column) are stored as decimal(38,0)
# group: [ctas]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_TEST_DB

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ctas_sum;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_sum AS
SELECT g, count(*) AS n, sum(i) AS s, sum(b) AS sb
FROM (SELECT range % 2 AS g, range::INTEGER AS i, (range + 9007199254740990)::BIGINT AS b FROM range(10)) GROUP BY g;

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.ctas_sum'));
----
g	bigint
n	bigint
s	decimal(38,0)
sb	decimal(38,0)

# above 2^53, so a DOUBLE would round it
query IIII
SELECT g, n, s, sb FROM my_datalake.{GLUE_TEST_DB}.ctas_sum ORDER BY g;
----
0	5	20	45035996273704970
1	5	25	45035996273704975

query II
SELECT name, logical_type FROM parquet_schema('{DEFAULT_S3_LOCATION}/{TEST_DIR}/{GLUE_TEST_DB}/ctas_sum/*.parquet') WHERE name IN ('s', 'sb') GROUP BY ALL ORDER BY name;
----
s	DecimalType(scale=0, precision=38)
sb	DecimalType(scale=0, precision=38)

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.ctas_sum;

# unsigned columns are written as the signed type the table declares
statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ctas_unsigned;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_unsigned AS
SELECT 200::UTINYINT AS ut, 60000::USMALLINT AS us, 4000000000::UINTEGER AS ui;

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.ctas_unsigned'));
----
ut	smallint
us	int
ui	bigint

query III
SELECT name, type, converted_type FROM parquet_schema('{DEFAULT_S3_LOCATION}/{TEST_DIR}/{GLUE_TEST_DB}/ctas_unsigned/*.parquet') WHERE name IN ('ut', 'us', 'ui') GROUP BY ALL ORDER BY name;
----
ui	INT64	INT_64
us	INT32	INT_32
ut	INT32	INT_16

query III
SELECT ut, us, ui FROM my_datalake.{GLUE_TEST_DB}.ctas_unsigned;
----
200	60000	4000000000

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.ctas_unsigned;

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ctas_wide_ints;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_wide_ints AS
SELECT '99999999999999999999999999999999999999'::HUGEINT AS h, '-99999999999999999999999999999999999999'::HUGEINT AS h_min;

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.ctas_wide_ints'));
----
h	decimal(38,0)
h_min	decimal(38,0)

query II
SELECT h, h_min FROM my_datalake.{GLUE_TEST_DB}.ctas_wide_ints;
----
99999999999999999999999999999999999999	-99999999999999999999999999999999999999

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.ctas_wide_ints;

# UBIGINT and UHUGEINT have no Hive type
statement error
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_ubigint AS SELECT 18446744073709551615::UBIGINT AS ub;
----
DuckDB type 'UBIGINT' can not be converted to a Glue type

statement error
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_uhugeint AS SELECT 1::UHUGEINT AS uh;
----
DuckDB type 'UHUGEINT' can not be converted to a Glue type

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ctas_hugeint_overflow;

statement error
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_hugeint_overflow AS SELECT '100000000000000000000000000000000000000'::HUGEINT AS h;
----
Could not cast value

statement error
SELECT * FROM my_datalake.{GLUE_TEST_DB}.ctas_hugeint_overflow;
----
does not exist

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ctas_hugeint_nested;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_hugeint_nested AS
SELECT [sum(range)] AS l, {'x': sum(range)} AS st, MAP {'k': sum(range)} AS m FROM range(4);

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.ctas_hugeint_nested'));
----
l	array<decimal(38,0)>
st	struct<x:decimal(38,0)>
m	map<string,decimal(38,0)>

query III
SELECT l, st.x, m['k'] FROM my_datalake.{GLUE_TEST_DB}.ctas_hugeint_nested;
----
[6]	6	6

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.ctas_hugeint_nested;

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ctas_hugeint_part;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ctas_hugeint_part PARTITIONED BY (p) AS
SELECT range AS id, (range % 2)::HUGEINT AS p FROM range(4);

query II
SELECT c.name, c.type FROM (SELECT unnest(partition_keys) AS c FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.ctas_hugeint_part'));
----
p	decimal(38,0)

query II
SELECT p, count(*) FROM my_datalake.{GLUE_TEST_DB}.ctas_hugeint_part GROUP BY p ORDER BY p;
----
0	2
1	2

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.ctas_hugeint_part;

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.create_hugeint;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.create_hugeint (id INTEGER, h HUGEINT);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND schema_name = '{GLUE_TEST_DB}' AND table_name = 'create_hugeint' ORDER BY column_index;
----
id	INTEGER
h	DECIMAL(38,0)

statement ok
INSERT INTO my_datalake.{GLUE_TEST_DB}.create_hugeint SELECT 1, sum(range) FROM range(5);

query II
SELECT id, h FROM my_datalake.{GLUE_TEST_DB}.create_hugeint;
----
1	10

statement error
INSERT INTO my_datalake.{GLUE_TEST_DB}.create_hugeint VALUES (2, '100000000000000000000000000000000000000'::HUGEINT);
----
Could not cast value

query II
SELECT id, h FROM my_datalake.{GLUE_TEST_DB}.create_hugeint;
----
1	10

statement ok
ALTER TABLE my_datalake.{GLUE_TEST_DB}.create_hugeint ADD COLUMN h2 HUGEINT;

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.create_hugeint'));
----
id	int
h	decimal(38,0)
h2	decimal(38,0)

statement error
ALTER TABLE my_datalake.{GLUE_TEST_DB}.create_hugeint ALTER COLUMN id TYPE HUGEINT;
----
Can not change column "id"

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.create_hugeint;
