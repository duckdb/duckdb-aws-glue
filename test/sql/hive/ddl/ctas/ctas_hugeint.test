# name: test/sql/hive/ddl/ctas/ctas_hugeint.test
# description: HUGEINT and UHUGEINT columns (e.g. sum() of an integer column) are stored as decimal(38,0)
# group: [ctas]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_sum;

statement ok
CREATE TABLE my_datalake.default.ctas_sum AS
SELECT g, count(*) AS n, sum(i) AS s, sum(b) AS sb
FROM (SELECT range % 2 AS g, range::INTEGER AS i, (range + 9007199254740990)::BIGINT AS b FROM range(10)) GROUP BY g;

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.default.ctas_sum'));
----
g	bigint
n	bigint
s	decimal(38,0)
sb	decimal(38,0)

# above 2^53, so a DOUBLE would round it
query IIII
SELECT g, n, s, sb FROM my_datalake.default.ctas_sum ORDER BY g;
----
0	5	20	45035996273704970
1	5	25	45035996273704975

query II
SELECT name, logical_type FROM parquet_schema('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ctas_sum/*.parquet') WHERE name IN ('s', 'sb') GROUP BY ALL ORDER BY name;
----
s	DecimalType(scale=0, precision=38)
sb	DecimalType(scale=0, precision=38)

statement ok
DROP TABLE my_datalake.default.ctas_sum;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_wide_ints;

statement ok
CREATE TABLE my_datalake.default.ctas_wide_ints AS
SELECT '99999999999999999999999999999999999999'::HUGEINT AS h, '-99999999999999999999999999999999999999'::HUGEINT AS h_min,
       '99999999999999999999999999999999999999'::UHUGEINT AS uh;

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.default.ctas_wide_ints'));
----
h	decimal(38,0)
h_min	decimal(38,0)
uh	decimal(38,0)

query III
SELECT h, h_min, uh FROM my_datalake.default.ctas_wide_ints;
----
99999999999999999999999999999999999999	-99999999999999999999999999999999999999	99999999999999999999999999999999999999

statement ok
DROP TABLE my_datalake.default.ctas_wide_ints;

# UBIGINT has no Hive type
statement error
CREATE TABLE my_datalake.default.ctas_ubigint AS SELECT 18446744073709551615::UBIGINT AS ub;
----
DuckDB type 'UBIGINT' can not be converted to a Glue type

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_hugeint_overflow;

statement error
CREATE TABLE my_datalake.default.ctas_hugeint_overflow AS SELECT '100000000000000000000000000000000000000'::HUGEINT AS h;
----
Could not cast value

statement error
SELECT * FROM my_datalake.default.ctas_hugeint_overflow;
----
does not exist

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_hugeint_nested;

statement ok
CREATE TABLE my_datalake.default.ctas_hugeint_nested AS
SELECT [sum(range)] AS l, {'x': sum(range)} AS st, MAP {'k': sum(range)} AS m FROM range(4);

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.default.ctas_hugeint_nested'));
----
l	array<decimal(38,0)>
st	struct<x:decimal(38,0)>
m	map<string,decimal(38,0)>

query III
SELECT l, st.x, m['k'] FROM my_datalake.default.ctas_hugeint_nested;
----
[6]	6	6

statement ok
DROP TABLE my_datalake.default.ctas_hugeint_nested;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_hugeint_part;

statement ok
CREATE TABLE my_datalake.default.ctas_hugeint_part PARTITIONED BY (p) AS
SELECT range AS id, (range % 2)::HUGEINT AS p FROM range(4);

query II
SELECT c.name, c.type FROM (SELECT unnest(partition_keys) AS c FROM glue_get_table_response('my_datalake.default.ctas_hugeint_part'));
----
p	decimal(38,0)

query II
SELECT p, count(*) FROM my_datalake.default.ctas_hugeint_part GROUP BY p ORDER BY p;
----
0	2
1	2

statement ok
DROP TABLE my_datalake.default.ctas_hugeint_part;

statement ok
DROP TABLE IF EXISTS my_datalake.default.create_hugeint;

statement ok
CREATE TABLE my_datalake.default.create_hugeint (id INTEGER, h HUGEINT);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'create_hugeint' ORDER BY column_index;
----
id	INTEGER
h	DECIMAL(38,0)

statement ok
INSERT INTO my_datalake.default.create_hugeint SELECT 1, sum(range) FROM range(5);

query II
SELECT id, h FROM my_datalake.default.create_hugeint;
----
1	10

statement ok
DROP TABLE my_datalake.default.create_hugeint;
