# name: test/sql/hive/ddl/ctas/ctas_overwrite_location.test
# description: CREATE TABLE AS deletes the data files already at its location with WITH (overwrite = true)
# group: [ctas]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ow_table;

# a dropped table leaves its files, and Spark's _SUCCESS marker, at the location
statement ok
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table')
AS SELECT range AS id FROM range(3);

statement ok
COPY (SELECT 'done' AS marker) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table/_SUCCESS' (FORMAT csv);

statement ok
DROP TABLE my_datalake.default.ow_table;

statement error
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table')
AS SELECT range AS id FROM range(5);
----
<REGEX>:.*already holds files.*WITH \(overwrite = true\) to delete them.*

# planning deletes nothing
statement ok
EXPLAIN CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table', overwrite = true)
AS SELECT range AS id FROM range(5);

query I
SELECT count(*) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table/*.parquet');
----
3

# the option deletes the old data files and leaves the marker, and is not stored in Glue
statement ok
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table', overwrite = true)
AS SELECT range AS id FROM range(5);

query II
SELECT count(*), sum(id) FROM my_datalake.default.ow_table;
----
5	10

query I
SELECT count(*) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table/*.parquet');
----
5

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table/_SUCCESS');
----
1

query I
SELECT parameters['overwrite'] IS NULL FROM glue_get_table_response('my_datalake.default.ow_table');
----
true

# overwrite = false is the default: the files at the location refuse the statement
statement ok
DROP TABLE my_datalake.default.ow_table;

statement error
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table', overwrite = false)
AS SELECT range AS id FROM range(2);
----
<REGEX>:.*already holds files.*

# not with CREATE OR REPLACE: the files would be deleted before the table is replaced; nothing is deleted
statement error
CREATE OR REPLACE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table', overwrite = true)
AS SELECT range AS id FROM range(2);
----
<REGEX>:.*CREATE OR REPLACE TABLE \.\.\. AS with option 'overwrite' is not supported.*

query I
SELECT count(*) > 0 FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table/*.parquet');
----
true

# not over the files of a table in the same database: neither at its location nor at a location holding it
statement ok
DROP TABLE IF EXISTS my_datalake.default.ow_live;

statement ok
CREATE TABLE my_datalake.default.ow_live WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_outer/ow_live')
AS SELECT range AS id FROM range(4);

statement error
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_outer/ow_live/', overwrite = true)
AS SELECT range AS id FROM range(2);
----
<REGEX>:.*overlaps the location .* of table 'default\.ow_live', whose files it would delete.*

statement error
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_outer', overwrite = true)
AS SELECT range AS id FROM range(2);
----
<REGEX>:.*overlaps the location .* of table 'default\.ow_live', whose files it would delete.*

query II
SELECT count(*), sum(id) FROM my_datalake.default.ow_live;
----
4	6

statement ok
DROP TABLE my_datalake.default.ow_live;

# a table created without a query writes no files
statement error
CREATE TABLE my_datalake.default.ow_plain (id INTEGER) WITH (overwrite = true);
----
<REGEX>:.*option 'overwrite' is only for CREATE TABLE \.\.\. AS.*

statement error
CREATE TABLE my_datalake.default.ow_table WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ow_table', overwrite = 'maybe')
AS SELECT range AS id FROM range(2);
----
<REGEX>:.*Could not convert string 'maybe' to BOOL.*

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name IN ('ow_table', 'ow_plain', 'ow_live');
----
0
