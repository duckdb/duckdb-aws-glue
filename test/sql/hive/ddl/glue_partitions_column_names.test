# name: test/sql/hive/ddl/glue_partitions_column_names.test
# description: glue_partitions() lists a table whose partition keys are called location or partition_values
# group: [ddl]

# glue_partitions() returns a typed column per partition key and then location and partition_values. A partition key
# may have either name; the key keeps its name and the listing's column is numbered the way DuckDB numbers duplicate
# result columns. Column names compare case-insensitively.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.gp_cn_location;

statement ok
DROP TABLE IF EXISTS my_datalake.default.gp_cn_data_column;

# ===========================================================================
# partition keys called Location, LOCATION_1 and Partition_Values
# ===========================================================================
statement ok
CREATE TABLE my_datalake.default.gp_cn_location (id INTEGER, "Location" VARCHAR, "LOCATION_1" VARCHAR, "Partition_Values" VARCHAR) PARTITIONED BY ("Location", "LOCATION_1", "Partition_Values");

statement ok
CALL glue_add_partition('my_datalake.default.gp_cn_location', {"Location": 'us', "LOCATION_1": 'west', "Partition_Values": 'a'});

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM glue_partitions('my_datalake.default.gp_cn_location'));
----
Location	VARCHAR
LOCATION_1	VARCHAR
Partition_Values	VARCHAR
location_2	VARCHAR
partition_values_1	VARCHAR[]

# the key columns hold the values, the listing columns the S3 location and the stored strings
query IIIII
SELECT "Location", "LOCATION_1", "Partition_Values", location_2 LIKE '%/gp_cn_location/Location=us/LOCATION_1=west/Partition_Values=a', partition_values_1 FROM glue_partitions('my_datalake.default.gp_cn_location');
----
us	west	a	true	[us, west, a]

# ===========================================================================
# a data column called location is not a partition key and does not take part
# ===========================================================================
statement ok
CREATE TABLE my_datalake.default.gp_cn_data_column (id INTEGER, location VARCHAR, dt VARCHAR) PARTITIONED BY (dt);

statement ok
CALL glue_add_partition('my_datalake.default.gp_cn_data_column', {dt: 'd1'});

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM glue_partitions('my_datalake.default.gp_cn_data_column'));
----
dt	VARCHAR
location	VARCHAR
partition_values	VARCHAR[]

statement ok
DROP TABLE my_datalake.default.gp_cn_location;

statement ok
DROP TABLE my_datalake.default.gp_cn_data_column;
