# name: test/sql/hive/ddl/views/test_view_iceberg_catalogs.test
# description: experimental_glue_view_iceberg_catalogs is global only and checked when set, changes nothing for views over Hive and external tables, and refuses a mapped catalog that is not an Iceberg catalog serving the id
# group: [views]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
RESET experimental_glue_view_iceberg_catalogs;

statement ok
RESET experimental_glue_view_external_catalog_types;

statement ok
DROP VIEW IF EXISTS my_datalake.default.ic_hive;

statement ok
DROP VIEW IF EXISTS my_datalake.default.ic_hive_mapped;

statement ok
DROP VIEW IF EXISTS my_datalake.default.ic_external;

statement ok
DROP VIEW IF EXISTS my_datalake.default.ic_refused;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ic_orders;

statement ok
CREATE TABLE my_datalake.default.ic_orders (id INTEGER, qty INTEGER);

statement ok
INSERT INTO my_datalake.default.ic_orders VALUES (1, 10), (2, 20);

statement ok
ATTACH '{TEST_DIR}/ic_catalog.duckdb' AS ic_ext;

statement ok
CREATE OR REPLACE TABLE ic_ext.main.ic_items AS SELECT * FROM (VALUES (1, 'a'), (2, 'b')) t(id, name);

# global only
query I
SELECT cardinality(current_setting('experimental_glue_view_iceberg_catalogs'));
----
0

statement error
SET SESSION experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': 'ic_ext'};
----
cannot be set as a session variable - it can only be set globally

statement error
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': ''};
----
experimental_glue_view_iceberg_catalogs: a Glue catalog id and a catalog alias can not be NULL or empty

statement error
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': NULL};
----
experimental_glue_view_iceberg_catalogs: a Glue catalog id and a catalog alias can not be NULL or empty

statement error
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'': 'ic_ext'};
----
experimental_glue_view_iceberg_catalogs: a Glue catalog id and a catalog alias can not be NULL or empty

statement error
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}:S3TablesCatalog/b': 'ic_a', '{GLUE_CATALOG_ID}:s3tablescatalog/b': 'ic_b'};
----
experimental_glue_view_iceberg_catalogs: Glue catalog id '{GLUE_CATALOG_ID}:s3tablescatalog/b' is mapped more than once

query I
SELECT cardinality(current_setting('experimental_glue_view_iceberg_catalogs'));
----
0

statement ok
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': 'ic_a', '{GLUE_CATALOG_ID}:s3tablescatalog/b': 'ic_b'};

query I
SELECT cardinality(current_setting('experimental_glue_view_iceberg_catalogs'));
----
2

statement ok
RESET experimental_glue_view_iceberg_catalogs;

# not set: views are stored as before
statement ok
CREATE VIEW my_datalake.default.ic_hive AS SELECT id, qty FROM ic_orders WHERE qty > 10;

# a refused table before a table function: the table's error, as before
statement error
CREATE VIEW my_datalake.default.ic_refused AS SELECT * FROM ic_ext.main.ic_items, range(3);
----
Glue view references "ic_ext.main.ic_items" in catalog "ic_ext" of type duckdb, which is not in experimental_glue_view_external_catalog_types: add 'duckdb' to it

# set, with mappings no table of the view uses (one to a catalog that is not attached): the same
statement ok
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': 'ic_missing', '{GLUE_CATALOG_ID}:s3tablescatalog/ic-bucket': 'ic_ext'};

statement ok
CREATE VIEW my_datalake.default.ic_hive_mapped AS SELECT id, qty FROM ic_orders WHERE qty > 10;

query II
SELECT response.ViewOriginalText, response.ViewExpandedText FROM glue_get_table_response('my_datalake.default.ic_hive');
----
SELECT id, qty FROM ic_orders WHERE (qty > 10)
SELECT id, qty FROM "default".ic_orders WHERE (qty > 10)

query II
SELECT response.ViewOriginalText, response.ViewExpandedText FROM glue_get_table_response('my_datalake.default.ic_hive_mapped');
----
SELECT id, qty FROM ic_orders WHERE (qty > 10)
SELECT id, qty FROM "default".ic_orders WHERE (qty > 10)

# a Hive table is read from Glue, whatever its catalog id is mapped to
query II
SELECT * FROM my_datalake.default.ic_hive;
----
2	20

query II
SELECT * FROM my_datalake.default.ic_hive_mapped;
----
2	20

# a catalog no id is mapped to is an external catalog, stored by its type and alias as before
statement ok
SET GLOBAL experimental_glue_view_external_catalog_types = ['duckdb'];

statement ok
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': 'ic_missing'};

statement ok
CREATE VIEW my_datalake.default.ic_external AS SELECT o.id, i.name FROM ic_orders o JOIN ic_ext.main.ic_items i USING (id);

query I
SELECT response.ViewExpandedText FROM glue_get_table_response('my_datalake.default.ic_external');
----
SELECT o.id, i."name" FROM ("default".ic_orders AS o INNER JOIN "external:duckdb:ic_ext".main.ic_items AS i USING (id))

query II
SELECT * FROM my_datalake.default.ic_external ORDER BY id;
----
1	a
2	b

# a mapped catalog must be an Iceberg catalog serving the id; checked when a view names a table through it
statement ok
SET GLOBAL experimental_glue_view_iceberg_catalogs = MAP {'{GLUE_CATALOG_ID}': 'ic_ext'};

statement error
CREATE VIEW my_datalake.default.ic_refused AS SELECT id, name FROM ic_ext.main.ic_items;
----
experimental_glue_view_iceberg_catalogs maps Glue catalog id '{GLUE_CATALOG_ID}' to catalog "ic_ext", which does not serve it: it is a catalog of type duckdb, not iceberg

# the mapping is checked in the order of the body, before a later table function
statement error
CREATE VIEW my_datalake.default.ic_refused AS SELECT * FROM ic_ext.main.ic_items, range(3);
----
to catalog "ic_ext", which does not serve it: it is a catalog of type duckdb, not iceberg

statement error
CREATE VIEW my_datalake.default.ic_refused AS SELECT id, name FROM ic_ext.ic_items;
----
to catalog "ic_ext", which does not serve it: it is a catalog of type duckdb, not iceberg

statement ok
USE ic_ext.main;

statement error
CREATE VIEW my_datalake.default.ic_refused AS SELECT id, name FROM ic_items;
----
to catalog "ic_ext", which does not serve it: it is a catalog of type duckdb, not iceberg

statement ok
USE memory.main;

statement error
SELECT * FROM my_datalake.default.ic_refused;
----
does not exist

# the views stored before still read: their tables are not Iceberg tables
query II
SELECT * FROM my_datalake.default.ic_external ORDER BY id;
----
1	a
2	b

query II
SELECT * FROM my_datalake.default.ic_hive_mapped;
----
2	20

statement ok
RESET experimental_glue_view_iceberg_catalogs;

statement ok
RESET experimental_glue_view_external_catalog_types;

statement ok
DROP VIEW my_datalake.default.ic_hive;

statement ok
DROP VIEW my_datalake.default.ic_hive_mapped;

statement ok
DROP VIEW my_datalake.default.ic_external;

statement ok
DROP TABLE my_datalake.default.ic_orders;
