# name: test/sql/hive/ddl/views/test_view_external_catalogs.test
# description: with the catalog's type in experimental_glue_view_external_catalog_types, a Glue view over a table of another kind of catalog stores it by the catalog's type and the alias it is attached under
# group: [views]

require httpfs

require parquet

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP VIEW IF EXISTS my_datalake.default.ex_view_join;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ex_orders;

statement ok
ATTACH '{TEST_DIR}/ex_catalog.duckdb' AS ext1;

statement ok
CREATE OR REPLACE TABLE ext1.main.ex_items AS SELECT * FROM (VALUES (1, 'a'), (2, 'b')) t(id, name);

statement ok
CREATE TABLE my_datalake.default.ex_orders (id INTEGER, qty INTEGER);

statement ok
INSERT INTO my_datalake.default.ex_orders VALUES (1, 10), (2, 20);

statement ok
RESET experimental_glue_view_external_catalog_types;

# off by default
statement error
CREATE VIEW my_datalake.default.ex_view_join AS SELECT o.id, o.qty, ex_items.name FROM my_datalake.default.ex_orders o JOIN ext1.main.ex_items USING (id);
----
in catalog "ext1" of type duckdb, which is not in experimental_glue_view_external_catalog_types

statement ok
SET experimental_glue_view_external_catalog_types = ['duckdb'];

statement ok
CREATE VIEW my_datalake.default.ex_view_join AS SELECT o.id, o.qty, ex_items.name FROM my_datalake.default.ex_orders o JOIN ext1.main.ex_items USING (id);

# a column qualified with the external catalog's name is refused, as for Glue catalogs
statement error
CREATE VIEW my_datalake.default.ex_view_refused AS SELECT ext1.main.ex_items.id FROM ext1.main.ex_items;
----
whose "ext1" is also the name of a catalog the view reads

# a catalog in memory is refused
statement ok
CREATE TABLE memory.main.ex_mem AS SELECT 1 AS id;

statement error
CREATE VIEW my_datalake.default.ex_view_refused AS SELECT id FROM memory.main.ex_mem;
----
in catalog "memory", which is in memory

query I
SELECT response.ViewExpandedText FROM glue_get_table_response('my_datalake.default.ex_view_join');
----
SELECT o.id, o.qty, ex_items."name" FROM ("default".ex_orders AS o INNER JOIN "external:duckdb:ext1".main.ex_items USING (id))

# reading needs the type listed too (test_view_external_read_rules.test)
query III
SELECT id, qty, name FROM my_datalake.default.ex_view_join ORDER BY id;
----
1	10	a
2	20	b

# the view reads only under the writer's alias
statement ok
DETACH ext1;

statement ok
ATTACH '{TEST_DIR}/ex_catalog.duckdb' AS ext2;

statement error
SELECT * FROM my_datalake.default.ex_view_join;
----
reads "external:duckdb:ext1".main.ex_items: no usable catalog of that type is attached under that alias

statement ok
DETACH ext2;

# aliases are case insensitive
statement ok
ATTACH '{TEST_DIR}/ex_catalog.duckdb' AS EXT1;

query III
SELECT id, qty, name FROM my_datalake.default.ex_view_join ORDER BY id;
----
1	10	a
2	20	b

statement ok
DROP VIEW my_datalake.default.ex_view_join;

statement ok
DROP TABLE my_datalake.default.ex_orders;

statement ok
RESET experimental_glue_view_external_catalog_types;
