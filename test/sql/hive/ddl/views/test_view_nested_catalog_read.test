# name: test/sql/hive/ddl/views/test_view_nested_catalog_read.test
# description: a view whose stored text names a table of a nested catalog by its full id ("<account>:<catalog>/<nested>", seeded by scripts/docker-compose.yml) reads through whatever alias that catalog is attached under
# group: [views]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_view_base;

statement ok
CREATE TABLE my_datalake.default.nested_view_base (id BIGINT);

statement ok
INSERT INTO my_datalake.default.nested_view_base VALUES (1), (2), (3);

# not attached: the error names the ATTACH to run
statement error
SELECT * FROM my_datalake.default.fixture_nested_view;
----
from Glue catalog 123456789012:s3tablescatalog/fixture-bucket, which is not attached

# attached by its full id under any alias, the stored id resolves to it (the local Glue ignores catalog ids, so the
# table is found in its one catalog)
statement ok
attach '{GLUE_CATALOG_ID}:s3tablescatalog/fixture-bucket' as nested_one (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}', VERIFY_CONNECTION false);

query I
SELECT count(*) FROM my_datalake.default.fixture_nested_view;
----
3

statement ok
DETACH nested_one;

statement ok
attach '{GLUE_CATALOG_ID}:s3tablescatalog/fixture-bucket' as nested_two (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}', VERIFY_CONNECTION false);

query I
SELECT sum(id) FROM my_datalake.default.fixture_nested_view;
----
6

statement ok
DROP TABLE my_datalake.default.nested_view_base;
