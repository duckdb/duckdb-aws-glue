# name: test/sql/hive/ddl/views/test_view_external_nested_schemas.test
# description: a Glue view over a table in a nested schema of another kind of catalog stores and reads the table's whole schema path, not the table of the same name in the schema of the last name
# group: [views]

require httpfs

require parquet

require json

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_TEST_DB

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}',
    DEFAULT_SCHEMA '{GLUE_TEST_DB}'
);

statement ok
DROP VIEW IF EXISTS my_datalake.{GLUE_TEST_DB}.exn_view_nested;

statement ok
DROP VIEW IF EXISTS my_datalake.{GLUE_TEST_DB}.exn_view_flat;

statement ok
ATTACH '{TEST_DIR}/exn_catalog.duckdb' AS exn;

statement ok
CREATE SCHEMA IF NOT EXISTS exn.a;

statement ok
CREATE SCHEMA IF NOT EXISTS exn.a.b;

statement ok
CREATE SCHEMA IF NOT EXISTS exn.b;

statement ok
CREATE OR REPLACE TABLE exn.a.b.t AS SELECT 'exn.a.b.t' AS s;

# the table a path cut to its last schema would name
statement ok
CREATE OR REPLACE TABLE exn.b.t AS SELECT 'exn.b.t' AS s;

statement ok
SET experimental_glue_view_external_catalog_types = ['duckdb'];

statement ok
CREATE VIEW my_datalake.{GLUE_TEST_DB}.exn_view_nested AS SELECT s FROM exn.a.b.t;

query I
SELECT response.ViewExpandedText FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.exn_view_nested');
----
SELECT s FROM "external:duckdb:exn".a.b.t

query I
SELECT s FROM my_datalake.{GLUE_TEST_DB}.exn_view_nested;
----
exn.a.b.t

# a table in a schema of the catalog is stored and read as before
statement ok
CREATE VIEW my_datalake.{GLUE_TEST_DB}.exn_view_flat AS SELECT s FROM exn.b.t;

query I
SELECT response.ViewExpandedText FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.exn_view_flat');
----
SELECT s FROM "external:duckdb:exn".b.t

query I
SELECT s FROM my_datalake.{GLUE_TEST_DB}.exn_view_flat;
----
exn.b.t

# attached again under the writer's alias
statement ok
DETACH exn;

statement error
SELECT s FROM my_datalake.{GLUE_TEST_DB}.exn_view_nested;
----
reads "external:duckdb:exn".a.b.t: no usable catalog of that type is attached under that alias

statement ok
ATTACH '{TEST_DIR}/exn_catalog.duckdb' AS exn;

query I
SELECT s FROM my_datalake.{GLUE_TEST_DB}.exn_view_nested;
----
exn.a.b.t

query I
SELECT s FROM my_datalake.{GLUE_TEST_DB}.exn_view_flat;
----
exn.b.t

statement ok
DROP VIEW my_datalake.{GLUE_TEST_DB}.exn_view_nested;

statement ok
DROP VIEW my_datalake.{GLUE_TEST_DB}.exn_view_flat;

statement ok
RESET experimental_glue_view_external_catalog_types;
