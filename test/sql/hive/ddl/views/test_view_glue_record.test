# name: test/sql/hive/ddl/views/test_view_glue_record.test
# description: what CREATE VIEW writes to Glue
# group: [views]

require httpfs

require parquet

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP VIEW IF EXISTS my_datalake.default.gr_view;

statement ok
DROP VIEW IF EXISTS my_datalake.default.gr_defer;

statement ok
DROP TABLE IF EXISTS my_datalake.default.gr_orders;

statement ok
CREATE TABLE my_datalake.default.gr_orders (id INTEGER, amount DOUBLE);

statement ok
CREATE VIEW my_datalake.default.gr_view AS SELECT id, amount * 2 AS twice FROM gr_orders WHERE id > 1;

query IIIIII
SELECT response.TableType, response.ViewOriginalText, response.ViewExpandedText,
       response.Parameters.duckdb_view, response.Parameters.duckdb_view_version, response.Parameters.duckdb_view_default_database
FROM glue_get_table_response('my_datalake.default.gr_view');
----
VIRTUAL_VIEW	SELECT id, (amount * 2) AS twice FROM gr_orders WHERE (id > 1)	SELECT id, (amount * 2) AS twice FROM gr_orders WHERE (id > 1)	true	1	default

query I
SELECT response.StorageDescriptor.Columns::VARCHAR FROM glue_get_table_response('my_datalake.default.gr_view');
----
[{'Name': id, 'Type': int}, {'Name': twice, 'Type': double}]

query I
SELECT response.StorageDescriptor.Location IS NULL FROM glue_get_table_response('my_datalake.default.gr_view');
----
true

statement ok
CREATE OR REPLACE VIEW my_datalake.default.gr_view AS SELECT id FROM gr_orders;

query II
SELECT response.ViewOriginalText, response.StorageDescriptor.Columns::VARCHAR
FROM glue_get_table_response('my_datalake.default.gr_view');
----
SELECT id FROM gr_orders	[{'Name': id, 'Type': int}]

# no columns are stored for a view that is not bound at creation (Glue returns an empty list, moto none)
statement ok
CREATE VIEW my_datalake.default.gr_defer WITH (DEFER_BINDING) AS SELECT id FROM gr_missing;

query I
SELECT coalesce(response.StorageDescriptor.Columns::VARCHAR, '[]') FROM glue_get_table_response('my_datalake.default.gr_defer');
----
[]

statement ok
DROP VIEW my_datalake.default.gr_defer;

statement ok
DROP VIEW my_datalake.default.gr_view;

statement ok
DROP TABLE my_datalake.default.gr_orders;

# CREATE OR REPLACE replaces the definition and our parameters only: the description and parameters set by others stay
statement ok
CREATE OR REPLACE VIEW my_datalake.default.fixture_view_keep AS SELECT 2 AS two;

query IIII
SELECT response.ViewOriginalText, response.Description, response.Parameters.owner_team, response.Parameters.duckdb_view_default_database
FROM glue_get_table_response('my_datalake.default.fixture_view_keep');
----
SELECT 2 AS two	kept across CREATE OR REPLACE	analytics	default

query I
SELECT comment FROM duckdb_views() WHERE database_name = 'my_datalake' AND view_name = 'fixture_view_keep';
----
kept across CREATE OR REPLACE
