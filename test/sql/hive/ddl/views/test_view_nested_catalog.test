# name: test/sql/hive/ddl/views/test_view_nested_catalog.test
# description: a table of a nested Glue catalog (an S3 Tables bucket) is stored by the id Glue reports for it, "<account>:<catalog>/<nested>", whichever way the catalog was attached
# group: [views]

require httpfs

require glue

require-env GLUE_CATALOG_ID

# an account-implicit nested catalog path ("s3tablescatalog/<bucket>"), a database and a table in it, and the
# database the test view is written to; set only for a live Glue Data Catalog that has them
require-env GLUE_NESTED_CATALOG

require-env GLUE_NESTED_DATABASE

require-env GLUE_NESTED_TABLE

require-env GLUE_VIEW_DATABASE

# Skipped until #79 (Iceberg reads): a nested S3 Tables catalog holds only Iceberg tables, so no view can bind yet.
mode skip

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
attach '{GLUE_NESTED_CATALOG}' as nested_short (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
DROP VIEW IF EXISTS my_datalake.{GLUE_VIEW_DATABASE}.nc_view;

statement ok
CREATE VIEW my_datalake.{GLUE_VIEW_DATABASE}.nc_view AS SELECT * FROM nested_short.{GLUE_NESTED_DATABASE}.{GLUE_NESTED_TABLE};

# stored by the fully qualified id Glue reports, not by the path as attached nor by the alias
query II
SELECT contains(response.ViewExpandedText, '"{GLUE_CATALOG_ID}:{GLUE_NESTED_CATALOG}".'),
       contains(response.ViewExpandedText, 'nested_short')
FROM glue_get_table_response('my_datalake.{GLUE_VIEW_DATABASE}.nc_view');
----
true	false

# not attached: the error names the ATTACH to run
statement ok
DETACH nested_short;

statement error
SELECT * FROM my_datalake.{GLUE_VIEW_DATABASE}.nc_view;
----
is not attached

# attached under the other spelling, the view's name resolves to the same catalog and reaches the table (which then
# can not be read, being Iceberg)
statement ok
attach '{GLUE_CATALOG_ID}:{GLUE_NESTED_CATALOG}' as nested_full (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement error
SELECT * FROM my_datalake.{GLUE_VIEW_DATABASE}.nc_view;
----
can not be read yet

statement ok
DROP VIEW my_datalake.{GLUE_VIEW_DATABASE}.nc_view;
