# name: test/sql/hive/ddl/glue_get_table_response_bucketing.test
# description: glue_get_table_response exposes StorageDescriptor.BucketColumns, NumberOfBuckets and SortColumns
# group: [ddl]

# The extension parses a table's bucketing to refuse writes to it; these columns make it readable. The tables come
# from scripts/docker-compose.yml, because the extension deliberately cannot create a bucketed table.

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# ===========================================================================
# a bucketed table: columns, count and one ascending sort column
# ===========================================================================
query III
SELECT bucket_columns, number_of_buckets, sort_columns
FROM glue_get_table_response('my_datalake.default.fixture_bucketed');
----
[id]	4	[{'column': id, 'direction': ASC}]

# ===========================================================================
# two bucket columns, and both sort directions
# ===========================================================================
# region is SortOrder 0, so this is what pins the DESC mapping down: with the direction dropped (as it was before)
# this row and an all-ascending one would be indistinguishable.
query III
SELECT bucket_columns, number_of_buckets, sort_columns
FROM glue_get_table_response('my_datalake.default.fixture_bucket_sorted');
----
[id, region]	8	[{'column': id, 'direction': ASC}, {'column': region, 'direction': DESC}]

# addressable as ordinary values rather than only as a printed struct
query IIII
SELECT bucket_columns[1], bucket_columns[2], sort_columns[2].column, sort_columns[2].direction
FROM glue_get_table_response('my_datalake.default.fixture_bucket_sorted');
----
id	region	region	DESC

# ===========================================================================
# bucket columns with NumberOfBuckets 0, which is Hive's 'unbucketed' spelling
# ===========================================================================
# Reported as stored: the table IS bucketed (it has bucket columns) and the count is 0. Nothing is normalised away,
# so a reader can tell this apart from a table with no bucketing at all.
query III
SELECT bucket_columns, number_of_buckets, sort_columns
FROM glue_get_table_response('my_datalake.default.fixture_bucket_zerocount');
----
[id]	0	[]

# ===========================================================================
# an unbucketed table: empty lists, not NULL
# ===========================================================================
query III
SELECT bucket_columns, number_of_buckets, sort_columns
FROM glue_get_table_response('my_datalake.default.fixture_bucket_plain');
----
[]	-1	[]

# the empty list is distinguishable from a bucketed one without inspecting the count, which is how the write guard
# decides (a count of 0 or -1 can accompany real bucket columns, as fixture_bucket_zerocount shows)
query II
SELECT len(bucket_columns) = 0 AS unbucketed, number_of_buckets
FROM glue_get_table_response('my_datalake.default.fixture_bucket_plain');
----
true	-1

query II
SELECT len(bucket_columns) = 0 AS unbucketed, number_of_buckets
FROM glue_get_table_response('my_datalake.default.fixture_bucket_zerocount');
----
false	0

# ===========================================================================
# the typed columns agree with the raw Glue response
# ===========================================================================
# 'response' is the whole Glue Table object as the SDK serialised it, so it is the independent check that the typed
# columns above are a faithful projection and not a reinterpretation.
query II
SELECT bucket_columns = [x::VARCHAR FOR x IN response.StorageDescriptor.BucketColumns::VARCHAR[]] AS cols_agree,
       number_of_buckets = response.StorageDescriptor.NumberOfBuckets::INTEGER AS count_agrees
FROM glue_get_table_response('my_datalake.default.fixture_bucket_sorted');
----
true	true

# The direction is the one field that is derived rather than copied, and Glue's raw SortOrder is not a typed column,
# so this is what pins the mapping: 1 must read ASC and 0 must read DESC, against the same row's raw response.
query IIII
SELECT sort_columns[1].direction, response.StorageDescriptor.SortColumns[1].SortOrder::INTEGER,
       sort_columns[2].direction, response.StorageDescriptor.SortColumns[2].SortOrder::INTEGER
FROM glue_get_table_response('my_datalake.default.fixture_bucket_sorted');
----
ASC	1	DESC	0

# and the column names are copied in Glue's order, not reordered
query II
SELECT sort_columns[1].column = response.StorageDescriptor.SortColumns[1].Column::VARCHAR,
       sort_columns[2].column = response.StorageDescriptor.SortColumns[2].Column::VARCHAR
FROM glue_get_table_response('my_datalake.default.fixture_bucket_sorted');
----
true	true

# ===========================================================================
# a table created by this extension is never bucketed
# ===========================================================================
# CreateHiveTable sets NumberOfBuckets -1 and no bucket columns. That is the accurate statement rather than a
# placeholder, and it stays true because no option exists to create a bucketed table.
statement ok
CREATE TABLE my_datalake.default.gtr_unbucketed (id INTEGER, amount DOUBLE);

query III
SELECT bucket_columns, number_of_buckets, sort_columns
FROM glue_get_table_response('my_datalake.default.gtr_unbucketed');
----
[]	-1	[]

statement ok
DROP TABLE my_datalake.default.gtr_unbucketed;

# ===========================================================================
# the refusal message spells out the direction too
# ===========================================================================
# The message is built from the same parsed fields, so this doubles as a check that the direction reached it.
statement error
INSERT INTO my_datalake.default.fixture_bucketed VALUES (1, 1.0);
----
sorted by (id ASC)
