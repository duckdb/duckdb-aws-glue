# name: test/sql/hive/ddl/create_schema/create_schema_options.test
# description: CREATE SCHEMA ... WITH (...) for Glue databases
# group: [create_schema]

# comment becomes the Glue Description, location the LocationUri, and any other key a Glue database parameter
# (Athena's DBPROPERTIES). DuckDB's own CREATE SCHEMA grammar takes nothing but a name, so the option list comes from
# the glue_hive_ddl grammar extension and desugars to glue_create_database(). The same option list DuckDB already
# accepts on CREATE TABLE.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

# Glue database names may not contain the path characters of {TEST_DIR}, so the names here are fixed and cleaned up
# up front instead of being made unique per run
statement ok
DROP SCHEMA IF EXISTS my_datalake.cs_opts CASCADE;

# ---------------------------------------------------------------------------
# claim: comment, location and free-form properties all reach Glue
# ---------------------------------------------------------------------------
statement ok
CREATE SCHEMA my_datalake.cs_opts WITH (
    comment = 'curated sales facts',
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/cs_opts_elsewhere',
    owner_team = 'analytics',
    retention_days = '30'
);

query I
SELECT comment FROM glue_get_database_response('my_datalake.cs_opts');
----
curated sales facts

query I
SELECT location FROM glue_get_database_response('my_datalake.cs_opts');
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/cs_opts_elsewhere

query II
SELECT unnest(map_keys(parameters)) AS k, unnest(map_values(parameters)) AS v
FROM glue_get_database_response('my_datalake.cs_opts')
ORDER BY k;
----
owner_team	analytics
retention_days	30

# NOTE: where a table of this database lands is deliberately not asserted here. GetTableLocation gives the
# attachment's DEFAULT_LOCATION precedence over the database's own LocationUri, so with DEFAULT_LOCATION set the
# table does NOT go under the location set above. That precedence predates this change and is left alone.
statement ok
CREATE TABLE my_datalake.cs_opts.orders (id INTEGER);

statement ok
DROP SCHEMA my_datalake.cs_opts CASCADE;

# ---------------------------------------------------------------------------
# claim: each option is optional on its own
# ---------------------------------------------------------------------------
statement ok
DROP SCHEMA IF EXISTS my_datalake.cs_comment_only CASCADE;

statement ok
CREATE SCHEMA my_datalake.cs_comment_only WITH (comment = 'just a comment');

query I
SELECT comment FROM glue_get_database_response('my_datalake.cs_comment_only');
----
just a comment

statement ok
DROP SCHEMA my_datalake.cs_comment_only;

# ---------------------------------------------------------------------------
# claim: IF NOT EXISTS is honoured on the option form
# ---------------------------------------------------------------------------
statement ok
DROP SCHEMA IF EXISTS my_datalake.cs_ine CASCADE;

statement ok
CREATE SCHEMA my_datalake.cs_ine WITH (comment = 'first');

statement error
CREATE SCHEMA my_datalake.cs_ine WITH (comment = 'second');
----
already exists

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.cs_ine WITH (comment = 'second');

# the original is untouched
query I
SELECT comment FROM glue_get_database_response('my_datalake.cs_ine');
----
first

statement ok
DROP SCHEMA my_datalake.cs_ine;

# ---------------------------------------------------------------------------
# claim: the plain form still goes through DuckDB's built-in rule while the extension is active
# ---------------------------------------------------------------------------
statement ok
DROP SCHEMA IF EXISTS my_datalake.cs_plain CASCADE;

statement ok
CREATE SCHEMA my_datalake.cs_plain;

statement ok
CREATE TABLE my_datalake.cs_plain.t (id INTEGER);

# no options given, so the database keeps the location derived from the attachment's DEFAULT_LOCATION
query I
SELECT location FROM glue_get_database_response('my_datalake.cs_plain');
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/cs_plain

statement ok
DROP SCHEMA my_datalake.cs_plain CASCADE;

# ---------------------------------------------------------------------------
# claim: ordinary CREATE statements are unaffected by the added grammar rule
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE memory.main.not_glue (id INTEGER);

statement ok
DROP TABLE memory.main.not_glue;
