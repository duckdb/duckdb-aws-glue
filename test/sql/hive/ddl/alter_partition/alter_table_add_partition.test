# name: test/sql/hive/ddl/alter_partition/alter_table_add_partition.test
# description: ALTER TABLE ADD [IF NOT EXISTS] PARTITION (...) [LOCATION ...] for Hive tables in Glue: adding
# group: [alter_partition]

#              partitions at the default location and at specific partition value locations. DuckDB has no ADD PARTITION
#              syntax, the statement is glue_add_partition(table, partition_spec, location := ..., if_not_exists := ...)

require httpfs

require glue

require-env GLUE_CATALOG_ID

# this test is about Parquet tables, so they stay Parquet whatever the config's default format
statement ok
SET hive_default_format = 'parquet';

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.orders_add;

# an orders table: Hive-style partitioned by dt and country
statement ok
CREATE TABLE my_datalake.default.orders_add (id INTEGER, amount DOUBLE, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

# data laid out as <key>=<value> directories under the table location, but not registered in Glue (partition
# columns are not stored in the files)
statement ok
COPY (SELECT 1 AS id, 10.0 AS amount) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/orders_add/dt=2016-05-14/country=IN/data.parquet';

statement ok
COPY (SELECT 2 AS id, 20.0 AS amount) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/orders_add/dt=2016-05-31/country=IN/data.parquet';

statement ok
COPY (SELECT 3 AS id, 30.0 AS amount) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/orders_add/dt=2016-06-01/country=IN/data.parquet';

# data that is not laid out Hive-style, outside the table location
statement ok
COPY (SELECT 4 AS id, 40.0 AS amount) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/INDIA_02_June_2016/data.parquet';

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.orders_add');
----
0

# unregistered data is not visible
query I
SELECT count(*) FROM my_datalake.default.orders_add;
----
0

#---------------------------------------------------------------------------
# ALTER TABLE orders ADD PARTITION (dt = '2016-05-14', country = 'IN');
#---------------------------------------------------------------------------
statement ok
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-05-14', country: 'IN'});

# the location is derived from the table location and the partition key names and values
query III
SELECT dt, country, location FROM glue_partitions('my_datalake.default.orders_add') ORDER BY dt;
----
2016-05-14	IN	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/orders_add/dt=2016-05-14/country=IN

query II
SELECT id, amount FROM my_datalake.default.orders_add ORDER BY id;
----
1	10.0

#---------------------------------------------------------------------------
# ALTER TABLE orders ADD PARTITION (dt = '2016-05-31', country = 'IN') PARTITION (dt = '2016-06-01', country = 'IN');
# (one call per partition)
#---------------------------------------------------------------------------
statement ok
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-05-31', country: 'IN'});

statement ok
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-06-01', country: 'IN'});

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.orders_add') ORDER BY dt;
----
2016-05-14	IN
2016-05-31	IN
2016-06-01	IN

#---------------------------------------------------------------------------
# ALTER TABLE orders ADD PARTITION (dt = '2016-06-02', country = 'IN') LOCATION 's3://.../INDIA_02_June_2016/';
#---------------------------------------------------------------------------
statement ok
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-06-02', country: 'IN'}, location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/INDIA_02_June_2016/');

query I
SELECT location LIKE '%/INDIA_02_June_2016%' FROM glue_partitions('my_datalake.default.orders_add') WHERE dt = '2016-06-02';
----
true

# the partition values of a partition with a custom location come from Glue, not from the path
query IIII
SELECT id, amount, dt, country FROM my_datalake.default.orders_add ORDER BY id;
----
1	10.0	2016-05-14	IN
2	20.0	2016-05-31	IN
3	30.0	2016-06-01	IN
4	40.0	2016-06-02	IN

query I
SELECT id FROM my_datalake.default.orders_add WHERE dt = '2016-06-02';
----
4

#---------------------------------------------------------------------------
# ALTER TABLE orders ADD IF NOT EXISTS PARTITION (dt = '2016-05-14', country = 'IN');
#---------------------------------------------------------------------------
statement error
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-05-14', country: 'IN'});
----
already exists

statement ok
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-05-14', country: 'IN'}, if_not_exists := true);

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.orders_add');
----
4

#---------------------------------------------------------------------------
# the partition spec must name every partition key, and only partition keys
#---------------------------------------------------------------------------
statement error
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-07-01'});
----

# id is a data column, not a partition key
statement error
CALL glue_add_partition('my_datalake.default.orders_add', {dt: '2016-07-01', country: 'IN', id: 1});
----

# only Glue tables
statement error
CALL glue_add_partition('memory.main.nope', {dt: '2016-07-01', country: 'IN'});
----

# the second attach sees the partitions registered in Glue
statement ok
attach '{GLUE_CATALOG_ID}' as verify_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query I
SELECT count(*) FROM glue_partitions('verify_datalake.default.orders_add');
----
4

statement ok
DROP TABLE my_datalake.default.orders_add;
