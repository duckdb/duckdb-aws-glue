# name: test/sql/hive/ddl/alter_partition/test_show_partitions.test
# description: test show partitions in a hive table
# group: [alter_partition]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.flight_delays;

statement ok
DROP TABLE IF EXISTS my_datalake.default.impressions_partitions;

# a flight_delays table, partitioned by year
statement ok
CREATE TABLE my_datalake.default.flight_delays (flight VARCHAR, delay INTEGER, year INTEGER) PARTITIONED BY (year);

statement ok
INSERT INTO my_datalake.default.flight_delays VALUES
    ('AA1', 5, 2007), ('AA2', 0, 2015), ('AA3', 12, 1999), ('AA4', 3, 1993), ('AA5', 7, 2015);

#---------------------------------------------------------------------------
# glue_partitions(flight_delays_csv)  (unsorted, one <key>=<value> string per partition)
#---------------------------------------------------------------------------
query I
SELECT 'year=' || year FROM glue_partitions('my_datalake.default.flight_delays') ORDER BY 1;
----
year=1993
year=1999
year=2007
year=2015

#---------------------------------------------------------------------------
# SELECT * FROM glue_partitions(flight_delays_csv) ORDER BY year  (typed partition columns, sorted)
#---------------------------------------------------------------------------
query I
SELECT year FROM glue_partitions('my_datalake.default.flight_delays') ORDER BY year;
----
1993
1999
2007
2015

# the partition columns have the types of the Glue partition keys
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM glue_partitions('my_datalake.default.flight_delays'));
----
year	INTEGER
location	VARCHAR
parameters	MAP(VARCHAR, VARCHAR)

query I
SELECT location FROM glue_partitions('my_datalake.default.flight_delays') WHERE year = 2007;
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/flight_delays/year=2007

# the second docs example: impressions partitioned by a dt string
statement ok
CREATE TABLE my_datalake.default.impressions_partitions (requestid VARCHAR, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.impressions_partitions VALUES
    ('r1', '2009-04-12-16-00'), ('r2', '2009-04-13-18-15'), ('r3', '2009-04-14-00-20'), ('r4', '2009-04-12-16-00');

query I
SELECT 'dt=' || dt FROM glue_partitions('my_datalake.default.impressions_partitions') ORDER BY 1;
----
dt=2009-04-12-16-00
dt=2009-04-13-18-15
dt=2009-04-14-00-20

#---------------------------------------------------------------------------
# glue_partitions shows the partitions in metadata, not the partitions in the file system
#---------------------------------------------------------------------------
statement ok
COPY (SELECT 'AA9' AS flight, 1 AS delay) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/flight_delays/year=2020/data.parquet';

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.flight_delays') WHERE year = 2020;
----
0

statement ok
CALL glue_repair_table('my_datalake.default.flight_delays');

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.flight_delays') WHERE year = 2020;
----
1

# a dropped partition disappears from the listing even though its files remain
statement ok
CALL glue_drop_partition('my_datalake.default.flight_delays', {year: 1993});

query I
SELECT year FROM glue_partitions('my_datalake.default.flight_delays') ORDER BY year;
----
1999
2007
2015
2020

# only partitioned tables have partitions
statement ok
DROP TABLE IF EXISTS my_datalake.default.flight_delays_plain;

statement ok
CREATE TABLE my_datalake.default.flight_delays_plain (flight VARCHAR, delay INTEGER);

statement error
SELECT * FROM glue_partitions('my_datalake.default.flight_delays_plain');
----
not partitioned

# only Glue tables
statement error
SELECT * FROM glue_partitions('memory.main.nope');
----

statement ok
DROP TABLE my_datalake.default.flight_delays_plain;

statement ok
DROP TABLE my_datalake.default.flight_delays;

statement ok
DROP TABLE my_datalake.default.impressions_partitions;
