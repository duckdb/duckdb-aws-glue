# name: test/sql/hive/ddl/create_table/create_table_options.test
# description: the clauses of a Hive CREATE TABLE other than the column list: IF NOT EXISTS,
# group: [create_table]

#              [db_name.]table_name, PARTITIONED BY, LOCATION, TBLPROPERTIES, and the ones without a DuckDB
#              counterpart (EXTERNAL, COMMENT, ROW FORMAT, STORED AS, WITH SERDEPROPERTIES). CLUSTERED BY is the
#              bucketing options, in create_bucketed_table.test

require httpfs

require glue

require-env GLUE_CATALOG_ID

# DEFAULT_SCHEMA sets the current database
statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}',
    DEFAULT_SCHEMA 'default'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_opts;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_opts_part;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_opts_unqualified;

statement ok
DROP TABLE IF EXISTS my_datalake.default."table123";

statement ok
DROP TABLE IF EXISTS my_datalake.default."_mytable";

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_opts_sorted;

#---------------------------------------------------------------------------
# EXTERNAL: every table this extension creates is an external table
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.ddl_opts (id INTEGER, name VARCHAR);

query II
SELECT glue_table_type, parameters['EXTERNAL'] FROM glue_get_table_response('my_datalake.default.ddl_opts');
----
EXTERNAL_TABLE	TRUE

#---------------------------------------------------------------------------
# IF NOT EXISTS
#---------------------------------------------------------------------------
statement error
CREATE TABLE my_datalake.default.ddl_opts (id INTEGER, name VARCHAR);
----
already exists

# the existing table is left untouched, the new column list is ignored
statement ok
CREATE TABLE IF NOT EXISTS my_datalake.default.ddl_opts (other INTEGER);

query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'ddl_opts' ORDER BY column_index;
----
id
name

#---------------------------------------------------------------------------
# [db_name.]table_name
#---------------------------------------------------------------------------
statement ok
USE my_datalake;

# without a database the current one (DEFAULT_SCHEMA) is assumed
statement ok
CREATE TABLE ddl_opts_unqualified (id INTEGER);

query I
SELECT database_name FROM glue_get_table_response('my_datalake.default.ddl_opts_unqualified');
----
default

statement ok
USE memory;

# a name with numbers is quoted, a name starting with an underscore too
statement ok
CREATE TABLE my_datalake.default."table123" (id INTEGER);

statement ok
CREATE TABLE my_datalake.default."_mytable" (id INTEGER);

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name IN ('table123', '_mytable') ORDER BY table_name;
----
_mytable
table123

#---------------------------------------------------------------------------
# PARTITIONED BY (col_name data_type, ...)
#---------------------------------------------------------------------------
# partition columns are table columns named in PARTITIONED BY and
# stored as Glue PartitionKeys rather than in the data files
statement ok
CREATE TABLE my_datalake.default.ddl_opts_part (id INTEGER, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.default.ddl_opts_part'));
----
id	int

query II
SELECT c.name, c.type FROM (SELECT unnest(partition_keys) AS c FROM glue_get_table_response('my_datalake.default.ddl_opts_part'));
----
dt	string
country	string

# a partition column must be a column of the table
statement error
CREATE TABLE my_datalake.default.ddl_opts_part_bad (id INTEGER) PARTITIONED BY (dt);
----
not a column

# partitioning by every column is an error: at least one data column must remain
statement error
CREATE TABLE my_datalake.default.ddl_opts_part_bad (dt VARCHAR) PARTITIONED BY (dt);
----

#---------------------------------------------------------------------------
# LOCATION 's3://amzn-s3-demo-bucket/folder/'
#---------------------------------------------------------------------------
# a trailing slash is accepted and stored without
statement ok
CREATE TABLE my_datalake.default.ddl_opts_loc (id INTEGER) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/folder/');

query I
SELECT location FROM glue_get_table_response('my_datalake.default.ddl_opts_loc');
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/folder

# without LOCATION the table goes below the attach's DEFAULT_LOCATION
query I
SELECT location FROM glue_get_table_response('my_datalake.default.ddl_opts');
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ddl_opts

statement ok
DROP TABLE my_datalake.default.ddl_opts_loc;

#---------------------------------------------------------------------------
# TBLPROPERTIES ('classification'='parquet', 'has_encrypted_data'='false', ...)
#---------------------------------------------------------------------------
# every WITH key other than type and location becomes a table parameter
statement ok
CREATE TABLE my_datalake.default.ddl_opts_props (id INTEGER) WITH (
    'classification' = 'parquet',
    'has_encrypted_data' = 'false',
    'creator' = 'Jane D.'
);

query III
SELECT parameters['classification'], parameters['has_encrypted_data'], parameters['creator']
FROM glue_get_table_response('my_datalake.default.ddl_opts_props');
----
parquet	false	Jane D.

statement ok
DROP TABLE my_datalake.default.ddl_opts_props;

# WITH (comment = '...') writes to Table.Description (so duckdb_tables().comment shows it) and
# is mirrored in Parameters.comment so either read location sees the same value.
statement ok
CREATE TABLE my_datalake.default.ddl_opts_comment (id INTEGER, name VARCHAR)
WITH (comment = 'customer dim');

query I
SELECT comment FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ddl_opts_comment';
----
customer dim

query I
SELECT parameters['comment'] FROM glue_get_table_response('my_datalake.default.ddl_opts_comment');
----
customer dim

statement ok
DROP TABLE my_datalake.default.ddl_opts_comment;

#---------------------------------------------------------------------------
# not supported: ROW FORMAT, STORED AS, WITH SERDEPROPERTIES
#---------------------------------------------------------------------------
# DuckDB's SORTED BY is rejected, the sort order of a bucketed table is the SortColumns option
statement error
CREATE TABLE my_datalake.default.ddl_opts_sorted (id INTEGER) SORTED BY (id);
----
the sort order of a bucketed table is the SortColumns option

# CREATE TABLE ... AS too, before the Glue table is created
statement error
CREATE TABLE my_datalake.default.ddl_opts_sorted SORTED BY (id) AS SELECT 1 AS id;
----
the sort order of a bucketed table is the SortColumns option

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.ddl_opts_sorted');
----
does not exist

# and on an existing table
statement error
CREATE TABLE IF NOT EXISTS my_datalake.default.ddl_opts SORTED BY (id) AS SELECT 1 AS id, 'a' AS name;
----
the sort order of a bucketed table is the SortColumns option

statement ok
DROP TABLE my_datalake.default.ddl_opts;

statement ok
DROP TABLE my_datalake.default.ddl_opts_part;

statement ok
DROP TABLE my_datalake.default.ddl_opts_unqualified;

statement ok
DROP TABLE my_datalake.default."table123";

statement ok
DROP TABLE my_datalake.default."_mytable";
