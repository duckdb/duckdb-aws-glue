# name: test/sql/hive/ddl/create_table/location_in_attach/test_create_hive_table.test
# description: test creating a hive table
# group: [location_in_attach]

require httpfs

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_TEST_DB

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}',
    DEFAULT_SCHEMA '{GLUE_TEST_DB}'
);

statement ok
SHOW ALL TABLES;


statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.hive_table;

statement ok
CREATE TABLE IF NOT EXISTS my_datalake.{GLUE_TEST_DB}.hive_table
(int_col integer, variant_col VARIANT, timestamp_col TIMESTAMP);

query I
select distinct table_name from information_schema.columns where table_name = 'hive_table';
----
hive_table

# the table location in Glue
query I
SELECT location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/{GLUE_TEST_DB}/hive_table' FROM glue_get_table_response('my_datalake.{GLUE_TEST_DB}.hive_table');
----
true

mode skip

# We are not inserting into hive tables yet.
statement ok
insert into my_datalake.{GLUE_TEST_DB}.hive_table values (1, 5::VARIANT, now());


