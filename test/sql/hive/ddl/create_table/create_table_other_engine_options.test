# name: test/sql/hive/ddl/create_table/create_table_other_engine_options.test
# description: Other engines' spellings of CREATE TABLE options (partitioned_by, partitioning, partition_by, partition_columns, partition_keys, PartitionKeys, external_location, field_delimiter) are refused naming the spelling to use, instead of being stored as table parameters that do nothing; write_compression is not among them, it is the table's codec
# group: [create_table]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.engine_opts;

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) WITH (partitioned_by = ['dt']);
----
Unknown CREATE TABLE option 'partitioned_by', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts WITH (partitioned_by = ['dt']) AS SELECT 1 AS id, 'd' AS dt;
----
Unknown CREATE TABLE option 'partitioned_by', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) WITH (PARTITIONING = ['dt']);
----
Unknown CREATE TABLE option 'PARTITIONING', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) WITH (partition_by = ['dt']);
----
Unknown CREATE TABLE option 'partition_by', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) WITH (partition_columns = ['dt']);
----
Unknown CREATE TABLE option 'partition_columns', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) WITH (partition_keys = ['dt']);
----
Unknown CREATE TABLE option 'partition_keys', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) WITH (PartitionKeys = ['dt']);
----
Unknown CREATE TABLE option 'PartitionKeys', use a PARTITIONED BY (...) clause instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER) WITH (external_location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/elsewhere');
----
Unknown CREATE TABLE option 'external_location', use option 'location' instead

statement error
CREATE TABLE my_datalake.default.engine_opts (id INTEGER) WITH (format = 'csv', field_delimiter = '|');
----
Unknown CREATE TABLE option 'field_delimiter', use option 'delimiter' instead

# none of the refused statements created the table
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'engine_opts';
----
0

# the spellings the messages name work
statement ok
CREATE TABLE my_datalake.default.engine_opts (id INTEGER, dt VARCHAR) PARTITIONED BY (dt)
    WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/engine_opts', format = 'csv', delimiter = '|', write_compression = 'gzip');

query I
SELECT parameters['write_compression'] FROM glue_get_table_response('my_datalake.default.engine_opts');
----
gzip

query T
SELECT list_transform(partition_keys, lambda k: k.name) FROM glue_get_table_response('my_datalake.default.engine_opts');
----
[dt]

statement ok
DROP TABLE my_datalake.default.engine_opts;
