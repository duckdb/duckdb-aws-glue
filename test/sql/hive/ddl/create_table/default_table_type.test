# name: test/sql/hive/ddl/create_table/default_table_type.test
# description: glue_default_table_type picks the table type of a CREATE TABLE without a 'table_type' option; the
# group: [create_table]

#              option always wins. The Iceberg default is in test/sql/iceberg/default_table_type.test

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.default_type_plain;

statement ok
DROP TABLE IF EXISTS my_datalake.default.default_type_explicit;

statement ok
DROP TABLE IF EXISTS my_datalake.default.default_type_ctas;

query I
SELECT current_setting('glue_default_table_type');
----
hive

statement error
SET glue_default_table_type = 'delta';
----
Unknown Glue table type 'delta' for setting 'glue_default_table_type', accepted values are 'hive' and 'iceberg'

statement ok
SET glue_default_table_type = 'HIVE';

statement ok
CREATE TABLE my_datalake.default.default_type_plain (id INTEGER);

# the option wins over the setting
statement ok
SET glue_default_table_type = 'iceberg';

statement ok
CREATE TABLE my_datalake.default.default_type_explicit (id INTEGER) WITH (table_type = 'hive');

statement ok
CREATE TABLE my_datalake.default.default_type_ctas WITH (table_type = 'Hive') AS SELECT 1 AS id;

statement error
CREATE TABLE my_datalake.default.default_type_bad (id INTEGER) WITH (table_type = 'delta');
----
Unknown Glue table type 'delta' for option 'table_type', accepted values are 'hive' and 'iceberg'

statement ok
RESET glue_default_table_type;

query II
SELECT table_name, tags['table_type'] FROM duckdb_tables()
WHERE database_name = 'my_datalake' AND table_name LIKE 'default_type_%' ORDER BY table_name;
----
default_type_ctas	HIVE
default_type_explicit	HIVE
default_type_plain	HIVE

query I
SELECT id FROM my_datalake.default.default_type_ctas;
----
1

# the table type can not be changed afterwards
statement error
ALTER TABLE my_datalake.default.default_type_plain SET (table_type = 'iceberg');
----
Table property 'table_type' decides how the table is read and can not be changed with ALTER TABLE

statement error
ALTER TABLE my_datalake.default.default_type_plain RESET (table_type);
----
Table property 'table_type' decides how the table is read and can not be changed with ALTER TABLE

statement ok
DROP TABLE my_datalake.default.default_type_plain;

statement ok
DROP TABLE my_datalake.default.default_type_explicit;

statement ok
DROP TABLE my_datalake.default.default_type_ctas;
