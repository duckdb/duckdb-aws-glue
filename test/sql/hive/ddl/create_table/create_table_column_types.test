# name: test/sql/hive/ddl/create_table/create_table_column_types.test
# description: every Hive data_type, as DuckDB types, and the Hive type each
# group: [create_table]

#              one is registered with in Glue

require httpfs

require glue

require-env GLUE_CATALOG_ID

# this test is about Parquet tables, so they stay Parquet whatever the config's default format
statement ok
SET hive_default_format = 'parquet';

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_types;

# Hive:    boolean, tinyint, smallint, int, bigint, double, float, decimal(p,s), decimal(p), char(n), varchar(n),
#          string, binary, date, timestamp, array<t>, map<k,v>, struct<...>
statement ok
CREATE TABLE my_datalake.default.ddl_types (
  boolean_col BOOLEAN,
  tinyint_col TINYINT,
  smallint_col SMALLINT,
  int_col INTEGER,
  bigint_col BIGINT,
  double_col DOUBLE,
  float_col FLOAT,
  decimal_col DECIMAL(11, 5),
  decimal_default_scale_col DECIMAL(15),
  char_col CHAR(10),
  varchar_col VARCHAR(10),
  string_col VARCHAR,
  binary_col BLOB,
  date_col DATE,
  timestamp_col TIMESTAMP,
  array_col INTEGER[],
  map_col MAP(VARCHAR, INTEGER),
  struct_col STRUCT(city VARCHAR, zip INTEGER)
) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ddl_types');

# the Hive types in Glue (char(n) and varchar(n) are plain VARCHAR in DuckDB, so they become string)
query II
SELECT c.name, c.type FROM (SELECT unnest(columns) AS c FROM glue_get_table_response('my_datalake.default.ddl_types'));
----
boolean_col	boolean
tinyint_col	tinyint
smallint_col	smallint
int_col	int
bigint_col	bigint
double_col	double
float_col	float
decimal_col	decimal(11,5)
decimal_default_scale_col	decimal(15,0)
char_col	string
varchar_col	string
string_col	string
binary_col	binary
date_col	date
timestamp_col	timestamp
array_col	array<int>
map_col	map<string,int>
struct_col	struct<city:string,zip:int>

# and back as DuckDB types through a fresh attach
statement ok
attach '{GLUE_CATALOG_ID}' as verify_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'verify_datalake' AND table_name = 'ddl_types' ORDER BY column_index;
----
boolean_col	BOOLEAN
tinyint_col	TINYINT
smallint_col	SMALLINT
int_col	INTEGER
bigint_col	BIGINT
double_col	DOUBLE
float_col	FLOAT
decimal_col	DECIMAL(11,5)
decimal_default_scale_col	DECIMAL(15,0)
char_col	VARCHAR
varchar_col	VARCHAR
string_col	VARCHAR
binary_col	BLOB
date_col	DATE
timestamp_col	TIMESTAMP
array_col	INTEGER[]
map_col	MAP(VARCHAR, INTEGER)
struct_col	STRUCT(city VARCHAR, zip INTEGER)

# a row of every type round-trips through parquet
statement ok
INSERT INTO my_datalake.default.ddl_types VALUES (
  true, 127, 32767, 2147483647, 9223372036854775807, 1.5, 2.5,
  123456.12345, 123456789012345,
  'char', 'varchar', 'string', '\xAB\xCD'::BLOB,
  DATE '2008-09-15', TIMESTAMP '2008-09-15 03:04:05.324',
  [1, 2, 3], MAP {'a': 1, 'b': 2}, {'city': 'Seattle', 'zip': 98101}
);

query IIIIIII
SELECT boolean_col, tinyint_col, smallint_col, int_col, bigint_col, double_col, float_col FROM verify_datalake.default.ddl_types;
----
true	127	32767	2147483647	9223372036854775807	1.5	2.5

query IIIII
SELECT decimal_col, decimal_default_scale_col, char_col, varchar_col, string_col FROM verify_datalake.default.ddl_types;
----
123456.12345	123456789012345	char	varchar	string

query III
SELECT hex(binary_col), date_col, timestamp_col FROM verify_datalake.default.ddl_types;
----
ABCD	2008-09-15	2008-09-15 03:04:05.324

query III
SELECT array_col, map_col['b'], struct_col.city FROM verify_datalake.default.ddl_types;
----
[1, 2, 3]	2	Seattle

statement ok
DROP TABLE my_datalake.default.ddl_types;
