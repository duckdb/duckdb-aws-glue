# name: test/sql/hive/ddl/create_table/create_table_struct_quoted_and_empty.test
# description: struct field names with quotes round-trip through Glue, empty structs (no Hive type) are refused
# group: [create_table]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.structname_quoted;

statement ok
DROP TABLE IF EXISTS my_datalake.default.structname_empty;

# parquet: csv tables can not store nested columns, avro can not name a column '"quoted col name"'
statement ok
CREATE TABLE my_datalake.default.structname_quoted WITH (format = 'parquet') AS
SELECT {'quoted ''"field name"': 42} """quoted col name""",
       {'Estimated Cardinality': '1', 'children': [{'Operator Type': 'SCAN', 'it''s': 1.5}]} profile;

query II
SELECT name, type FROM (SELECT unnest(columns, recursive := true) FROM glue_get_table_response('my_datalake.default.structname_quoted'));
----
"quoted col name"	struct<quoted '"field name":int>
profile	struct<Estimated Cardinality:string,children:array<struct<Operator Type:string,it's:decimal(2,1)>>>

statement ok
DETACH my_datalake;

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'structname_quoted' ORDER BY column_index;
----
"quoted col name"	STRUCT("quoted '""field name""" INTEGER)
profile	STRUCT("Estimated Cardinality" VARCHAR, children STRUCT("Operator Type" VARCHAR, "it's" DECIMAL(2,1))[])

query III
SELECT """quoted col name"""['quoted ''"field name"'], profile."Estimated Cardinality", profile.children[1]."it's" FROM my_datalake.default.structname_quoted;
----
42	1	1.5

statement error
CREATE TABLE my_datalake.default.structname_empty (i INTEGER, s STRUCT);
----
DuckDB type 'STRUCT' can not be converted to a Glue type

statement error
CREATE TABLE my_datalake.default.structname_empty (i INTEGER, s STRUCT(a STRUCT)[]);
----
can not be converted to a Glue type

statement error
CREATE TABLE my_datalake.default.structname_empty AS SELECT {} AS s;
----
can not be converted to a Glue type

statement error
ALTER TABLE my_datalake.default.structname_quoted ADD COLUMN s STRUCT;
----
can not be converted to a Glue type

statement error
SELECT * FROM my_datalake.default.structname_empty;
----
does not exist

statement ok
DROP TABLE my_datalake.default.structname_quoted;
