# name: test/sql/hive/ddl/create_table/create_table_struct_field_names.test
# description: struct field names with spaces and other characters Hive type strings allow, unquoted in Glue
# group: [create_table]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.struct_names;

statement ok
CREATE TABLE my_datalake.default.struct_names (
  s STRUCT("a b" INTEGER, "Mixed Case" VARCHAR, "x.y$z" INTEGER),
  l STRUCT("in list" INTEGER)[],
  m MAP(VARCHAR, STRUCT("in  map" INTEGER))
);

query II
SELECT name, type FROM (SELECT unnest(columns, recursive := true) FROM glue_get_table_response('my_datalake.default.struct_names'));
----
s	struct<a b:int,Mixed Case:string,x.y$z:int>
l	array<struct<in list:int>>
m	map<string,struct<in  map:int>>

statement ok
INSERT INTO my_datalake.default.struct_names VALUES
  ({'a b': 1, 'Mixed Case': 'one', 'x.y$z': 2}, [{'in list': 3}], MAP {'k': {'in  map': 4}});

query IIII
SELECT s."a b", s."Mixed Case", l[1]."in list", m['k']."in  map" FROM my_datalake.default.struct_names;
----
1	one	3	4

# the names read back from Glue in a new attachment
statement ok
DETACH my_datalake;

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'struct_names' ORDER BY column_index;
----
s	STRUCT("a b" INTEGER, "Mixed Case" VARCHAR, "x.y$z" INTEGER)
l	STRUCT("in list" INTEGER)[]
m	MAP(VARCHAR, STRUCT("in  map" INTEGER))

query I
SELECT s."a b" FROM my_datalake.default.struct_names;
----
1

# a table written by another engine: a space before the ':' and a backtick quoted field name
query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'fixture_struct_names' ORDER BY column_index;
----
s	STRUCT("a b" INTEGER, "c d" VARCHAR)
id	INTEGER

# names a Hive type string can not hold unquoted are refused before anything is created
foreach name a:b a,b a<b a>b a`b

statement error
CREATE TABLE my_datalake.default.struct_names_bad (s STRUCT("{name}" INTEGER));
----
can not be stored in a Glue type

endloop

statement error
CREATE TABLE my_datalake.default.struct_names_bad (s STRUCT(" lead" INTEGER));
----
can not be stored in a Glue type

statement error
CREATE TABLE my_datalake.default.struct_names_bad (s STRUCT("trail " INTEGER));
----
can not be stored in a Glue type

statement error
SELECT * FROM my_datalake.default.struct_names_bad;
----
does not exist

# the same for the other paths that store column types
statement error
ALTER TABLE my_datalake.default.struct_names ADD COLUMN t STRUCT("a:b" INTEGER);
----
can not be stored in a Glue type

statement error
CREATE TABLE my_datalake.default.struct_names_bad AS SELECT {'a:b': 1} AS s;
----
can not be stored in a Glue type

statement error
CREATE VIEW my_datalake.default.struct_names_bad AS SELECT {'a:b': 1} AS s;
----
can not be stored in a Glue type

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'struct_names';
----
3

statement ok
DROP TABLE my_datalake.default.struct_names;
