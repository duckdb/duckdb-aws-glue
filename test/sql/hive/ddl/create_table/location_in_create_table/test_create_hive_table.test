# name: test/sql/hive/ddl/create_table/location_in_create_table/test_create_hive_table.test
# description: test creating a hive table
# group: [location_in_create_table]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}'
);

statement ok
SHOW ALL TABLES;


statement ok
DROP TABLE IF EXISTS my_datalake.default.hive_table;

statement ok
CREATE TABLE IF NOT EXISTS my_datalake.default.hive_table
(int_col integer, variant_col VARIANT, timestamp_col TIMESTAMP) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/hive_table');

query I
select distinct table_name from information_schema.columns where table_name = 'hive_table';
----
hive_table

# the table location in Glue
query I
SELECT location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/hive_table' FROM glue_get_table_response('my_datalake.default.hive_table');
----
true

# an empty location is an error rather than falling back to the location of the database
statement error
CREATE TABLE my_datalake.default.hive_table_empty_location (i INTEGER) WITH (location = '');
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'location' must not be empty.*

statement error
CREATE TABLE my_datalake.default.hive_table_empty_location (i INTEGER) WITH (location = '/');
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'location' must not be empty.*

statement error
CREATE TABLE my_datalake.default.hive_table_empty_location WITH (location = '') AS SELECT 1 AS i;
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'location' must not be empty.*

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'hive_table_empty_location';
----
0

mode skip

# We are not inserting into hive tables yet.
statement ok
insert into my_datalake.default.hive_table values (1, 5::VARIANT, now());


