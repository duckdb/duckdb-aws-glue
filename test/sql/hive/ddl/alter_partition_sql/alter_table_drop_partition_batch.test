# name: test/sql/hive/ddl/alter_partition_sql/alter_table_drop_partition_batch.test
# description: ALTER TABLE ... DROP PARTITION of many partitions: the checks fetch the partitions in one
# group: [alter_partition_sql]

#              BatchGetPartition call, and the drops go out as BatchDeletePartition calls of at most 25 partitions.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

statement ok
DROP TABLE IF EXISTS my_datalake.default.drop_batch;

statement ok
CREATE TABLE my_datalake.default.drop_batch (id INTEGER, k INTEGER) PARTITIONED BY (k);

statement ok
INSERT INTO my_datalake.default.drop_batch SELECT i, i FROM range(30) t(i);

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.drop_batch');
----
30

# 30 partitions: one BatchGetPartition for the checks, two BatchDeletePartition calls (25 + 5), no single-partition calls
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.drop_batch DROP PARTITION (k = 0), PARTITION (k = 1), PARTITION (k = 2), PARTITION (k = 3), PARTITION (k = 4), PARTITION (k = 5), PARTITION (k = 6), PARTITION (k = 7), PARTITION (k = 8), PARTITION (k = 9), PARTITION (k = 10), PARTITION (k = 11), PARTITION (k = 12), PARTITION (k = 13), PARTITION (k = 14), PARTITION (k = 15), PARTITION (k = 16), PARTITION (k = 17), PARTITION (k = 18), PARTITION (k = 19), PARTITION (k = 20), PARTITION (k = 21), PARTITION (k = 22), PARTITION (k = 23), PARTITION (k = 24), PARTITION (k = 25), PARTITION (k = 26), PARTITION (k = 27), PARTITION (k = 28), PARTITION (k = 29);

query IIII
SELECT glue_calls('BatchGetPartition'), glue_calls('BatchDeletePartition'), glue_calls('GetPartition'), glue_calls('DeletePartition');
----
1	2	0	0

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.drop_batch');
----
0

query I
SELECT count(*) FROM my_datalake.default.drop_batch;
----
0

statement ok
INSERT INTO my_datalake.default.drop_batch VALUES (100, 100), (101, 101), (102, 102);

# IF EXISTS skips a partition that does not exist, and needs no check: no BatchGetPartition
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.drop_batch DROP IF EXISTS PARTITION (k = 100), PARTITION (k = 999), PARTITION (k = 101);

query II
SELECT glue_calls('BatchGetPartition'), glue_calls('BatchDeletePartition');
----
0	1

query I
SELECT k FROM glue_partitions('my_datalake.default.drop_batch') ORDER BY k;
----
102

# without IF EXISTS a missing partition fails the statement before anything is dropped
statement error
ALTER TABLE my_datalake.default.drop_batch DROP PARTITION (k = 102), PARTITION (k = 998);
----
<REGEX>:.*Partition \[998\] does not exist in Glue table.*

query I
SELECT k FROM glue_partitions('my_datalake.default.drop_batch') ORDER BY k;
----
102

# a partition named twice is dropped once
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.drop_batch DROP PARTITION (k = 102), PARTITION (k = 102);

query I
SELECT glue_calls('BatchDeletePartition');
----
1

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.drop_batch');
----
0

# the actions run in order: a partition dropped and added again in one statement exists afterwards
statement ok
ALTER TABLE my_datalake.default.drop_batch ADD PARTITION (k = 7);

statement ok
ALTER TABLE my_datalake.default.drop_batch DROP PARTITION (k = 7) ADD IF NOT EXISTS PARTITION (k = 7);

query I
SELECT k FROM glue_partitions('my_datalake.default.drop_batch') ORDER BY k;
----
7

statement ok
DROP TABLE my_datalake.default.drop_batch;

# several partition keys, one of them NULL (__HIVE_DEFAULT_PARTITION__)
statement ok
DROP TABLE IF EXISTS my_datalake.default.drop_batch_keys;

statement ok
CREATE TABLE my_datalake.default.drop_batch_keys (id INTEGER, dt VARCHAR, n INTEGER) PARTITIONED BY (dt, n);

statement ok
INSERT INTO my_datalake.default.drop_batch_keys VALUES (1, '2024-01-01', 1), (2, '2024-01-01', NULL), (3, '2024-01-02', 2);

statement ok
ALTER TABLE my_datalake.default.drop_batch_keys DROP PARTITION (dt = '2024-01-01', n = 1), PARTITION (dt = '2024-01-01', n = NULL);

query II
SELECT dt, n FROM glue_partitions('my_datalake.default.drop_batch_keys');
----
2024-01-02	2

query I
SELECT id FROM my_datalake.default.drop_batch_keys;
----
3

statement ok
DROP TABLE my_datalake.default.drop_batch_keys;
