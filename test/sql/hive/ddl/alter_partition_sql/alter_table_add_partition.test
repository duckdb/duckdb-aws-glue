# name: test/sql/hive/ddl/alter_partition_sql/alter_table_add_partition.test
# description: ALTER TABLE ... ADD [IF NOT EXISTS] PARTITION (...) [LOCATION '...'] as SQL, through the glue_hive_ddl
# group: [alter_partition_sql]

#              grammar extension. Mirrors alter_partition/alter_table_add_partition.test, which uses the function form.

require httpfs

require glue

require-env GLUE_CATALOG_ID

# the partition DDL is a grammar extension registered by the glue extension; it has to be switched on
statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_orders_add;

statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_orders_add_staging;

statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_by_year_staging;

statement ok
CREATE TABLE my_datalake.default.sql_orders_add (id INTEGER, amount DOUBLE, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

# data laid out as <key>=<value> directories under the table location, not registered in Glue
# sql_orders_add_staging writes files in the default format at a given location; dropping it keeps the files
statement ok
CREATE TABLE my_datalake.default.sql_orders_add_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_orders_add/dt=2016-05-14/country=IN')
AS SELECT 1 AS id, 10.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.sql_orders_add_staging;

statement ok
CREATE TABLE my_datalake.default.sql_orders_add_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_orders_add/dt=2016-05-31/country=IN')
AS SELECT 2 AS id, 20.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.sql_orders_add_staging;

statement ok
CREATE TABLE my_datalake.default.sql_orders_add_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_orders_add/dt=2016-06-01/country=IN')
AS SELECT 3 AS id, 30.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.sql_orders_add_staging;

# data at custom locations, outside the table location
statement ok
CREATE TABLE my_datalake.default.sql_orders_add_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/INDIA_02_June_2016')
AS SELECT 4 AS id, 40.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.sql_orders_add_staging;

statement ok
CREATE TABLE my_datalake.default.sql_orders_add_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/INDIA_03_June_2016')
AS SELECT 5 AS id, 50.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.sql_orders_add_staging;

query I
SELECT count(*) FROM my_datalake.default.sql_orders_add;
----
0

#---------------------------------------------------------------------------
# ALTER TABLE orders ADD PARTITION (dt = '2016-05-14', country = 'IN');
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.sql_orders_add ADD PARTITION (dt = '2016-05-14', country = 'IN');

query III
SELECT dt, country, location FROM glue_partitions('my_datalake.default.sql_orders_add') ORDER BY dt;
----
2016-05-14	IN	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_orders_add/dt=2016-05-14/country=IN

query II
SELECT id, amount FROM my_datalake.default.sql_orders_add ORDER BY id;
----
1	10.0

#---------------------------------------------------------------------------
# several partitions in one statement: ADD PARTITION (...) PARTITION (...)
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.sql_orders_add ADD
    PARTITION (dt = '2016-05-31', country = 'IN')
    PARTITION (dt = '2016-06-01', country = 'IN');

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.sql_orders_add') ORDER BY dt;
----
2016-05-14	IN
2016-05-31	IN
2016-06-01	IN

#---------------------------------------------------------------------------
# several partitions with their own locations, chained: ADD PARTITION (...) LOCATION '...' ADD PARTITION (...) LOCATION '...'
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.sql_orders_add
    ADD PARTITION (dt = '2016-06-02', country = 'IN') LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/INDIA_02_June_2016/'
    ADD PARTITION (dt = '2016-06-03', country = 'IN') LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/INDIA_03_June_2016/';

query II
SELECT dt, location LIKE '%/INDIA_0%_June_2016' FROM glue_partitions('my_datalake.default.sql_orders_add') WHERE dt >= '2016-06-02' ORDER BY dt;
----
2016-06-02	true
2016-06-03	true

# the partition values of a partition with a custom location come from Glue, not from the path
query IIII
SELECT id, amount, dt, country FROM my_datalake.default.sql_orders_add ORDER BY id;
----
1	10.0	2016-05-14	IN
2	20.0	2016-05-31	IN
3	30.0	2016-06-01	IN
4	40.0	2016-06-02	IN
5	50.0	2016-06-03	IN

query I
SELECT id FROM my_datalake.default.sql_orders_add WHERE dt = '2016-06-03';
----
5

#---------------------------------------------------------------------------
# ALTER TABLE orders ADD IF NOT EXISTS PARTITION (...)
#---------------------------------------------------------------------------
statement error
ALTER TABLE my_datalake.default.sql_orders_add ADD PARTITION (dt = '2016-05-14', country = 'IN');
----
already exists

statement ok
ALTER TABLE my_datalake.default.sql_orders_add ADD IF NOT EXISTS PARTITION (dt = '2016-05-14', country = 'IN');

# IF NOT EXISTS applies to every partition of the statement
statement ok
ALTER TABLE my_datalake.default.sql_orders_add ADD IF NOT EXISTS
    PARTITION (dt = '2016-05-14', country = 'IN')
    PARTITION (dt = '2016-06-04', country = 'IN');

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.sql_orders_add');
----
6

# a statement that fails registers nothing (the second partition already exists)
statement error
ALTER TABLE my_datalake.default.sql_orders_add ADD
    PARTITION (dt = '2016-06-05', country = 'IN')
    PARTITION (dt = '2016-05-14', country = 'IN');
----
already exists

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.sql_orders_add') WHERE dt = '2016-06-05';
----
0

#---------------------------------------------------------------------------
# the partition spec must name every partition key, and only partition keys
#---------------------------------------------------------------------------
statement error
ALTER TABLE my_datalake.default.sql_orders_add ADD PARTITION (dt = '2016-07-01');
----

# id is a data column, not a partition key
statement error
ALTER TABLE my_datalake.default.sql_orders_add ADD PARTITION (dt = '2016-07-01', country = 'IN', id = 1);
----

# the partition keys can be given in any order
statement ok
ALTER TABLE my_datalake.default.sql_orders_add ADD PARTITION (country = 'US', dt = '2016-07-01');

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.sql_orders_add') WHERE country = 'US';
----
2016-07-01	US

#---------------------------------------------------------------------------
# non-string partition values are written the way the key type renders them
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_by_year;

statement ok
CREATE TABLE my_datalake.default.sql_by_year (id INTEGER, year INTEGER) PARTITIONED BY (year);

statement ok
CREATE TABLE my_datalake.default.sql_by_year_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_by_year/year=2016')
AS SELECT 1 AS id;

statement ok
DROP TABLE my_datalake.default.sql_by_year_staging;

statement ok
ALTER TABLE my_datalake.default.sql_by_year ADD PARTITION (year = 2016);

query III
SELECT year, typeof(year), location FROM glue_partitions('my_datalake.default.sql_by_year');
----
2016	INTEGER	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_by_year/year=2016

query II
SELECT id, year FROM my_datalake.default.sql_by_year WHERE year = 2016;
----
1	2016

#---------------------------------------------------------------------------
# only Glue tables; the syntax is not available without the grammar extension
#---------------------------------------------------------------------------
statement ok
CREATE TABLE memory.main.not_glue (dt VARCHAR, country VARCHAR);

statement error
ALTER TABLE memory.main.not_glue ADD PARTITION (dt = '2016-07-01', country = 'IN');
----

statement ok
RESET active_grammar_extensions;

statement error
ALTER TABLE my_datalake.default.sql_orders_add ADD PARTITION (dt = '2016-08-01', country = 'IN');
----

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

# the second attach sees the partitions registered in Glue
statement ok
attach '{GLUE_CATALOG_ID}' as verify_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query I
SELECT count(*) FROM glue_partitions('verify_datalake.default.sql_orders_add');
----
7

statement ok
DROP TABLE my_datalake.default.sql_orders_add;

statement ok
DROP TABLE my_datalake.default.sql_by_year;
