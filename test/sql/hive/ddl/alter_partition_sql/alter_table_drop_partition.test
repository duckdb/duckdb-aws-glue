# name: test/sql/hive/ddl/alter_partition_sql/alter_table_drop_partition.test
# description: ALTER TABLE ... DROP [IF EXISTS] PARTITION (...) [, PARTITION (...)] as SQL, through the glue_hive_ddl
# group: [alter_partition_sql]

#              grammar extension. Mirrors alter_partition/alter_table_drop_partition.test.

require httpfs

require glue

require-env GLUE_CATALOG_ID

# this test is about Parquet tables, so they stay Parquet whatever the config's default format
statement ok
SET hive_default_format = 'parquet';

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_orders_drop;

statement ok
CREATE TABLE my_datalake.default.sql_orders_drop (id INTEGER, amount DOUBLE, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

# INSERT registers the partitions it writes
statement ok
INSERT INTO my_datalake.default.sql_orders_drop VALUES
    (1, 10.0, '2014-05-14', 'IN'),
    (2, 20.0, '2014-05-15', 'IN'),
    (3, 30.0, '2014-05-16', 'IN'),
    (4, 40.0, '2014-05-16', 'US'),
    (5, 50.0, '2014-05-17', 'US');

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.sql_orders_drop');
----
5

#---------------------------------------------------------------------------
# ALTER TABLE orders DROP PARTITION (dt = '2014-05-14', country = 'IN');
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.sql_orders_drop DROP PARTITION (dt = '2014-05-14', country = 'IN');

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.sql_orders_drop') ORDER BY dt, country;
----
2014-05-15	IN
2014-05-16	IN
2014-05-16	US
2014-05-17	US

# the data of a dropped partition is no longer read ...
query I
SELECT id FROM my_datalake.default.sql_orders_drop ORDER BY id;
----
2
3
4
5

# ... but its files stay in S3
query I
SELECT count(*) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_orders_drop/dt=2014-05-14/country=IN/*.parquet');
----
1

#---------------------------------------------------------------------------
# ALTER TABLE orders DROP PARTITION (...), PARTITION (...);   (comma separated)
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.sql_orders_drop DROP
    PARTITION (dt = '2014-05-15', country = 'IN'),
    PARTITION (dt = '2014-05-16', country = 'IN');

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.sql_orders_drop') ORDER BY dt, country;
----
2014-05-16	US
2014-05-17	US

# chained form
statement ok
ALTER TABLE my_datalake.default.sql_orders_drop
    DROP PARTITION (dt = '2014-05-16', country = 'US')
    DROP PARTITION (dt = '2014-05-17', country = 'US');

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.sql_orders_drop');
----
0

query I
SELECT count(*) FROM my_datalake.default.sql_orders_drop;
----
0

#---------------------------------------------------------------------------
# ALTER TABLE orders DROP IF EXISTS PARTITION (...)
#---------------------------------------------------------------------------
statement error
ALTER TABLE my_datalake.default.sql_orders_drop DROP PARTITION (dt = '2014-05-14', country = 'IN');
----
does not exist

statement ok
ALTER TABLE my_datalake.default.sql_orders_drop DROP IF EXISTS PARTITION (dt = '2014-05-14', country = 'IN');

# a statement that fails drops nothing
statement ok
ALTER TABLE my_datalake.default.sql_orders_drop ADD PARTITION (dt = '2014-05-14', country = 'IN');

statement error
ALTER TABLE my_datalake.default.sql_orders_drop DROP
    PARTITION (dt = '2014-05-14', country = 'IN'),
    PARTITION (dt = '2099-01-01', country = 'IN');
----
does not exist

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.sql_orders_drop');
----
1

# the partition spec must name every partition key (there is no syntax for dropping a range of partitions)
statement error
ALTER TABLE my_datalake.default.sql_orders_drop DROP PARTITION (dt = '2014-05-14');
----

# a dropped partition can be added again, its files are then read again
statement ok
ALTER TABLE my_datalake.default.sql_orders_drop DROP PARTITION (dt = '2014-05-14', country = 'IN');

statement ok
ALTER TABLE my_datalake.default.sql_orders_drop ADD PARTITION (dt = '2014-05-14', country = 'IN');

query I
SELECT id FROM my_datalake.default.sql_orders_drop;
----
1

statement ok
attach '{GLUE_CATALOG_ID}' as verify_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT dt, country FROM glue_partitions('verify_datalake.default.sql_orders_drop');
----
2014-05-14	IN

statement ok
DROP TABLE my_datalake.default.sql_orders_drop;
