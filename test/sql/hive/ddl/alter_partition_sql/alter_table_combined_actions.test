# name: test/sql/hive/ddl/alter_partition_sql/alter_table_combined_actions.test
# description: One ALTER TABLE carries several adds, drops or table locations, but no other combination of actions
# group: [alter_partition_sql]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_orders_combined;

statement ok
CREATE TABLE my_datalake.default.sql_orders_combined (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
ALTER TABLE my_datalake.default.sql_orders_combined ADD PARTITION (dt = '1') PARTITION (dt = '2') PARTITION (dt = '3');

statement ok
ALTER TABLE my_datalake.default.sql_orders_combined DROP PARTITION (dt = '3'), PARTITION (dt = '2');

statement error
ALTER TABLE my_datalake.default.sql_orders_combined ADD PARTITION (dt = '2') DROP PARTITION (dt = '1');
----
<REGEX>:Binder Error.*add partition and drop partition can not be combined in one statement.*

statement error
ALTER TABLE my_datalake.default.sql_orders_combined ADD PARTITION (dt = '2') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/combined';
----
<REGEX>:Binder Error.*add partition and set table location can not be combined in one statement.*

statement error
ALTER TABLE my_datalake.default.sql_orders_combined PARTITION (dt = '1') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/combined/a'
    PARTITION (dt = '1') RENAME TO PARTITION (dt = '2');
----
<REGEX>:Binder Error.*set partition location and rename partition can not be combined in one statement.*

statement error
ALTER TABLE my_datalake.default.sql_orders_combined PARTITION (dt = '1') RENAME TO PARTITION (dt = '2')
    PARTITION (dt = '2') RENAME TO PARTITION (dt = '3');
----
<REGEX>:Binder Error.*only one partition can be renamed per statement.*

statement error
ALTER TABLE my_datalake.default.sql_orders_combined PARTITION (dt = '1') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/combined/a'
    PARTITION (dt = '1') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/combined/b';
----
<REGEX>:Binder Error.*the location of partition \[1\] is set more than once.*

# the refused statements changed nothing
query II
SELECT dt, location LIKE '%/combined/%' FROM glue_partitions('my_datalake.default.sql_orders_combined');
----
1	false

statement ok
ALTER TABLE my_datalake.default.sql_orders_combined SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/combined/t1'
    SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/combined/t2';

query I
SELECT location LIKE '%/combined/t2%' FROM glue_get_table_response('my_datalake.default.sql_orders_combined');
----
true

statement ok
DROP TABLE my_datalake.default.sql_orders_combined;
