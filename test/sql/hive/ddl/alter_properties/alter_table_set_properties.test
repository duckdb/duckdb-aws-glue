# name: test/sql/hive/ddl/alter_properties/alter_table_set_properties.test
# description: ALTER TABLE ... SET (k = v) / RESET (k) on a Hive table: Glue's table parameters (Hive's TBLPROPERTIES)
# group: [alter_properties]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_properties;

statement ok
CREATE TABLE my_datalake.default.ddl_properties (id INTEGER, name VARCHAR) WITH (owner = 'analytics');

statement ok
INSERT INTO my_datalake.default.ddl_properties VALUES (1, 'ann');

# what CREATE TABLE stored
query I
SELECT parameters['owner'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
analytics

#---------------------------------------------------------------------------
# SET adds and overwrites, other parameters stay
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.ddl_properties SET (comment = 'customer names', retention_days = 30);

query III
SELECT parameters['owner'], parameters['comment'], parameters['retention_days']
FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
analytics	customer names	30

statement ok
ALTER TABLE my_datalake.default.ddl_properties SET (owner = 'finance');

query II
SELECT parameters['owner'], parameters['comment'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
finance	customer names

# a dotted Hive property name, and the value the way Glue stores it: a string
statement ok
ALTER TABLE my_datalake.default.ddl_properties SET ('parquet.compression' = 'ZSTD', 'compression_level' = 4);

query II
SELECT parameters['parquet.compression'], parameters['compression_level']
FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
ZSTD	4

# the value can be an expression (DuckDB's option grammar takes a leading string literal as the whole value, so an
# expression must not start with one)
statement ok
ALTER TABLE my_datalake.default.ddl_properties SET (batch = concat('run_', 40 + 2));

query I
SELECT parameters['batch'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
run_42

# the parameters CreateTable wrote are untouched
query II
SELECT parameters['EXTERNAL'], parameters['classification'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
TRUE	parquet

# the Athena documentation examples, spelled natively: a value with spaces and a quote is stored verbatim
statement ok
ALTER TABLE my_datalake.default.ddl_properties SET (notes = 'Please don''t drop this table.');

query I
SELECT parameters['notes'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
Please don't drop this table.

# Athena: "EXTERNAL = FALSE has no effect": the parameter is stored, the table stays a readable Hive table
statement ok
ALTER TABLE my_datalake.default.ddl_properties SET (EXTERNAL = 'FALSE');

query II
SELECT parameters['EXTERNAL'], table_type FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
FALSE	HIVE

query II
SELECT id, name FROM my_datalake.default.ddl_properties;
----
1	ann

statement ok
ALTER TABLE my_datalake.default.ddl_properties SET (EXTERNAL = 'TRUE', 'skip.header.line.count' = 1);

query I
SELECT parameters['skip.header.line.count'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
1

statement ok
ALTER TABLE my_datalake.default.ddl_properties RESET (notes, 'skip.header.line.count');

#---------------------------------------------------------------------------
# RESET removes; a key the table does not have is not an error
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.ddl_properties RESET (retention_days, batch);

query I
SELECT list_sort(map_keys(parameters)) FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
[EXTERNAL, classification, comment, compression_level, numFiles, numRows, owner, parquet.compression, totalSize]

statement ok
ALTER TABLE my_datalake.default.ddl_properties RESET (does_not_exist);

query I
SELECT parameters['owner'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
finance

#---------------------------------------------------------------------------
# the Hive spelling is not part of this extension: it is a plain parser error, grammar extension or not
#---------------------------------------------------------------------------
statement error
ALTER TABLE my_datalake.default.ddl_properties SET TBLPROPERTIES ('owner' = 'x');
----
Parser Error

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement error
ALTER TABLE my_datalake.default.ddl_properties SET TBLPROPERTIES ('owner' = 'x');
----
Parser Error

statement ok
RESET active_grammar_extensions;

#---------------------------------------------------------------------------
# errors: the format parameters, NULL values, a missing table
#---------------------------------------------------------------------------
statement error
ALTER TABLE my_datalake.default.ddl_properties SET (table_type = 'ICEBERG');
----
Table property 'table_type' decides how the table is read and can not be changed with ALTER TABLE

statement error
ALTER TABLE my_datalake.default.ddl_properties SET ('spark.sql.sources.provider' = 'delta');
----
can not be changed with ALTER TABLE

statement error
ALTER TABLE my_datalake.default.ddl_properties RESET (metadata_location);
----
can not be changed with ALTER TABLE

statement error
ALTER TABLE my_datalake.default.ddl_properties SET (owner = NULL);
----
NULL is not a valid value for ALTER TABLE SET option 'owner'

statement error
ALTER TABLE my_datalake.default.ddl_missing SET (owner = 'x');
----
does not exist

# nothing above changed the table or its data
query I
SELECT parameters['owner'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
finance

query II
SELECT id, name FROM my_datalake.default.ddl_properties;
----
1	ann

# a second attach sees the change: it is stored in Glue, not only in the cached entry
statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake_2 (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT parameters['owner'], parameters['comment'] FROM glue_get_table_response('my_datalake_2.default.ddl_properties');
----
finance	customer names

# a view is not a table
statement error
ALTER TABLE my_datalake.default.fixture_view_plain SET (owner = 'x');
----
is a view

# a READ_ONLY attach refuses both statements before the extension is reached (DuckDB's binder registers the ALTER
# as a modification of the attached database), and the parameters stay as they were
statement ok
attach '{GLUE_CATALOG_ID}' as ro_datalake (
    TYPE glue,
    READ_ONLY,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query I
SELECT parameters['owner'] FROM glue_get_table_response('ro_datalake.default.ddl_properties');
----
finance

statement error
ALTER TABLE ro_datalake.default.ddl_properties SET (owner = 'hijacked');
----
Cannot execute statement of type "ALTER" on database "ro_datalake" which is attached in read-only mode!

statement error
ALTER TABLE ro_datalake.default.ddl_properties RESET (owner);
----
Cannot execute statement of type "ALTER" on database "ro_datalake" which is attached in read-only mode!

query II
SELECT parameters['owner'], parameters['comment'] FROM glue_get_table_response('my_datalake.default.ddl_properties');
----
finance	customer names

statement ok
DROP TABLE my_datalake.default.ddl_properties;
