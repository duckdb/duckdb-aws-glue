# name: test/sql/hive/ddl/glue_calls_per_ddl.test
# description: Each partition / table DDL asks Glue for an object once: the fetch that checks it is the one the
# group: [ddl]

#              mutation rewrites from, nothing is fetched a second time in the same statement

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.calls_orders;

statement ok
CREATE TABLE my_datalake.default.calls_orders (id INTEGER, amount DOUBLE, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.calls_orders VALUES (1, 10.0, '2026-01-01'), (2, 20.0, '2026-01-02');

# The Glue API calls since the last truncate_duckdb_logs(), by operation
statement ok
CREATE MACRO glue_calls() AS TABLE
    SELECT regexp_extract(request.headers['x-amz-target'], 'AWSGlue\.(\w+)', 1) AS api, count(*) AS n
    FROM duckdb_logs_parsed('HTTP')
    WHERE request.headers['x-amz-target'] IS NOT NULL
    GROUP BY 1 ORDER BY 1;

# the Glue operation is in the x-amz-target header, which HTTP logs redact by default
statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage='memory');

#---------------------------------------------------------------------------
# RENAME PARTITION through ALTER TABLE: the pre-check fetches the partition to rename and probes that the new
# values are free; the rename reuses both and makes no fetch of its own
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders PARTITION (dt = '2026-01-01') RENAME TO PARTITION (dt = '2026-01-03');

query II
FROM glue_calls();
----
GetPartition	2
GetTable	1
UpdatePartition	1

# the rename kept everything but the values
query II
SELECT dt, location FROM glue_partitions('my_datalake.default.calls_orders') WHERE dt = '2026-01-03';
----
2026-01-03	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/calls_orders/dt=2026-01-01

#---------------------------------------------------------------------------
# RENAME PARTITION through glue_rename_partition: no pre-check, the rename fetches the partition and probes the
# new values once each; the location it reports is the one it fetched, not fetched again
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

query I
CALL glue_rename_partition('my_datalake.default.calls_orders', {dt: '2026-01-03'}, {dt: '2026-01-01'});
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/calls_orders/dt=2026-01-01

query II
FROM glue_calls();
----
GetPartition	2
GetTable	1
UpdatePartition	1

#---------------------------------------------------------------------------
# SET PARTITION LOCATION: the pre-check fetches the partition, the update rewrites it from that fetch
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders PARTITION (dt = '2026-01-02') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/calls_orders/moved';

query II
FROM glue_calls();
----
GetPartition	1
GetTable	1
UpdatePartition	1

query I
SELECT location FROM glue_partitions('my_datalake.default.calls_orders') WHERE dt = '2026-01-02';
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/calls_orders/moved

#---------------------------------------------------------------------------
# ADD PARTITION: the partition's StorageDescriptor is the table's, taken from the table fetched at bind
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders ADD PARTITION (dt = '2026-01-04');

query II
FROM glue_calls();
----
BatchCreatePartition	1
GetPartition	1
GetTable	1

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL glue_add_partition('my_datalake.default.calls_orders', {dt: '2026-01-05'});

query II
FROM glue_calls();
----
CreatePartition	1
GetTable	1

#---------------------------------------------------------------------------
# Several actions in one statement: every action is checked before any is applied, and each is applied from
# what its check fetched
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders
    PARTITION (dt = '2026-01-04') RENAME TO PARTITION (dt = '2026-01-06')
    PARTITION (dt = '2026-01-05') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/calls_orders/moved5';

query II
FROM glue_calls();
----
GetPartition	3
GetTable	1
UpdatePartition	2

# a failing action leaves the others unapplied: the check runs for all before the first write
statement error
ALTER TABLE my_datalake.default.calls_orders
    PARTITION (dt = '2026-01-06') RENAME TO PARTITION (dt = '2026-01-07')
    PARTITION (dt = 'no-such-partition') SET LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}/x';
----
does not exist

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.calls_orders') WHERE dt = '2026-01-06';
----
1

#---------------------------------------------------------------------------
# SET TABLE LOCATION through glue_set_table_location: the table fetched at bind is the one rewritten
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
CALL glue_set_table_location('my_datalake.default.calls_orders', '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/calls_orders_moved');

query II
FROM glue_calls();
----
GetTable	1
UpdateTable	1

#---------------------------------------------------------------------------
# glue_replace_columns: the table fetched at bind is the one rewritten; the refresh afterwards is the catalog's
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
CALL glue_replace_columns('my_datalake.default.calls_orders', {id: 'BIGINT', amount: 'DOUBLE'});

query II
FROM glue_calls();
----
GetTable	2
UpdateTable	1

#---------------------------------------------------------------------------
# Column DDLs through ALTER TABLE / COMMENT ON: the table fetched for the column check is the one rewritten; the
# fetch afterwards is the catalog's refresh
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders ADD COLUMN qty INTEGER;

query II
FROM glue_calls();
----
GetTable	2
UpdateTable	1

statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders ALTER COLUMN qty TYPE BIGINT;

query II
FROM glue_calls();
----
GetTable	2
UpdateTable	1

statement ok
CALL truncate_duckdb_logs();

statement ok
COMMENT ON COLUMN my_datalake.default.calls_orders.qty IS 'units ordered';

query II
FROM glue_calls();
----
GetTable	2
UpdateTable	1

statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders DROP COLUMN qty;

query II
FROM glue_calls();
----
GetTable	2
UpdateTable	1

# RENAME COLUMN is only allowed on csv tables, whose files are read by position
statement ok
DROP TABLE IF EXISTS my_datalake.default.calls_orders_csv;

statement ok
CREATE TABLE my_datalake.default.calls_orders_csv (id INTEGER, qty INTEGER) WITH (format = 'csv');

statement ok
CALL truncate_duckdb_logs();

statement ok
ALTER TABLE my_datalake.default.calls_orders_csv RENAME COLUMN qty TO quantity;

query II
FROM glue_calls();
----
GetTable	2
UpdateTable	1

statement ok
DROP TABLE my_datalake.default.calls_orders_csv;

statement ok
DROP TABLE my_datalake.default.calls_orders;
