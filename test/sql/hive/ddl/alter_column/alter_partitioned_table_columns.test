# name: test/sql/hive/ddl/alter_column/alter_partitioned_table_columns.test
# description: Changing the columns of a partitioned table leaves its partitions' columns as they were; the existing
# group: [alter_column]

#              data still reads with the table's columns, and partitions created afterwards take the table's columns

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.apc_orders;

statement ok
DROP TABLE IF EXISTS my_datalake.default.apc_lines;

# parquet: files are matched to the columns by name
statement ok
CREATE TABLE my_datalake.default.apc_orders (id INTEGER, v INTEGER, w VARCHAR, dt VARCHAR) PARTITIONED BY (dt)
WITH (format = 'parquet');

statement ok
INSERT INTO my_datalake.default.apc_orders VALUES (1, 10, 'a', 'p1');

statement ok
ALTER TABLE my_datalake.default.apc_orders ALTER COLUMN v TYPE BIGINT;

statement ok
ALTER TABLE my_datalake.default.apc_orders ADD COLUMN extra VARCHAR;

statement ok
ALTER TABLE my_datalake.default.apc_orders DROP COLUMN w;

query IITT
SELECT id, v, extra, dt FROM my_datalake.default.apc_orders;
----
1	10	NULL	p1

query T
SELECT typeof(v) FROM my_datalake.default.apc_orders;
----
BIGINT

# the partition keeps the columns it was created with
query T
SELECT [c.name || ' ' || c.type FOR c IN columns] FROM glue_get_partition_response('my_datalake.default.apc_orders', {dt: 'p1'});
----
[id int, v int, w string]

# partitions created after the change take the table's columns, however they are created
statement ok
INSERT INTO my_datalake.default.apc_orders VALUES (2, 3000000000, 'e', 'p2');

statement ok
CALL glue_add_partition('my_datalake.default.apc_orders', {dt: 'p3'});

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
ALTER TABLE my_datalake.default.apc_orders ADD PARTITION (dt = 'p4');

statement ok
SET active_grammar_extensions = [];

query TT
SELECT partition_values[1], [c.name || ' ' || c.type FOR c IN columns]
FROM (SELECT * FROM glue_get_partition_response('my_datalake.default.apc_orders', {dt: 'p2'})
      UNION ALL SELECT * FROM glue_get_partition_response('my_datalake.default.apc_orders', {dt: 'p3'})
      UNION ALL SELECT * FROM glue_get_partition_response('my_datalake.default.apc_orders', {dt: 'p4'}))
ORDER BY 1;
----
p2	[id int, v bigint, extra string]
p3	[id int, v bigint, extra string]
p4	[id int, v bigint, extra string]

query IITT
SELECT id, v, extra, dt FROM my_datalake.default.apc_orders ORDER BY id;
----
1	10	NULL	p1
2	3000000000	e	p2

# csv: files are read by position
statement ok
CREATE TABLE my_datalake.default.apc_lines (id INTEGER, s VARCHAR, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.apc_lines VALUES (1, 'a', 'p1');

statement ok
ALTER TABLE my_datalake.default.apc_lines ADD COLUMN extra VARCHAR;

statement ok
ALTER TABLE my_datalake.default.apc_lines RENAME COLUMN s TO label;

statement ok
ALTER TABLE my_datalake.default.apc_lines ALTER COLUMN id TYPE BIGINT;

query T
SELECT [c.name || ' ' || c.type FOR c IN columns] FROM glue_get_partition_response('my_datalake.default.apc_lines', {dt: 'p1'});
----
[id int, s string]

statement ok
INSERT INTO my_datalake.default.apc_lines VALUES (2, 'b', 'x', 'p2');

query T
SELECT [c.name || ' ' || c.type FOR c IN columns] FROM glue_get_partition_response('my_datalake.default.apc_lines', {dt: 'p2'});
----
[id bigint, label string, extra string]

query ITTT
SELECT id, label, extra, dt FROM my_datalake.default.apc_lines ORDER BY id;
----
1	a	NULL	p1
2	b	x	p2

statement ok
DROP TABLE my_datalake.default.apc_orders;

statement ok
DROP TABLE my_datalake.default.apc_lines;
