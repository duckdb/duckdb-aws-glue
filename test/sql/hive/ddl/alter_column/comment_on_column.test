# name: test/sql/hive/ddl/alter_column/comment_on_column.test
# description: COMMENT ON COLUMN on a Hive table registered in Glue
# group: [alter_column]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.comment_col;

statement ok
DROP VIEW IF EXISTS my_datalake.default.comment_col_view;

statement ok
CREATE TABLE my_datalake.default.comment_col (id INTEGER, name VARCHAR, dt VARCHAR) PARTITIONED BY (dt);

statement ok
COMMENT ON COLUMN my_datalake.default.comment_col.id IS 'the id';

statement ok
COMMENT ON COLUMN my_datalake.default.comment_col.NAME IS 'it''s the name';

query II
SELECT column_name, comment FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'comment_col' ORDER BY column_index;
----
id	the id
name	it's the name
dt	NULL

# stored in Glue
query I
SELECT columns FROM glue_get_table_response('my_datalake.default.comment_col');
----
[{'name': id, 'type': int, 'comment': the id}, {'name': name, 'type': string, 'comment': 'it\'s the name'}]

# other column changes keep the comments (glue_replace_columns with keep_comments)
statement ok
ALTER TABLE my_datalake.default.comment_col ALTER COLUMN id TYPE BIGINT;

statement ok
CALL glue_replace_columns('my_datalake.default.comment_col', {id: 'BIGINT', name: 'VARCHAR', extra: 'VARCHAR'}, keep_comments := true);

query II
SELECT column_name, comment FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'comment_col' ORDER BY column_index;
----
id	the id
name	it's the name
extra	NULL
dt	NULL

# NULL removes the comment
statement ok
COMMENT ON COLUMN my_datalake.default.comment_col.id IS NULL;

query II
SELECT column_name, comment FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'comment_col' AND column_name = 'id';
----
id	NULL

# errors
statement error
COMMENT ON COLUMN my_datalake.default.comment_col.nope IS 'x';
----
nope

statement error
COMMENT ON COLUMN my_datalake.default.comment_col.dt IS 'x';
----
Comments on the partition keys of Glue tables are not supported yet

statement ok
CREATE VIEW my_datalake.default.comment_col_view AS SELECT 1 AS a;

statement error
COMMENT ON COLUMN my_datalake.default.comment_col_view.a IS 'x';
----
Comments on Glue views are not supported yet

statement ok
DROP VIEW my_datalake.default.comment_col_view;

statement ok
DROP TABLE my_datalake.default.comment_col;
