# name: test/sql/hive/catalog/cached_miss_errors.test
# description: a GetTable that fails is not kept as a miss: the next lookup of the table asks Glue again and finds it
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_FAULT_ENDPOINT

# the database is dropped and created through the proxy, which resets its fault, so a rerun (or a leftover schema
# of an earlier failed run) sees the first GetTable fail again; the table is created past the proxy
statement ok
ATTACH '{GLUE_CATALOG_ID}' AS setup (TYPE glue, ENDPOINT '{GLUE_FAULT_ENDPOINT}');

statement ok
ATTACH '{GLUE_CATALOG_ID}' AS my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP SCHEMA IF EXISTS setup.fault_get_table_once_cme CASCADE;

statement ok
CREATE SCHEMA setup.fault_get_table_once_cme;

statement ok
CREATE TABLE my_datalake.fault_get_table_once_cme.t1 AS SELECT 1 AS id;

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok con2
SET glue_metadata_cache_scope = 'connection';

statement ok con2
ATTACH '{GLUE_CATALOG_ID}' AS faulty (TYPE glue, ENDPOINT '{GLUE_FAULT_ENDPOINT}');

statement ok con2
SET redact_http_logs = false;

statement ok con2
CALL enable_logging('HTTP', storage := 'memory');

# the proxy refuses the first GetTable of t1: the lookup fails instead of reporting the table missing
statement error con2
SELECT id FROM faulty.fault_get_table_once_cme.t1;
----
<REGEX>:.*AccessDenied.*

statement ok con2
CALL truncate_duckdb_logs();

# the failure was not kept: the lookup reaches Glue again and finds the table
query I con2
SELECT id FROM faulty.fault_get_table_once_cme.t1;
----
1

query I con2
SELECT glue_calls('GetTable') > 0;
----
true

statement ok
DROP SCHEMA my_datalake.fault_get_table_once_cme CASCADE;
