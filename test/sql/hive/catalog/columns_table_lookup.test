# name: test/sql/hive/catalog/columns_table_lookup.test
# description: a table_name equality pushed into duckdb_columns/duckdb_tables/duckdb_views is served by one GetTable lookup (or the cached entry) instead of listing every table of the database; other filter shapes still list
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP SCHEMA IF EXISTS my_datalake.ctl_db CASCADE;

statement ok
CREATE SCHEMA my_datalake.ctl_db;

statement ok
CREATE TABLE my_datalake.ctl_db.t1 (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE my_datalake.ctl_db.t2 (id INTEGER);

statement ok
CREATE VIEW my_datalake.ctl_db.v1 AS SELECT id FROM my_datalake.ctl_db.t1;

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

# a repeated table lookup would otherwise warm the metadata cache with one GetTables page, which the counts below
# could not tell from a listing
statement ok
SET glue_batch_table_lookup = false;

# the same catalog again with empty entry caches, so the first lookup of each table is a cold one
statement ok
attach '{GLUE_CATALOG_ID}' as cold_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# 1. the columns of one table: the schema and the table are each one lookup, nothing is listed
statement ok
CALL truncate_duckdb_logs();

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 't1' ORDER BY column_index;
----
id	INTEGER
name	VARCHAR

query IIII
SELECT glue_calls('GetDatabase'), glue_calls('GetDatabases'), glue_calls('GetTable'), glue_calls('GetTables');
----
1	0	1	0

# 2. the same table again is one lookup, not a listing: a table definition is re-read once per transaction
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 't1';
----
2

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
1	0

# 3. information_schema.columns reaches the same lookup through the view chain
statement ok
CALL truncate_duckdb_logs();

query I
SELECT column_name FROM information_schema.columns WHERE table_catalog = 'cold_datalake' AND table_schema = 'ctl_db' AND table_name = 't2';
----
id

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
1	0

# 4. duckdb_tables and duckdb_views take the same path
statement ok
CALL truncate_duckdb_logs();

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 't2';
----
t2

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND view_name = 'v1';
----
v1

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
2	0

# 5. the lookup returns whatever Glue holds under the name; the function keeps only its own entry type
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 'v1';
----
0

query I
SELECT count(*) FROM duckdb_views() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND view_name = 't1';
----
0

query I
SELECT glue_calls('GetTables');
----
0

# the columns of a view are collected through the table scan, so a view's columns are found by lookup too
query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 'v1';
----
id

query I
SELECT glue_calls('GetTables');
----
0

# 6. lower() of the name and the reversed operand order are the same lookup
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND lower(table_name) = 't1';
----
2

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND 't2' = table_name;
----
1

query I
SELECT glue_calls('GetTables');
----
0

# 7. a case-mismatched equality finds nothing without listing: the lookup result fails the filter re-check
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 'T1';
----
0

query I
SELECT glue_calls('GetTables');
----
0

# 8. a non-existent table is one lookup miss, not an error
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 'ctl_nope';
----
0

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
1	0

# 9. an unfiltered scan after the point lookups lists the database: the lookups did not mark the set as loaded
statement ok
CALL truncate_duckdb_logs();

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' ORDER BY table_name;
----
t1
t2

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
0	1

# 10. shapes a lookup cannot serve are answered from the listed set: no lookup, and the set is listed only once
statement ok
CALL truncate_duckdb_logs();

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name LIKE 't%' ORDER BY table_name;
----
t1
t2

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name IN ('t1', 't2') ORDER BY table_name;
----
t1
t2

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name <> 't1' ORDER BY table_name;
----
t2

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
0	0

# 11. a table created through another attach is found by lookup
statement ok
CREATE TABLE my_datalake.ctl_db.t3 (x INTEGER);

statement ok
CALL truncate_duckdb_logs();

query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'cold_datalake' AND schema_name = 'ctl_db' AND table_name = 't3';
----
x

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
1	0

statement ok
DROP SCHEMA my_datalake.ctl_db CASCADE;
