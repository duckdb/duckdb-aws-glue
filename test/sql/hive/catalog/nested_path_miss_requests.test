# name: test/sql/hive/catalog/nested_path_miss_requests.test
# description: what a name that is not found costs: a table costs what it did, a schema on its own one GetCatalog more, which an endpoint without that call is asked once per attached catalog
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

# only against the local servers: the counts of 3. and 4. are those of an endpoint without GetCatalog
require-env GLUE_TEST_CONFIG local

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok
SET redact_http_logs = false;

statement ok
attach '{GLUE_CATALOG_ID}' as cold_datalake (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# 1. a table in a schema that does not exist: the table, then its database, and no child catalog. The binder asks
# twice, as it does without this lookup.
statement ok
CALL truncate_duckdb_logs();

statement error
SELECT * FROM cold_datalake.npmr_no_such_schema.t;
----
does not exist

query III
SELECT glue_calls('GetTable'), glue_calls('GetDatabase'), glue_calls('GetCatalog');
----
2	2	0

# 2. the same below a child catalog that does not exist
statement ok
CALL truncate_duckdb_logs();

statement error
SELECT * FROM cold_datalake.npmr_no_such_catalog.npmr_no_such_schema.t;
----
does not exist

query III
SELECT glue_calls('GetTable'), glue_calls('GetDatabase'), glue_calls('GetCatalog');
----
2	2	0

# 3. a schema on its own: the database, then the child catalog of that name. moto does not have GetCatalog and
# answers with an error that is not Glue's: it is asked once, without the retries of the SDK.
statement ok
CALL truncate_duckdb_logs();

statement error
USE cold_datalake.npmr_no_such_schema;
----
<REGEX>:.*(does not exist|No catalog \+ schema named).*

query II
SELECT glue_calls('GetDatabase'), glue_calls('GetCatalog');
----
1	1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING'
AND message LIKE 'Glue catalog "cold_datalake" no longer looks for child catalogs, its endpoint does not answer GetCatalog%';
----
1

# 4. and not again for this attached catalog
statement ok
CALL truncate_duckdb_logs();

statement error
USE cold_datalake.npmr_another_schema;
----
<REGEX>:.*(does not exist|No catalog \+ schema named).*

query II
SELECT glue_calls('GetDatabase'), glue_calls('GetCatalog');
----
1	0

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%GetCatalog%';
----
0
