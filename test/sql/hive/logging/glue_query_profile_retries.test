# name: test/sql/hive/logging/glue_query_profile_retries.test
# description: The query profile counts the Glue requests the SDK sent again
# group: [logging]

require httpfs

require glue

require json

require-env GLUE_CATALOG_ID

require-env GLUE_FAULT_ENDPOINT

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_throttled_gpr;

statement ok
DROP TABLE IF EXISTS my_datalake.fault_throttled_gpr.t;

statement ok
CREATE TABLE my_datalake.fault_throttled_gpr.t AS SELECT 42 AS id;

# every request on a fault_throttled* database is refused once with ThrottlingException, then let through
statement ok
attach '{GLUE_CATALOG_ID}' as throttled_dl (
    TYPE glue,
    ENDPOINT '{GLUE_FAULT_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/glue_throttled_profile.json';

query I
SELECT id FROM throttled_dl.fault_throttled_gpr.t;
----
42

statement ok
SET enable_profiling = 'no_output';

# the one throttled GetTable is one retry, and two requests: the refused attempt and the retry. The table has no
# partitions, so nothing else asks Glue.
query III
SELECT (j::VARIANT).glue.retries::UBIGINT, (j::VARIANT).glue.requests::UBIGINT, (j::VARIANT).glue.request_time::DOUBLE > 0
FROM read_json_objects('{TEST_DIR}/glue_throttled_profile.json') t(j);
----
1	2	true

# the same through the AWS SDK's own HTTP client
statement ok
SET glue_network_calls_via_duckdb = false;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/glue_throttled_sdk_profile.json';

query I
SELECT id FROM throttled_dl.fault_throttled_gpr.t;
----
42

statement ok
SET enable_profiling = 'no_output';

query III
SELECT (j::VARIANT).glue.retries::UBIGINT, (j::VARIANT).glue.requests::UBIGINT, (j::VARIANT).glue.request_time::DOUBLE > 0
FROM read_json_objects('{TEST_DIR}/glue_throttled_sdk_profile.json') t(j);
----
1	2	true

statement ok
RESET glue_network_calls_via_duckdb;

statement ok
DETACH throttled_dl;

statement ok
DROP TABLE my_datalake.fault_throttled_gpr.t;

statement ok
DROP SCHEMA my_datalake.fault_throttled_gpr;
