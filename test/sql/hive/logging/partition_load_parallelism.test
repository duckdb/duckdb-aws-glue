# name: test/sql/hive/logging/partition_load_parallelism.test
# description: glue_partition_load_parallelism loads the partitions of a query's partitioned tables at once, at the query's first estimate, sending the requests the scans would send one table after another, and falls back to one table at a time when a load fails
# group: [logging]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.plp_a;

statement ok
DROP TABLE IF EXISTS my_datalake.default.plp_b;

statement ok
DROP TABLE IF EXISTS my_datalake.default.plp_c;

statement ok
CREATE TABLE my_datalake.default.plp_a (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plp_a VALUES (1, 'x'), (2, 'y'), (3, 'z');

statement ok
CREATE TABLE my_datalake.default.plp_b (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plp_b VALUES (1, 'x'), (2, 'y'), (3, 'z');

statement ok
CREATE TABLE my_datalake.default.plp_c (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plp_c VALUES (1, 'x'), (2, 'y'), (3, 'z');

statement ok
attach '{GLUE_CATALOG_ID}' as plp (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
CALL enable_logging(['HTTP', 'GlueScan'], storage := 'memory');

# ---- the same requests, sent together ----------------------------------------------------------------------------

# By default the three tables load at once when the query first estimates a scan, before any scan is sampled, and
# each scan then finds its table loaded
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query IIII
SELECT count(*) FILTER (event = 'parallel_load'), max(partitions) FILTER (event = 'parallel_load'),
       max(detail) FILTER (event = 'parallel_load'), count(*) FILTER (event = 'partitions')
FROM duckdb_logs_parsed('GlueScan');
----
1	9	loaded 3 of 3 tables	3

query I
SELECT max(timestamp) FILTER (event = 'parallel_load') < min(timestamp) FILTER (event = 'sample')
FROM duckdb_logs_parsed('GlueScan');
----
true

query I
SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions';
----
3

# At 1, each scan loads its table as it is estimated: the same requests, one table after another
statement ok
SET glue_partition_load_parallelism = 1;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query II
SELECT count(*) FILTER (event = 'parallel_load'), count(*) FILTER (event = 'partitions')
FROM duckdb_logs_parsed('GlueScan');
----
0	3

query I
SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions';
----
3

statement ok
RESET glue_partition_load_parallelism;

# A table scanned twice is loaded once: a query of one table has nothing to load together
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a x JOIN plp.default.plp_a y USING (id);
----
3

query II
SELECT count(*) FILTER (event = 'parallel_load'),
       (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions')
FROM duckdb_logs_parsed('GlueScan');
----
0	1

# A scan the optimizer removes before the first estimate is not loaded for, at 8 as at 1
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (
    SELECT id FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id)
    UNION ALL
    SELECT id FROM plp.default.plp_c WHERE 1 = 0);
----
3

query II
SELECT max(detail) FILTER (event = 'parallel_load'),
       (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions')
FROM duckdb_logs_parsed('GlueScan');
----
loaded 2 of 2 tables	2

statement ok
SET glue_partition_load_parallelism = 1;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (
    SELECT id FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id)
    UNION ALL
    SELECT id FROM plp.default.plp_c WHERE 1 = 0);
----
3

query I
SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions';
----
2

statement ok
RESET glue_partition_load_parallelism;

# ---- a failed load falls back to one table at a time ------------------------------------------------------------

# The load of several tables fails: each scan loads its table as at 1, and the answer is the same
statement ok
SET glue_debug_fail_partition_loads = 'InternalServiceException';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query II
SELECT max(detail) FILTER (event = 'parallel_load') LIKE
           'loaded 0 of 3 tables; the others load one at a time, as each scan needs them: %injected by glue_debug_fail_partition_loads (InternalServiceException)',
       count(*) FILTER (event = 'partitions')
FROM duckdb_logs_parsed('GlueScan');
----
true	3

query I
SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions';
----
3

# Not throttling: the next query loads its tables at once again
statement ok
RESET glue_debug_fail_partition_loads;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query I
SELECT max(detail) FILTER (event = 'parallel_load') FROM duckdb_logs_parsed('GlueScan');
----
loaded 3 of 3 tables

# Throttled: the query falls back as above, and loads against the catalog run one at a time for the cool-down
statement ok
SET glue_debug_fail_partition_loads = 'ThrottlingException';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query I
SELECT max(detail) FILTER (event = 'parallel_load') LIKE
           '%; Glue throttled the requests, so loads against this catalog run one at a time for 300 s'
FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
RESET glue_debug_fail_partition_loads;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query II
SELECT max(detail) FILTER (event = 'parallel_load'),
       (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions')
FROM duckdb_logs_parsed('GlueScan');
----
paused for 300 s after Glue throttled a parallel load: 3 tables load one at a time	3

# Once the cool-down has passed, tables load together again
statement ok
SET glue_partition_load_cooldown = 0;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query I
SELECT max(detail) FILTER (event = 'parallel_load') FROM duckdb_logs_parsed('GlueScan');
----
loaded 3 of 3 tables

statement ok
RESET glue_partition_load_cooldown;

# ---- the caches --------------------------------------------------------------------------------------------------

# Under the connection's metadata cache a later statement finds every table loaded, and loads nothing
statement ok
SET glue_metadata_cache_scope = 'connection';

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM plp.default.plp_a a JOIN plp.default.plp_b b USING (id) JOIN plp.default.plp_c c USING (id);
----
3

query II
SELECT count(*) FILTER (event = 'parallel_load'),
       (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions')
FROM duckdb_logs_parsed('GlueScan');
----
0	0

statement ok
RESET glue_metadata_cache_scope;

statement ok
CALL disable_logging();

statement ok
DROP TABLE my_datalake.default.plp_a;

statement ok
DROP TABLE my_datalake.default.plp_b;

statement ok
DROP TABLE my_datalake.default.plp_c;
