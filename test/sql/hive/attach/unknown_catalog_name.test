# name: test/sql/hive/attach/unknown_catalog_name.test
# description: a three-part name whose catalog is not attached does not resolve to a database of the default Glue catalog
# group: [attach]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_TEST_DB

require-env GLUE_TEST_DB_SQL

statement ok
ATTACH '{GLUE_CATALOG_ID}' AS my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}',
    DEFAULT_SCHEMA '{GLUE_TEST_DB}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.{GLUE_TEST_DB}.ucn_orders;

statement ok
CREATE TABLE my_datalake.{GLUE_TEST_DB}.ucn_orders (id INTEGER);

statement ok
INSERT INTO my_datalake.{GLUE_TEST_DB}.ucn_orders VALUES (1);

# the Glue catalog is the default: DuckDB reads "x".db.t with an unknown catalog x as the schema path [x, db] in it,
# which used to resolve to database db (and read the table). Glue has no nested schemas, so DuckDB refuses the path.
statement ok
USE my_datalake.{GLUE_TEST_DB};

statement error
SELECT id FROM "999999999999"."{GLUE_TEST_DB}".ucn_orders;
----
Catalog "my_datalake" does not support nested schemas: "999999999999".{GLUE_TEST_DB_SQL}

statement error
SELECT id FROM not_attached."{GLUE_TEST_DB}".ucn_orders;
----
Catalog "my_datalake" does not support nested schemas: not_attached.{GLUE_TEST_DB_SQL}

# the names that do resolve still do
query I
SELECT id FROM my_datalake."{GLUE_TEST_DB}".ucn_orders;
----
1

query I
SELECT id FROM "{GLUE_TEST_DB}".ucn_orders;
----
1

query I
SELECT id FROM ucn_orders;
----
1

statement ok
USE memory;

statement ok
DROP TABLE my_datalake.{GLUE_TEST_DB}.ucn_orders;
