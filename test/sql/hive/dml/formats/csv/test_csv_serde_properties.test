# name: test/sql/hive/dml/formats/csv/test_csv_serde_properties.test
# description: text tables are read and written the way their SerDe properties say: delimiters, NULL format, headers
# group: [csv]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# the fixture tables (scripts/docker-compose.yml) share their location between runs: every run rewrites the file

#---------------------------------------------------------------------------
# LazySimpleSerDe without SerDe properties ("ROW FORMAT DELIMITED"): fields are separated by '\001' and NULL is \N;
# an empty field of a string column is an empty string
#---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM (VALUES
    ('1' || chr(1) || 'a' || chr(1) || '1.5'),
    ('2' || chr(1) || '\N' || chr(1) || '\N'),
    ('3' || chr(1) || '' || chr(1) || '4.5')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_default/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IIII
SELECT id, name, name IS NULL, amount FROM my_datalake.default.fixture_text_default ORDER BY id;
----
1	a	false	1.5
2	NULL	true	NULL
3	(empty)	false	4.5

query II
SELECT id, name FROM my_datalake.default.fixture_text_default WHERE amount > 1 ORDER BY id;
----
1	a
3	(empty)

# as in Hive, a value that does not parse as its column type is NULL, an empty numeric field too; a line with fewer
# fields than columns leaves the trailing columns NULL and fields beyond the last column are ignored
statement ok
COPY (SELECT * FROM (VALUES
    ('x' || chr(1) || 'bad' || chr(1) || ''),
    ('4'),
    ('5' || chr(1) || 'e' || chr(1) || '6.5' || chr(1) || 'extra')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_default/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, name, amount FROM my_datalake.default.fixture_text_default ORDER BY id NULLS FIRST;
----
NULL	bad	NULL
4	NULL	NULL
5	e	6.5

# filters compare the converted values, not the text: 10 > 5 although '10' < '5'
statement ok
COPY (SELECT * FROM (VALUES
    ('10' || chr(1) || 'a' || chr(1) || '1'),
    ('5' || chr(1) || 'b' || chr(1) || 'z')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_default/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query II
SELECT id, amount FROM my_datalake.default.fixture_text_default WHERE id > 6;
----
10	1.0

query I
SELECT id FROM my_datalake.default.fixture_text_default WHERE amount IS NULL;
----
5

#---------------------------------------------------------------------------
# a delimiter given as a number is a byte code: serialization.format '9' (without field.delim) is a tab
#---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM (VALUES
    ('1' || chr(9) || 'a,b' || chr(9) || '2.5'),
    ('2' || chr(9) || 'c' || chr(9) || '\N')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_numeric_delim/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, name, amount FROM my_datalake.default.fixture_text_numeric_delim ORDER BY id;
----
1	a,b	2.5
2	c	NULL

#---------------------------------------------------------------------------
# serialization.null.format 'NA': 'NA' is NULL, \N is a plain string
#---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM (VALUES
    ('1,NA,NA'),
    ('2,\N,3.5')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_null_format/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IIII
SELECT id, name, name IS NULL, amount FROM my_datalake.default.fixture_text_null_format ORDER BY id;
----
1	NULL	true	NULL
2	\N	false	3.5

#---------------------------------------------------------------------------
# OpenCSVSerde without SerDe properties: ',' separated, '"' quoted; a value that does not parse fails the query
#---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM (VALUES
    ('1,"a,b",1.5'),
    ('2,c,2')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, name, amount FROM my_datalake.default.fixture_text_opencsv ORDER BY id;
----
1	a,b	1.5
2	c	2.0

statement ok
COPY (SELECT * FROM (VALUES
    ('1,a,oops')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# a value that does not parse fails the query unless use.null.for.invalid.data is true
statement error
SELECT amount FROM my_datalake.default.fixture_text_opencsv;
----
<REGEX>:.*Could not convert string 'oops' to DOUBLE.*

# use.null.for.invalid.data as a SerDe property
statement ok
COPY (SELECT * FROM (VALUES
    ('1,a,oops')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv_null_invalid/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, name, amount FROM my_datalake.default.fixture_text_opencsv_null_invalid;
----
1	a	NULL

# as OpenCSVSerde does: missing trailing fields are NULL and fields beyond the last column are ignored
statement ok
COPY (SELECT * FROM (VALUES
    ('1,"a,b"'),
    ('2,c,2.5,"x,y",extra')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, name, amount FROM my_datalake.default.fixture_text_opencsv ORDER BY id;
----
1	a,b	NULL
2	c	2.5

#---------------------------------------------------------------------------
# skip.header.line.count: every file starts with that many lines, which are skipped
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_two_headers;

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_footer;

statement ok
CREATE TABLE my_datalake.default.formats_csv_two_headers (id INTEGER, name VARCHAR) WITH (format = 'csv', 'skip.header.line.count' = '2');

statement ok
COPY (SELECT * FROM (VALUES ('generated by a job'), ('id,name'), ('1,a'), ('2,b')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_two_headers/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT * FROM (VALUES ('generated by a job'), ('id,name'), ('3,c')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_two_headers/more.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query II
SELECT id, name FROM my_datalake.default.formats_csv_two_headers ORDER BY id;
----
1	a
2	b
3	c

# DuckDB writes at most one header line
statement error
INSERT INTO my_datalake.default.formats_csv_two_headers VALUES (4, 'd');
----
its files start with 2 header lines

#---------------------------------------------------------------------------
# skip.footer.line.count: reading and writing are refused rather than returning the footer lines as rows
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_csv_footer (id INTEGER, name VARCHAR) WITH (format = 'csv', 'skip.footer.line.count' = '1');

statement error
SELECT * FROM my_datalake.default.formats_csv_footer;
----
has 'skip.footer.line.count' set, which DuckDB can not read or write

statement error
INSERT INTO my_datalake.default.formats_csv_footer VALUES (1, 'a');
----
has 'skip.footer.line.count' set, which DuckDB can not read or write

#---------------------------------------------------------------------------
# tables this extension writes; a table property overrides the SerDe property of the same name
#---------------------------------------------------------------------------
foreach table formats_csv_byte_delim formats_csv_empty_null formats_csv_backslash_n formats_csv_opencsv formats_csv_opencsv_bool formats_csv_opencsv_escape formats_csv_opencsv_escape_same formats_csv_opencsv_backslash formats_csv_opencsv_backslash_text formats_csv_opencsv_nul formats_csv_opencsv_nul_plain formats_csv_wide_escape formats_csv_wide_plain formats_csv_header_ctas formats_csv_bad formats_csv_signed_delim formats_csv_wide formats_csv_nested formats_csv_zeros

statement ok
DROP TABLE IF EXISTS my_datalake.default.{table};

endloop

# field.delim '1' is the byte \001
statement ok
CREATE TABLE my_datalake.default.formats_csv_byte_delim (id INTEGER, name VARCHAR) WITH (format = 'csv', 'field.delim' = '1');

statement ok
INSERT INTO my_datalake.default.formats_csv_byte_delim VALUES (1, 'a,b'), (2, NULL);

query I
SELECT replace(replace(content, chr(1), '<01>'), chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_byte_delim/*.csv');
----
1<01>a,b<nl>2<01>\N<nl>

query III
SELECT id, name, name IS NULL FROM my_datalake.default.formats_csv_byte_delim ORDER BY id;
----
1	a,b	false
2	NULL	true

# serialization.null.format '': NULL is an empty field. LazySimpleSerDe does not quote, so an empty string would be
# an empty field too and read back as NULL: it can not be written
statement ok
CREATE TABLE my_datalake.default.formats_csv_empty_null (id INTEGER, name VARCHAR, amount DOUBLE) WITH (format = 'csv', 'serialization.null.format' = '');

statement ok
INSERT INTO my_datalake.default.formats_csv_empty_null VALUES (1, NULL, NULL), (2, 'b', 2.5);

statement error
INSERT INTO my_datalake.default.formats_csv_empty_null VALUES (3, '', 3.5);
----
or is the table's NULL string ''

query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_empty_null/*.csv');
----
1,,<nl>2,b,2.5<nl>

query IIII
SELECT id, name, name IS NULL, amount FROM my_datalake.default.formats_csv_empty_null ORDER BY id;
----
1	NULL	true	NULL
2	b	false	2.5

# a string that is the NULL string would read back as NULL: it can not be written
statement ok
CREATE TABLE my_datalake.default.formats_csv_backslash_n (id INTEGER, name VARCHAR) WITH (format = 'csv');

statement error
INSERT INTO my_datalake.default.formats_csv_backslash_n VALUES (1, '\N'), (2, NULL);
----
or is the table's NULL string '\N'

statement ok
INSERT INTO my_datalake.default.formats_csv_backslash_n VALUES (1, 'x\Ny'), (2, NULL);

query III
SELECT id, name, name IS NULL FROM my_datalake.default.formats_csv_backslash_n ORDER BY id;
----
1	x\Ny	false
2	NULL	true

# OpenCSVSerde has no NULL: NULL is written as an empty field, which reads back as an empty string, as in Hive
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv (id INTEGER, name VARCHAR) WITH (format = 'csv', quote = '"');

statement ok
INSERT INTO my_datalake.default.formats_csv_opencsv VALUES (1, 'a,b'), (2, NULL), (3, '');

query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv/*.csv');
----
"1","a,b"<nl>"2",<nl>"3",""<nl>

query III
SELECT id, name, name IS NULL FROM my_datalake.default.formats_csv_opencsv ORDER BY id;
----
1	a,b	false
2	(empty)	false
3	(empty)	false

statement ok
COPY (SELECT '"x","d"' AS line) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv/invalid.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT id FROM my_datalake.default.formats_csv_opencsv WHERE name = 'd';
----
<REGEX>:.*Could not convert string 'x' to (INT32|INTEGER).*

# with use.null.for.invalid.data, a value that does not parse as its column type is NULL
statement ok
ALTER TABLE my_datalake.default.formats_csv_opencsv SET ('use.null.for.invalid.data' = 'true');

query II
SELECT id, name FROM my_datalake.default.formats_csv_opencsv ORDER BY id NULLS LAST;
----
1	a,b
2	(empty)
3	(empty)
NULL	d

statement ok
ALTER TABLE my_datalake.default.formats_csv_opencsv SET ('use.null.for.invalid.data' = 'false');

statement error
SELECT id FROM my_datalake.default.formats_csv_opencsv WHERE name = 'd';
----
<REGEX>:.*Could not convert string 'x' to (INT32|INTEGER).*

# an OpenCSVSerde boolean is true when the field is 'true' in any case and false otherwise; a missing field is NULL
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_bool (id INTEGER, flag BOOLEAN) WITH (format = 'csv', quote = '"');

statement ok
COPY (SELECT * FROM (VALUES
    ('"1","true"'),
    ('"2","TRUE"'),
    ('"3","false"'),
    ('"4",""'),
    ('"5","True."'),
    ('"6","abc"'),
    ('"7","1"'),
    ('"8","yes"'),
    ('"9"')
) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv_bool/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query II
SELECT id, flag FROM my_datalake.default.formats_csv_opencsv_bool ORDER BY id;
----
1	true
2	true
3	false
4	false
5	false
6	false
7	false
8	false
9	NULL

# use.null.for.invalid.data does not change it: no boolean field is invalid
statement ok
ALTER TABLE my_datalake.default.formats_csv_opencsv_bool SET ('use.null.for.invalid.data' = 'true');

query II
SELECT id, flag FROM my_datalake.default.formats_csv_opencsv_bool WHERE id IN (4, 5) ORDER BY id;
----
4	false
5	false

# OpenCSVSerde without escapeChar reads with a '\' escape, as with escapeChar '\', each line split as OpenCSVSerde splits
# it: an escape is dropped, and the escape or quote character after it is kept, in a quoted field or not and before a
# field is converted to its column's type; outside quotes it does not escape the separator
statement ok
COPY (SELECT * FROM (VALUES
    ('1,\'),
    ('2,a\x'),
    ('3,a\\b'),
    ('4,"a\\b"'),
    ('5,"a\x"'),
    ('6,a\"b'),
    ('7,"x"'),
    ('8,y,1\2'),
    ('9,a\,7'),
    ('10,"a\"b",7'),
    ('11,\\x,8')
) t(line)) TO '{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv_escape/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, val, n FROM my_datalake.default.fixture_text_opencsv_escape ORDER BY id;
----
1	(empty)	NULL
2	ax	NULL
3	a\b	NULL
4	a\b	NULL
5	ax	NULL
6	a"b	NULL
7	x	NULL
8	y	12
9	a	7
10	a"b	7
11	x	8

# the same file read through a table with escapeChar '\' gives the same rows
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_escape_same (id INTEGER, val VARCHAR, n INTEGER) WITH (format = 'csv', quote = '"', escape = '\', location = '{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv_escape');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM my_datalake.default.fixture_text_opencsv_escape EXCEPT ALL SELECT * FROM my_datalake.default.formats_csv_opencsv_escape_same)),
       (SELECT count(*) FROM (SELECT * FROM my_datalake.default.formats_csv_opencsv_escape_same EXCEPT ALL SELECT * FROM my_datalake.default.fixture_text_opencsv_escape));
----
0	0

statement ok
DROP TABLE my_datalake.default.formats_csv_opencsv_escape_same;

# the scan's reader call splits the lines the same way
query II
EXPLAIN (SQL) SELECT id, val FROM my_datalake.default.fixture_text_opencsv_escape;
----
sql	<REGEX>:.*hive_opencsv_field\(\s*concat_ws\(chr\(0\), id, val, n\),\s*CAST\(1 AS BIGINT\),\s*',',\s*'"',\s*'\\'\) AS val.*\(delim = CAST\('' AS VARCHAR\)\).*

# a written backslash is doubled, so that it reads back as one; the fixture's files are kept between runs, so this run's
# rows are told apart by their tag
statement ok
INSERT INTO my_datalake.default.fixture_text_opencsv_escape_write VALUES ('{TEST_DIR}', 1, 'a\b'), ('{TEST_DIR}', 2, '\'), ('{TEST_DIR}', 3, 'x\"y'), ('{TEST_DIR}', 4, '\\');

query I
SELECT replace(line, '{TEST_DIR}', 'tag') FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text('{DEFAULT_S3_LOCATION}/fixture/fixture_text_opencsv_escape_write/*')) WHERE contains(line, '{TEST_DIR}') ORDER BY 1;
----
"tag","1","a\\b"
"tag","2","\\"
"tag","3","x\\""y"
"tag","4","\\\\"

query II
SELECT id, val FROM my_datalake.default.fixture_text_opencsv_escape_write WHERE tag = '{TEST_DIR}' ORDER BY id;
----
1	a\b
2	\
3	x\"y
4	\\

# a table this extension creates records escapeChar '"', which is read as it is: a '\' is an ordinary character, and it
# is written as it is
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_escape (id INTEGER, val VARCHAR) WITH (format = 'csv', quote = '"');

statement ok
INSERT INTO my_datalake.default.formats_csv_opencsv_escape VALUES (1, 'C:\dir'), (2, 'a\\b'), (3, '\');

query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv_escape/*.csv');
----
"1","C:\dir"<nl>"2","a\\b"<nl>"3","\"<nl>

query II
SELECT id, val FROM my_datalake.default.formats_csv_opencsv_escape ORDER BY id;
----
1	C:\dir
2	a\\b
3	\

# escapeChar '\': each line is split as OpenCSVSerde splits it, where read_csv would apply the '\' before a separator or
# a line break and join the next field or line
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_backslash (id INTEGER, val VARCHAR, extra VARCHAR) WITH (format = 'csv', quote = '"', escape = '\');

query III
SELECT serde_parameters['separatorChar'], serde_parameters['quoteChar'], serde_parameters['escapeChar']
FROM glue_get_table_response('my_datalake.default.formats_csv_opencsv_backslash');
----
,	"	\

statement ok
COPY (SELECT * FROM (VALUES
    ('1,\'),
    ('2,b'),
    ('3,c'),
    ('4,C:\dir\'),
    ('5,a\,b'),
    ('6,a\x'),
    ('7,a\\b'),
    ('8,"a\"b"'),
    ('9,"a\\b"'),
    ('10,"a""b"'),
    ('11,ab"cd"ef'),
    ('12,"open')
) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv_backslash/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, val, extra FROM my_datalake.default.formats_csv_opencsv_backslash ORDER BY id;
----
1	(empty)	NULL
2	b	NULL
3	c	NULL
4	C:dir	NULL
5	a	b
6	ax	NULL
7	a\b	NULL
8	a"b	NULL
9	a\b	NULL
10	a"b	NULL
11	ab"cd"ef	NULL
12	NULL	NULL

# a column read without the first one, and every row counted
query I
SELECT val FROM my_datalake.default.formats_csv_opencsv_backslash WHERE extra = 'b';
----
a

query I
SELECT count(*) FROM my_datalake.default.formats_csv_opencsv_backslash;
----
12

# the scan's reader call splits the lines the same way
query II
EXPLAIN (SQL) SELECT val FROM my_datalake.default.formats_csv_opencsv_backslash;
----
sql	<REGEX>:.*hive_opencsv_field\(\s*concat_ws\(chr\(0\), id, val, extra\),\s*CAST\(1 AS BIGINT\),\s*',',\s*'"',\s*'\\'\) AS val.*\(delim = CAST\('' AS VARCHAR\)\).*

# hive_opencsv_field splits a line as the scan does, and a line has no field beyond its last
query IIII
SELECT hive_opencsv_field('a,"b\"c",d', 1, ',', '"', '\'), hive_opencsv_field('a,b', 2, ',', '"', '\') IS NULL,
       hive_opencsv_field('a,b', 9223372036854775807, ',', '"', '\') IS NULL, hive_opencsv_field('', 0, ',', '"', '\') IS NULL;
----
b"c	true	true	true

statement error
SELECT hive_opencsv_field('a,b', -1, ',', '"', '\');
----
the field index must be a constant from 0

statement error
SELECT hive_opencsv_field('a,b', 0, ',,', '"', '\');
----
the separator must be one character

query I
SELECT hive_opencsv_field('a¦"b¦c"¦d', 1, '¦', '"', '\');
----
b¦c

# values written to it read back unchanged
statement ok
INSERT INTO my_datalake.default.formats_csv_opencsv_backslash VALUES (20, 'q"x', 'C:\dir\'), (21, 'a,b', '\');

query III
SELECT id, val, extra FROM my_datalake.default.formats_csv_opencsv_backslash WHERE id >= 20 ORDER BY id;
----
20	q"x	C:\dir\
21	a,b	\

# a line break inside quotes ends the line, as OpenCSVSerde reads it: the second line opens a quote it does not close,
# so its fields are NULL
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_backslash_text (id VARCHAR, val VARCHAR) WITH (format = 'csv', quote = '"', escape = '\');

statement ok
COPY (SELECT '1,"x' || chr(10) || 'y",2' AS line) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv_backslash_text/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query II
SELECT id, val FROM my_datalake.default.formats_csv_opencsv_backslash_text ORDER BY id;
----
1	NULL
NULL	NULL

# a NUL byte is data, as OpenCSVSerde reads it, with escapeChar '\' and without escapeChar
statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_nul (id INTEGER, s VARCHAR, tail VARCHAR) WITH (format = 'csv', quote = '"', escape = '\');

statement ok
INSERT INTO my_datalake.default.formats_csv_opencsv_nul VALUES (1, 'a' || chr(0) || 'b', 'tail'), (2, chr(0) || chr(0), ''), (3, chr(0), NULL);

query III
SELECT id, s = ('a' || chr(0) || 'b'), tail = 'tail' FROM my_datalake.default.formats_csv_opencsv_nul WHERE id = 1;
----
1	true	true

query III
SELECT id, replace(s, chr(0), '<0>'), tail FROM my_datalake.default.formats_csv_opencsv_nul ORDER BY id;
----
1	a<0>b	tail
2	<0><0>	(empty)
3	<0>	(empty)

statement ok
CREATE TABLE my_datalake.default.formats_csv_opencsv_nul_plain (id INTEGER, s VARCHAR, tail VARCHAR) WITH (format = 'csv', quote = '"', location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_opencsv_nul');

statement ok
ALTER TABLE my_datalake.default.formats_csv_opencsv_nul_plain SET ('escapeChar' = '');

query III
SELECT id, replace(s, chr(0), '<0>'), tail FROM my_datalake.default.formats_csv_opencsv_nul_plain ORDER BY id;
----
1	a<0>b	tail
2	<0><0>	(empty)
3	<0>	(empty)

# a separator of more than one byte can be read, but not written
statement ok
CREATE TABLE my_datalake.default.formats_csv_wide (id INTEGER, name VARCHAR) WITH (format = 'csv', quote = '"');

# a table property overrides the SerDe property of the same name
statement ok
ALTER TABLE my_datalake.default.formats_csv_wide SET ('separatorChar' = '¦');

statement ok
COPY (SELECT '1¦x' AS line) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_wide/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query II
SELECT id, name FROM my_datalake.default.formats_csv_wide;
----
1	x

statement error
INSERT INTO my_datalake.default.formats_csv_wide VALUES (2, 'y');
----
DuckDB writes single-byte field delimiters only

statement ok
DROP TABLE my_datalake.default.formats_csv_wide;

# with a separator of more than one byte the lines are split as OpenCSVSerde splits them too, with escapeChar '\' as
# without escapeChar
statement ok
CREATE TABLE my_datalake.default.formats_csv_wide_escape (id VARCHAR, val VARCHAR, n VARCHAR) WITH (format = 'csv', quote = '"', escape = '\');

statement ok
ALTER TABLE my_datalake.default.formats_csv_wide_escape SET ('separatorChar' = '¦');

statement ok
COPY (SELECT * FROM (VALUES ('1¦"a\"b"¦x'), ('2¦\\x¦y'), ('3¦a\x¦z'), ('4¦a\¦b'), ('5¦ab"c"d¦w'), ('6¦"p¦q"¦v')) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_wide_escape/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, val, n FROM my_datalake.default.formats_csv_wide_escape ORDER BY id;
----
1	a"b	x
2	x	y
3	ax	z
4	a	b
5	ab"c"d	w
6	p¦q	v

statement ok
CREATE TABLE my_datalake.default.formats_csv_wide_plain (id VARCHAR, val VARCHAR, n VARCHAR) WITH (format = 'csv', quote = '"', location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_wide_escape');

statement ok
ALTER TABLE my_datalake.default.formats_csv_wide_plain SET ('separatorChar' = '¦', 'escapeChar' = '');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM my_datalake.default.formats_csv_wide_plain EXCEPT ALL SELECT * FROM my_datalake.default.formats_csv_wide_escape)),
       (SELECT count(*) FROM (SELECT * FROM my_datalake.default.formats_csv_wide_escape EXCEPT ALL SELECT * FROM my_datalake.default.formats_csv_wide_plain));
----
0	0

statement ok
DROP TABLE my_datalake.default.formats_csv_wide_plain;

statement ok
DROP TABLE my_datalake.default.formats_csv_wide_escape;

# nested columns are stored with collection delimiters, which DuckDB can not read or write
statement ok
CREATE TABLE my_datalake.default.formats_csv_nested (id INTEGER, tags VARCHAR[]) WITH (format = 'csv');

statement error
SELECT * FROM my_datalake.default.formats_csv_nested;
----
has the nested column 'tags' (array<string>)

statement error
INSERT INTO my_datalake.default.formats_csv_nested VALUES (1, ['a']);
----
has the nested column 'tags' (array<string>)

statement ok
DROP TABLE my_datalake.default.formats_csv_nested;

# leading zeros do not count towards a line count's digits
statement ok
CREATE TABLE my_datalake.default.formats_csv_zeros (id INTEGER) WITH (format = 'csv', 'skip.header.line.count' = '0000000000000000000001');

statement ok
COPY (SELECT * FROM (VALUES ('header'), ('7')) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_zeros/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT id FROM my_datalake.default.formats_csv_zeros;
----
7

statement ok
DROP TABLE my_datalake.default.formats_csv_zeros;

# INSERT into a table with a header line: the file starts with the column names
statement ok
CREATE TABLE my_datalake.default.formats_csv_header_ctas (id INTEGER, name VARCHAR) WITH (format = 'csv', 'skip.header.line.count' = '1');

statement ok
INSERT INTO my_datalake.default.formats_csv_header_ctas VALUES (1, 'a');

query II
SELECT id, name FROM my_datalake.default.formats_csv_header_ctas;
----
1	a

# properties DuckDB can not read with are refused
statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'field.delim' = '-1');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
only ASCII delimiters other than NUL and line breaks are supported

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'field.delim' = 'é');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
only ASCII delimiters other than NUL and line breaks are supported

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'field.delim' = '0');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
only ASCII delimiters other than NUL and line breaks are supported

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'escape.delim' = ',');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
has its field delimiter as 'escape.delim', which DuckDB can not read or write

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'escape.delim' = '\',
    'serialization.escape.crlf' = 'true');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
has 'serialization.escape.crlf' set, which DuckDB can not read or write

statement error
INSERT INTO my_datalake.default.formats_csv_bad VALUES (1);
----
has 'serialization.escape.crlf' set, which DuckDB can not read or write

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'skip.header.line.count' = '99999999999999999999');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
has an invalid 'skip.header.line.count'

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

# more properties DuckDB can not read with; each is refused with the table named
foreach property 'field.delim'='10' 'field.delim'='N' 'serialization.encoding'='GBK' 'serialization.last.column.takes.rest'='true'

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER, name VARCHAR) WITH (format = 'csv', {property});

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
Hive table 'default.formats_csv_bad'

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

endloop

# OpenCSVSerde refuses a separator that is the quote character
statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER, name VARCHAR) WITH (format = 'csv', quote = '"', 'separatorChar' = '"');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
has the same separatorChar and quoteChar

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER, name VARCHAR) WITH (format = 'csv', quote = '"', 'quoteChar' = 'é');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
has a quoteChar or escapeChar of more than one byte

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

# SerDe property keys are case-sensitive, as in Hive: 'Field.Delim' is not the delimiter
statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER, name VARCHAR) WITH (format = 'csv', 'Field.Delim' = '|');

statement ok
INSERT INTO my_datalake.default.formats_csv_bad VALUES (1, 'a|b');

query II
SELECT id, name FROM my_datalake.default.formats_csv_bad;
----
1	a|b

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

# a line count must be a non-negative number
foreach count -1 abc

statement ok
CREATE TABLE my_datalake.default.formats_csv_bad (id INTEGER) WITH (format = 'csv', 'skip.header.line.count' = '{count}');

statement error
SELECT * FROM my_datalake.default.formats_csv_bad;
----
has an invalid 'skip.header.line.count'

statement ok
DROP TABLE my_datalake.default.formats_csv_bad;

endloop

# a byte code may carry a sign: '+9' is a tab
statement ok
CREATE TABLE my_datalake.default.formats_csv_signed_delim (id INTEGER, name VARCHAR) WITH (format = 'csv', 'field.delim' = '+9');

statement ok
INSERT INTO my_datalake.default.formats_csv_signed_delim VALUES (1, 'a');

query I
SELECT replace(replace(content, chr(9), '<tab>'), chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_signed_delim/*.csv');
----
1<tab>a<nl>

statement ok
DROP TABLE my_datalake.default.formats_csv_signed_delim;

# Hive skips header and footer lines in JSON tables too; DuckDB's JSON reader and writer can not, so both are refused
foreach property skip.header.line.count skip.footer.line.count

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_json_lines;

statement ok
CREATE TABLE my_datalake.default.formats_json_lines (id INTEGER) WITH (format = 'json', '{property}' = '1');

statement error
SELECT * FROM my_datalake.default.formats_json_lines;
----
which DuckDB can not read or write

statement error
INSERT INTO my_datalake.default.formats_json_lines VALUES (1);
----
which DuckDB can not read or write

statement ok
DROP TABLE my_datalake.default.formats_json_lines;

endloop

foreach table formats_csv_two_headers formats_csv_footer formats_csv_byte_delim formats_csv_empty_null formats_csv_backslash_n formats_csv_opencsv formats_csv_opencsv_bool formats_csv_opencsv_escape formats_csv_opencsv_backslash formats_csv_opencsv_backslash_text formats_csv_opencsv_nul formats_csv_opencsv_nul_plain formats_csv_header_ctas

statement ok
DROP TABLE my_datalake.default.{table};

endloop

#---------------------------------------------------------------------------
# hive_scan: an empty field is NULL, as in read_csv, unless nullstr says otherwise; quote does not change that
#---------------------------------------------------------------------------
statement ok
DETACH my_datalake;

query IIII
SELECT id, name, name IS NULL, amount FROM hive_scan('{DEFAULT_S3_LOCATION}/fixture/fixture_text_null_format', format := 'csv',
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'VARCHAR'})
ORDER BY id;
----
1	NA	false	NA
2	\N	false	3.5

query IIII
SELECT id, name, name IS NULL, amount FROM hive_scan('{DEFAULT_S3_LOCATION}/fixture/fixture_text_null_format', format := 'csv', quote := '"',
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'VARCHAR'})
ORDER BY id;
----
1	NA	false	NA
2	\N	false	3.5

query IIII
SELECT id, name, name IS NULL, amount FROM hive_scan('{DEFAULT_S3_LOCATION}/fixture/fixture_text_null_format', format := 'csv', nullstr := 'NA',
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'})
ORDER BY id;
----
1	NULL	true	NULL
2	\N	false	3.5
