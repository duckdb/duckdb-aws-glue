# name: test/sql/hive/dml/formats/csv/test_csv_tables.test
# description: Hive tables with the csv file format: CREATE TABLE ... WITH (format = 'csv'), the SerDe Glue stores,
# group: [csv]

#              INSERT writing header-less comma separated files, reads through the catalog and through
#              hive_scan(format := 'csv'). Other delimiters, headers and quoting: test_csv_dialects.test

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv;

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_plain;

#---------------------------------------------------------------------------
# a partitioned csv table
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_csv (flight VARCHAR, delay INTEGER, year INTEGER) PARTITIONED BY (year) WITH (format = 'csv');

# the Glue table describes a csv table the way Hive / Athena expect it: LazySimpleSerDe, comma delimited, no header
query IIII
SELECT serde_library, parameters['classification'],
       response.StorageDescriptor.InputFormat::VARCHAR, response.StorageDescriptor.OutputFormat::VARCHAR
FROM glue_get_table_response('my_datalake.default.formats_csv');
----
org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe	csv	org.apache.hadoop.mapred.TextInputFormat	org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat

query IIII
SELECT serde_parameters['field.delim'], serde_parameters['serialization.format'], parameters['delimiter'],
       parameters['skip.header.line.count'] IS NULL
FROM glue_get_table_response('my_datalake.default.formats_csv');
----
,	,	,	true

query IIII
SELECT columns[1].name, columns[1].type, columns[2].type, partition_keys[1].name
FROM glue_get_table_response('my_datalake.default.formats_csv');
----
flight	string	int	year

statement ok
INSERT INTO my_datalake.default.formats_csv VALUES
    ('AA4', 3, 1993),
    ('AA3', 12, 1999),
    ('AA1', 5, 2007),
    ('AA2', 0, 2015);

# a second insert appends a file to an existing partition and adds a new one
statement ok
INSERT INTO my_datalake.default.formats_csv VALUES ('AA5', 7, 2015), ('AA6', 1, 2020);

# the files are comma separated without a header line, one directory per partition, without the partition column
query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv/year=2015/*.csv');
----
2

query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv/year=1993/*.csv');
----
AA4,3<nl>

query II
SELECT flight, delay FROM read_csv('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv/year=2015/*.csv', header = false, columns = {flight: 'VARCHAR', delay: 'INTEGER'}) ORDER BY flight;
----
AA2	0
AA5	7

query II
SELECT year, count(*) FROM glue_partitions('my_datalake.default.formats_csv') GROUP BY year ORDER BY year;
----
1993	1
1999	1
2007	1
2015	1
2020	1

query III
SELECT flight, delay, year FROM my_datalake.default.formats_csv ORDER BY year, flight;
----
AA4	3	1993
AA3	12	1999
AA1	5	2007
AA2	0	2015
AA5	7	2015
AA6	1	2020

query I
SELECT flight FROM my_datalake.default.formats_csv WHERE year = 2015 ORDER BY flight;
----
AA2
AA5

#---------------------------------------------------------------------------
# an unpartitioned csv table: the columns are matched by position, with the table's types
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_csv_plain (id INTEGER, name VARCHAR, amount DECIMAL(10, 2), ok BOOLEAN, d DATE) WITH (format = 'csv');

query IIII
SELECT serde_library, parameters['classification'], columns[3].type, columns[5].type
FROM glue_get_table_response('my_datalake.default.formats_csv_plain');
----
org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe	csv	decimal(10,2)	date

statement ok
INSERT INTO my_datalake.default.formats_csv_plain VALUES (1, 'a', 10.50, true, '2016-05-14'), (2, 'b', NULL, false, NULL);

statement ok
INSERT INTO my_datalake.default.formats_csv_plain VALUES (3, 'c', 0.01, NULL, '2016-05-15');

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_plain/*.csv');
----
2

# NULL is \N, the default serialization.null.format of LazySimpleSerDe
query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_plain/*.csv') ORDER BY 1;
----
1,a,10.50,true,2016-05-14<nl>2,b,\N,false,\N<nl>
3,c,0.01,\N,2016-05-15<nl>

query IIIII
SELECT id, name, amount, ok, d FROM my_datalake.default.formats_csv_plain ORDER BY id;
----
1	a	10.50	true	2016-05-14
2	b	NULL	false	NULL
3	c	0.01	NULL	2016-05-15

query I
SELECT sum(amount) FROM my_datalake.default.formats_csv_plain;
----
10.51

#---------------------------------------------------------------------------
# the same data through hive_scan(), without the catalog
#---------------------------------------------------------------------------
statement ok
DETACH my_datalake;

query III
SELECT flight, delay, year FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv', format := 'csv',
    schema := {flight: 'VARCHAR', delay: 'INTEGER', year: 'INTEGER'},
    partitions := [{year: 1993}, {year: 2015}, {year: 2020}])
ORDER BY year, flight;
----
AA4	3	1993
AA2	0	2015
AA5	7	2015
AA6	1	2020

query IIIII
SELECT id, name, amount, ok, d FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_plain', format := 'csv', nullstr := '\N',
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DECIMAL(10, 2)', ok: 'BOOLEAN', d: 'DATE'})
ORDER BY id;
----
1	a	10.50	true	2016-05-14
2	b	NULL	false	NULL
3	c	0.01	NULL	2016-05-15

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE my_datalake.default.formats_csv;

statement ok
DROP TABLE my_datalake.default.formats_csv_plain;
