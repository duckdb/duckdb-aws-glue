# name: test/sql/hive/dml/formats/csv/test_csv_escape_delim.test
# description: LazySimpleSerDe tables with escape.delim (ESCAPED BY): reads unescape fields and INSERT escapes them
# group: [csv]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_escaped;

statement ok
CREATE TABLE my_datalake.default.formats_csv_escaped (id INTEGER, s VARCHAR, n INTEGER)
WITH (format = 'csv', 'escape.delim' = '\');

query II
SELECT serde_library, parameters['escape.delim'] FROM glue_get_table_response('my_datalake.default.formats_csv_escaped');
----
org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe	\

# a file as Hive writes it: an escaped delimiter and escape character, \N for NULL
statement ok
COPY (SELECT * FROM (VALUES ('1,a\,b,10'), ('2,back\\slash,20'), ('3,\N,30'), ('4,a\qb,40'), ('5,\\N,50'),
    ('6,trailing\\,60'), ('7,,70')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_escaped/hive.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, s, n FROM my_datalake.default.formats_csv_escaped ORDER BY id;
----
1	a,b	10
2	back\slash	20
3	NULL	30
4	aqb	40
5	\N	50
6	trailing\	60
7	(empty)	70

# INSERT escapes the escape character and the delimiter, so the values read back unchanged
statement ok
INSERT INTO my_datalake.default.formats_csv_escaped VALUES (8, 'x,y', 80), (9, 'c:\dir\file', 90), (10, '\,\', 100),
    (11, NULL, 110);

query III
SELECT id, s, n FROM my_datalake.default.formats_csv_escaped WHERE id >= 8 ORDER BY id;
----
8	x,y	80
9	c:\dir\file	90
10	\,\	100
11	NULL	110

query I
SELECT count(*) FROM my_datalake.default.formats_csv_escaped WHERE s LIKE '%,%';
----
3

# a line break still can not be written
statement error
INSERT INTO my_datalake.default.formats_csv_escaped VALUES (12, 'two' || chr(10) || 'lines', 120);
----
holds a line break or is the table's NULL string

# a value ending in the escape character: INSERT writes it escaped, before the line break
statement ok
INSERT INTO my_datalake.default.formats_csv_escaped VALUES (12, 'abc\', 120);

query II
SELECT s, length(s) FROM my_datalake.default.formats_csv_escaped WHERE id = 12;
----
abc\	4

statement ok
DROP TABLE my_datalake.default.formats_csv_escaped;

# Hive splits the records at the line breaks before the SerDe sees them, so it reads an escape right before a line
# break as the end of the record: '1,a' and then '2,b,20'. DuckDB escapes the line break and reads one row.
statement ok
CREATE TABLE my_datalake.default.formats_csv_escaped_eol (id INTEGER, s VARCHAR, n INTEGER)
WITH (format = 'csv', 'escape.delim' = '\');

statement ok
COPY (SELECT '1,a\' || chr(10) || '2,b,20' AS line)
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_escaped_eol/hive.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

mode skip

# FIXME: an escaped line break ends the record in Hive
query III
SELECT id, s, n FROM my_datalake.default.formats_csv_escaped_eol ORDER BY id;
----
1	a	NULL
2	b	20

mode unskip

statement ok
DROP TABLE my_datalake.default.formats_csv_escaped_eol;

#---------------------------------------------------------------------------
# an escape character other than '\': '|'
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_escaped_pipe;

statement ok
CREATE TABLE my_datalake.default.formats_csv_escaped_pipe (id INTEGER, s VARCHAR)
WITH (format = 'csv', 'escape.delim' = '|');

statement ok
INSERT INTO my_datalake.default.formats_csv_escaped_pipe VALUES (1, 'a,b'), (2, 'x|y'), (3, 'back\slash'), (4, NULL);

# the file holds the escaped values
query I
SELECT replace(trim(content, chr(10)), chr(10), ' / ') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_escaped_pipe/*');
----
1,a|,b / 2,x||y / 3,back\slash / 4,\N

query II
SELECT id, s FROM my_datalake.default.formats_csv_escaped_pipe ORDER BY id;
----
1	a,b
2	x|y
3	back\slash
4	NULL

statement ok
DROP TABLE my_datalake.default.formats_csv_escaped_pipe;

#---------------------------------------------------------------------------
# escape.delim with another field delimiter: '\' with fields separated by '|'
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_escaped_delim;

statement ok
CREATE TABLE my_datalake.default.formats_csv_escaped_delim (id INTEGER, s VARCHAR)
WITH (format = 'csv', delimiter = '|', 'escape.delim' = '\');

statement ok
INSERT INTO my_datalake.default.formats_csv_escaped_delim VALUES (1, 'a|b'), (2, 'a,b'), (3, NULL);

query I
SELECT replace(trim(content, chr(10)), chr(10), ' / ') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_escaped_delim/*');
----
1|a\|b / 2|a,b / 3|\N

query III
SELECT id, s, s IS NULL FROM my_datalake.default.formats_csv_escaped_delim ORDER BY id;
----
1	a|b	false
2	a,b	false
3	NULL	true

statement ok
DROP TABLE my_datalake.default.formats_csv_escaped_delim;

#---------------------------------------------------------------------------
# an escape.delim of more than one byte is refused
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_escaped_multibyte;

statement ok
CREATE TABLE my_datalake.default.formats_csv_escaped_multibyte (id INTEGER, s VARCHAR)
WITH (format = 'csv', 'escape.delim' = '§');

statement error
SELECT * FROM my_datalake.default.formats_csv_escaped_multibyte;
----
has an 'escape.delim' of more than one byte, which DuckDB can not read or write

statement error
INSERT INTO my_datalake.default.formats_csv_escaped_multibyte VALUES (1, 'a');
----
has an 'escape.delim' of more than one byte, which DuckDB can not read or write

statement ok
DROP TABLE my_datalake.default.formats_csv_escaped_multibyte;
