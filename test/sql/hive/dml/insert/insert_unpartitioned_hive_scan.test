# name: test/sql/hive/dml/insert/insert_unpartitioned_hive_scan.test
# description: INSERT into an unpartitioned Hive table across a schema change, read through the Glue catalog and
# group: [insert]

#              through hive_scan() without any catalog

require httpfs

require glue

require-env GLUE_CATALOG_ID

# this test is about Parquet tables, so they stay Parquet whatever the config's default format
statement ok
SET hive_default_format = 'parquet';

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ins_plain;

statement ok
CREATE TABLE my_datalake.default.ins_plain (id INTEGER, name VARCHAR);

# every INSERT writes a new file below the table location
statement ok
INSERT INTO my_datalake.default.ins_plain VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO my_datalake.default.ins_plain VALUES (3, 'c');

# files written before a column was added do not have it: it reads as NULL
statement ok
ALTER TABLE my_datalake.default.ins_plain ADD COLUMN score DOUBLE;

statement ok
INSERT INTO my_datalake.default.ins_plain VALUES (4, 'd', 4.5);

query III
SELECT id, name, score FROM my_datalake.default.ins_plain ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	NULL
4	d	4.5

#---------------------------------------------------------------------------
# the same read with hive_scan(): no catalog attached, the schema is given
#---------------------------------------------------------------------------
statement ok
DETACH my_datalake;

query III
SELECT id, name, score FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ins_plain',
    schema := {id: 'INTEGER', name: 'VARCHAR', score: 'DOUBLE'})
ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	NULL
4	d	4.5

# the schema decides what is read: a subset of the columns, with a wider type
query II
SELECT id, typeof(id) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ins_plain',
    schema := {id: 'BIGINT', name: 'VARCHAR'})
ORDER BY id LIMIT 1;
----
1	BIGINT

# a location without data files scans as empty
query II
SELECT count(*), max(id) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/does_not_exist', schema := {id: 'INTEGER'});
----
0	NULL

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE my_datalake.default.ins_plain;
