# name: test/sql/hive/dml/insert/insert_statistics.test
# description: INSERT and CTAS into parquet Hive tables keep numRows, numFiles and totalSize in Glue current
# group: [insert]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_plain;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_parts;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_located;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_unknown;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_csv;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_ctas;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stats_ctas_parts;

#---------------------------------------------------------------------------
# unpartitioned: a new table starts with empty statistics, every insert adds to them
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.stats_plain (id INTEGER, name VARCHAR);

query III
SELECT parameters['numRows'], parameters['numFiles'], parameters['totalSize']
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
0	0	0

statement ok
INSERT INTO my_datalake.default.stats_plain SELECT i, 'name_' || i FROM range(5) t(i);

query II
SELECT parameters['numRows'], parameters['numFiles']::BIGINT = (
    SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_plain/*.parquet'))
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
5	true

# totalSize is the size of the written files
query I
SELECT parameters['totalSize']::BIGINT = (
    SELECT sum(size) FROM read_blob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_plain/*.parquet'))
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
true

statement ok
INSERT INTO my_datalake.default.stats_plain VALUES (10, 'ten'), (11, 'eleven'), (12, 'twelve');

query II
SELECT parameters['numRows'], parameters['numFiles']::BIGINT = (
    SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_plain/*.parquet'))
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
8	true

query I
SELECT parameters['totalSize']::BIGINT = (
    SELECT sum(size) FROM read_blob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_plain/*.parquet'))
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
true

query I
SELECT count(*) FROM my_datalake.default.stats_plain;
----
8

# an insert of no rows writes no file and changes nothing
statement ok
INSERT INTO my_datalake.default.stats_plain SELECT i, 'x' FROM range(5) t(i) WHERE i > 100;

query II
SELECT parameters['numRows'], parameters['numFiles']::BIGINT = (
    SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_plain/*.parquet'))
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
8	true

# moving the table drops the statistics: they describe the files at the old location
statement ok
CALL glue_set_table_location('my_datalake.default.stats_plain', '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_plain_moved');

query III
SELECT parameters['numRows'], parameters['numFiles'], parameters['totalSize']
FROM glue_get_table_response('my_datalake.default.stats_plain');
----
NULL	NULL	NULL

# and unknown statistics stay unknown
statement ok
INSERT INTO my_datalake.default.stats_plain VALUES (1, 'one');

query I
SELECT parameters['numRows'] FROM glue_get_table_response('my_datalake.default.stats_plain');
----
NULL

#---------------------------------------------------------------------------
# unpartitioned tables without (valid) statistics are left alone
#---------------------------------------------------------------------------
# an explicit location may already hold files
statement ok
CREATE TABLE my_datalake.default.stats_located (id INTEGER)
WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_located_dir');

statement ok
INSERT INTO my_datalake.default.stats_located VALUES (1), (2);

query I
SELECT parameters['numRows'] FROM glue_get_table_response('my_datalake.default.stats_located');
----
NULL

# statistics given as table properties are kept; Hive writes -1 for unknown
statement ok
CREATE TABLE my_datalake.default.stats_unknown (id INTEGER) WITH (numRows = '-1');

query III
SELECT parameters['numRows'], parameters['numFiles'], parameters['totalSize']
FROM glue_get_table_response('my_datalake.default.stats_unknown');
----
-1	0	0

statement ok
INSERT INTO my_datalake.default.stats_unknown VALUES (1), (2);

query III
SELECT parameters['numRows'], parameters['numFiles'], parameters['totalSize']
FROM glue_get_table_response('my_datalake.default.stats_unknown');
----
-1	0	0

# only the parquet writer reports statistics
statement ok
CREATE TABLE my_datalake.default.stats_csv (id INTEGER, name VARCHAR) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.stats_csv VALUES (1, 'one');

query I
SELECT parameters['numRows'] FROM glue_get_table_response('my_datalake.default.stats_csv');
----
NULL

query I
SELECT count(*) FROM my_datalake.default.stats_csv;
----
1

#---------------------------------------------------------------------------
# partitioned: statistics per partition
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.stats_parts (id INTEGER, year INTEGER) PARTITIONED BY (year);

statement ok
INSERT INTO my_datalake.default.stats_parts SELECT i, 2020 + i % 2 FROM range(7) t(i);

# the table itself has no statistics
query I
SELECT parameters['numRows'] FROM glue_get_table_response('my_datalake.default.stats_parts');
----
NULL

query III
SELECT year, parameters['numRows'], parameters['numFiles']
FROM glue_partitions('my_datalake.default.stats_parts') ORDER BY year;
----
2020	4	1
2021	3	1

query II
SELECT p.year, p.parameters['totalSize']::BIGINT = f.size
FROM glue_partitions('my_datalake.default.stats_parts') p
JOIN (SELECT regexp_extract(filename, '^(.*)/[^/]*$', 1) AS directory, sum(size) AS size
      FROM read_blob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_parts/*/*.parquet') GROUP BY directory) f
  ON f.directory = p.location
ORDER BY p.year;
----
2020	true
2021	true

# appending adds to the existing partition, a new partition gets its own statistics
statement ok
INSERT INTO my_datalake.default.stats_parts VALUES (100, 2021), (101, 2021), (102, 2022);

query III
SELECT year, parameters['numRows'], parameters['numFiles']
FROM glue_partitions('my_datalake.default.stats_parts') ORDER BY year;
----
2020	4	1
2021	5	2
2022	1	1

query II
SELECT p.year, p.parameters['totalSize']::BIGINT = f.size
FROM glue_partitions('my_datalake.default.stats_parts') p
JOIN (SELECT regexp_extract(filename, '^(.*)/[^/]*$', 1) AS directory, sum(size) AS size
      FROM read_blob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_parts/*/*.parquet') GROUP BY directory) f
  ON f.directory = p.location
ORDER BY p.year;
----
2020	true
2021	true
2022	true

query II
SELECT year, count(*) FROM my_datalake.default.stats_parts GROUP BY year ORDER BY year;
----
2020	4
2021	5
2022	1

# a partition registered without statistics keeps having none
statement ok
CALL glue_add_partition('my_datalake.default.stats_parts', {year: 2023});

statement ok
INSERT INTO my_datalake.default.stats_parts VALUES (200, 2023), (201, 2020);

query III
SELECT year, parameters['numRows'], parameters['numFiles']
FROM glue_partitions('my_datalake.default.stats_parts') ORDER BY year;
----
2020	5	2
2021	5	2
2022	1	1
2023	NULL	NULL

# moving a partition drops its statistics
statement ok
CALL glue_set_partition_location('my_datalake.default.stats_parts', {year: 2022},
    '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_parts_moved/year=2022');

query II
SELECT year, parameters['numRows'] FROM glue_partitions('my_datalake.default.stats_parts') WHERE year = 2022;
----
2022	NULL

#---------------------------------------------------------------------------
# CREATE TABLE AS
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.stats_ctas AS SELECT i AS id FROM range(42) t(i);

query II
SELECT parameters['numRows'], parameters['numFiles']::BIGINT = (
    SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stats_ctas/*.parquet'))
FROM glue_get_table_response('my_datalake.default.stats_ctas');
----
42	true

statement ok
CREATE TABLE my_datalake.default.stats_ctas_parts PARTITIONED BY (bucket) AS
SELECT i AS id, i % 3 AS bucket FROM range(10) t(i);

query III
SELECT bucket, parameters['numRows'], parameters['numFiles']
FROM glue_partitions('my_datalake.default.stats_ctas_parts') ORDER BY bucket;
----
0	4	1
1	3	1
2	3	1

statement ok
DROP TABLE my_datalake.default.stats_plain;

statement ok
DROP TABLE my_datalake.default.stats_parts;

statement ok
DROP TABLE my_datalake.default.stats_located;

statement ok
DROP TABLE my_datalake.default.stats_unknown;

statement ok
DROP TABLE my_datalake.default.stats_csv;

statement ok
DROP TABLE my_datalake.default.stats_ctas;

statement ok
DROP TABLE my_datalake.default.stats_ctas_parts;
