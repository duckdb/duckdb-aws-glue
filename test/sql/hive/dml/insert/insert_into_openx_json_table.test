# name: test/sql/hive/dml/insert/insert_into_openx_json_table.test
# description: JSON tables with the OpenX SerDe are read, writes are refused (Athena writes JSON only with the Hive JsonSerDe)
# group: [insert]

require httpfs

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query I
SELECT serde_library FROM glue_get_table_response('my_datalake.default.fixture_openx_json');
----
org.openx.data.jsonserde.JsonSerDe

# data written by another engine; COPY TO writes S3 directly and is not a write through the catalog
statement ok
COPY (SELECT 1 AS id, 'a' AS name UNION ALL SELECT 2, 'b')
TO '{DEFAULT_S3_LOCATION}/fixture/fixture_openx_json/data.json' (FORMAT json);

query II
SELECT id, name FROM my_datalake.default.fixture_openx_json ORDER BY id;
----
1	a
2	b

statement error
INSERT INTO my_datalake.default.fixture_openx_json VALUES (3, 'c');
----
<REGEX>:.*INSERT into Glue table 'fixture_openx_json' is not supported: the table uses the OpenX JSON SerDe 'org\.openx\.data\.jsonserde\.JsonSerDe', DuckDB writes JSON tables only with the Hive JsonSerDe.*

statement error
INSERT INTO my_datalake.default.fixture_openx_json SELECT 4, 'd';
----
OpenX JSON SerDe

# nothing was written
query I
SELECT count(*) FROM my_datalake.default.fixture_openx_json;
----
2

# a JSON table created by DuckDB gets the Hive JsonSerDe and is written
statement ok
DROP TABLE IF EXISTS my_datalake.default.hive_json_write;

statement ok
CREATE TABLE my_datalake.default.hive_json_write (id INTEGER, name VARCHAR) WITH (format = 'json');

query I
SELECT serde_library FROM glue_get_table_response('my_datalake.default.hive_json_write');
----
org.apache.hive.hcatalog.data.JsonSerDe

statement ok
INSERT INTO my_datalake.default.hive_json_write VALUES (1, 'a');

query II
SELECT id, name FROM my_datalake.default.hive_json_write;
----
1	a

statement ok
DROP TABLE my_datalake.default.hive_json_write;
