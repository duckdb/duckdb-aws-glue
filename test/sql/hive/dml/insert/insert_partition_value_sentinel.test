# name: test/sql/hive/dml/insert/insert_partition_value_sentinel.test
# description: a partition value that is not NULL but that Hive reads back as NULL is refused ('__HIVE_DEFAULT_PARTITION__', and for a BLOB key also 'NULL' and ''); other values, NULL included, are written and read back
# group: [insert]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.pv_sentinel;

statement ok
CREATE TABLE my_datalake.default.pv_sentinel (id INTEGER, k VARCHAR) PARTITIONED BY (k);

# values with characters a path escapes, and spellings close to the NULL sentinel, each in a partition of its own
statement ok
INSERT INTO my_datalake.default.pv_sentinel
SELECT i, k FROM range(3) t(i), (VALUES ('a/b'), ('a=b'), ('a%b'), ('%2F'), ('%5F_HIVE_DEFAULT_PARTITION__'), ('a b'),
    ('a?b'), ('a#b'), ('a\b'), ('..'), ('ü'), ('NULL'), ('null'), ('__hive_default_partition__'),
    ('__HIVE_DEFAULT_PARTITION'), (NULL)) v(k);

query II
SELECT k, count(*) FROM my_datalake.default.pv_sentinel GROUP BY k ORDER BY k NULLS LAST;
----
%2F	3
%5F_HIVE_DEFAULT_PARTITION__	3
..	3
NULL	3
__HIVE_DEFAULT_PARTITION	3
__hive_default_partition__	3
a b	3
a#b	3
a%b	3
a/b	3
a=b	3
a?b	3
a\b	3
null	3
ü	3
NULL	3

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.pv_sentinel');
----
16

# the value Hive stores NULL as can not be told apart from NULL: refused, with the NULL partition in the same INSERT
statement error
INSERT INTO my_datalake.default.pv_sentinel VALUES (1, '__HIVE_DEFAULT_PARTITION__'), (2, NULL);
----
<REGEX>:.*partition key 'k' has a value \('__HIVE_DEFAULT_PARTITION__'\) that Hive reads back as NULL.*

# ...and on its own, now that the NULL partition exists
statement error
INSERT INTO my_datalake.default.pv_sentinel VALUES (1, '__HIVE_DEFAULT_PARTITION__');
----
<REGEX>:.*partition key 'k' has a value \('__HIVE_DEFAULT_PARTITION__'\) that Hive reads back as NULL.*

# neither INSERT wrote rows or partitions
query I
SELECT count(*) FROM my_datalake.default.pv_sentinel;
----
48

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.pv_sentinel');
----
16

# alone, in a table with no NULL partition: its partition would be registered with the NULL partition's value and read
# back as NULL
statement ok
DROP TABLE IF EXISTS my_datalake.default.pv_sentinel_alone;

statement ok
CREATE TABLE my_datalake.default.pv_sentinel_alone (id INTEGER, k VARCHAR) PARTITIONED BY (k);

statement error
INSERT INTO my_datalake.default.pv_sentinel_alone VALUES (1, '__HIVE_DEFAULT_PARTITION__');
----
<REGEX>:.*partition key 'k' has a value \('__HIVE_DEFAULT_PARTITION__'\) that Hive reads back as NULL.*

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.pv_sentinel_alone');
----
0

statement ok
DROP TABLE my_datalake.default.pv_sentinel_alone;

# a table with no NULL partition yet refuses it too
statement ok
DROP TABLE IF EXISTS my_datalake.default.pv_sentinel_new;

statement error
CREATE TABLE my_datalake.default.pv_sentinel_new PARTITIONED BY (k) AS
SELECT * FROM (VALUES (1, '__HIVE_DEFAULT_PARTITION__'), (2, NULL)) t(id, k);
----
<REGEX>:.*partition key 'k' has a value \('__HIVE_DEFAULT_PARTITION__'\) that Hive reads back as NULL.*

# the second of two partition keys
statement ok
DROP TABLE IF EXISTS my_datalake.default.pv_sentinel_two;

statement ok
CREATE TABLE my_datalake.default.pv_sentinel_two (id INTEGER, a VARCHAR, b VARCHAR) PARTITIONED BY (a, b);

statement error
INSERT INTO my_datalake.default.pv_sentinel_two VALUES (1, 'x', '__HIVE_DEFAULT_PARTITION__'), (2, 'x', NULL);
----
<REGEX>:.*partition key 'b' has a value \('__HIVE_DEFAULT_PARTITION__'\) that Hive reads back as NULL.*

query I
SELECT count(*) FROM my_datalake.default.pv_sentinel_two;
----
0

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.pv_sentinel_two');
----
0

# a BLOB key reads 'NULL' in any case and '' as NULL too, like every key that is not a string
statement ok
DROP TABLE IF EXISTS my_datalake.default.pv_sentinel_blob;

statement ok
CREATE TABLE my_datalake.default.pv_sentinel_blob (id INTEGER, k BLOB) PARTITIONED BY (k);

statement ok
INSERT INTO my_datalake.default.pv_sentinel_blob VALUES (1, NULL), (2, 'a'::BLOB), (3, 'NULLx'::BLOB), (4, '\xAA\x00'::BLOB);

foreach value __HIVE_DEFAULT_PARTITION__ NULL nUlL

statement error
INSERT INTO my_datalake.default.pv_sentinel_blob VALUES (5, '{value}'::BLOB);
----
<REGEX>:.*partition key 'k' has a value \('__HIVE_DEFAULT_PARTITION__', 'NULL' in any case, or ''\) that Hive reads back as NULL.*

endloop

statement error
INSERT INTO my_datalake.default.pv_sentinel_blob VALUES (5, ''::BLOB);
----
<REGEX>:.*partition key 'k' has a value \('__HIVE_DEFAULT_PARTITION__', 'NULL' in any case, or ''\) that Hive reads back as NULL.*

query II
SELECT id, k FROM my_datalake.default.pv_sentinel_blob ORDER BY id;
----
1	NULL
2	a
3	NULLx
4	\xAA\x00

statement ok
DROP TABLE my_datalake.default.pv_sentinel_blob;

statement ok
DROP TABLE my_datalake.default.pv_sentinel;

statement ok
DROP TABLE my_datalake.default.pv_sentinel_two;

statement ok
DROP TABLE IF EXISTS my_datalake.default.pv_sentinel_new;
