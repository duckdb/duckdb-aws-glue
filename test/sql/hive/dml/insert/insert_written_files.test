# name: test/sql/hive/dml/insert/insert_written_files.test
# description: the GlueDataFileWritten log type records the data files an INSERT or CREATE TABLE AS wrote
# group: [insert]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files;

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files_partitioned;

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files_ctas;

statement ok
CALL enable_logging('GlueDataFileWritten');

statement ok
CREATE TABLE my_datalake.default.written_files (id INTEGER);

statement ok
CALL truncate_duckdb_logs();

statement ok
INSERT INTO my_datalake.default.written_files SELECT i FROM range(10) t(i);

# the logged files are all the table's files, from one query
query II
SELECT count(*) > 0, count(DISTINCT query_id) FROM duckdb_logs_parsed('GlueDataFileWritten');
----
true	1

query I
SELECT count(*) FROM (
    (SELECT file_path FROM duckdb_logs_parsed('GlueDataFileWritten')
     EXCEPT SELECT file FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/written_files/**'))
    UNION ALL
    (SELECT file FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/written_files/**')
     EXCEPT SELECT file_path FROM duckdb_logs_parsed('GlueDataFileWritten'))
);
----
0

query I
SELECT DISTINCT "table" FROM duckdb_logs_parsed('GlueDataFileWritten');
----
my_datalake.default.written_files

query I
SELECT bool_and(connection_id = current_connection_id()) FROM duckdb_logs_parsed('GlueDataFileWritten');
----
true

# a partitioned INSERT logs the files of every partition it wrote
statement ok
CREATE TABLE my_datalake.default.written_files_partitioned (id INTEGER, p INTEGER) PARTITIONED BY (p);

statement ok
CALL truncate_duckdb_logs();

statement ok
INSERT INTO my_datalake.default.written_files_partitioned SELECT i, i % 3 FROM range(9) t(i);

query I
SELECT DISTINCT regexp_extract(file_path, '/(p=[0-9]+)/', 1) AS partition FROM duckdb_logs_parsed('GlueDataFileWritten') ORDER BY partition;
----
p=0
p=1
p=2

# a write that fails while running logs none, as its files are deleted
statement ok
CALL truncate_duckdb_logs();

statement error
INSERT INTO my_datalake.default.written_files SELECT CASE WHEN i = 5 THEN error('boom') ELSE i END FROM range(10) t(i);
----
boom

query I
SELECT count(*) FROM duckdb_logs_parsed('GlueDataFileWritten');
----
0

# so does one whose partition registration fails
statement ok
SET glue_debug_fail_partition_registration = 'InvalidInputException:0';

statement error
INSERT INTO my_datalake.default.written_files_partitioned SELECT i, i % 3 + 10 FROM range(9) t(i);
----
was rolled back

statement ok
RESET glue_debug_fail_partition_registration;

query I
SELECT count(*) FROM duckdb_logs_parsed('GlueDataFileWritten');
----
0

# CREATE TABLE AS
statement ok
CREATE TABLE my_datalake.default.written_files_ctas AS SELECT i AS id FROM range(5) t(i);

query I
SELECT count(*) FROM (
    (SELECT file_path FROM duckdb_logs_parsed('GlueDataFileWritten')
     EXCEPT SELECT file FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/written_files_ctas/**'))
    UNION ALL
    (SELECT file FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/written_files_ctas/**')
     EXCEPT SELECT file_path FROM duckdb_logs_parsed('GlueDataFileWritten'))
);
----
0

# a CREATE TABLE AS that fails when it starts writing logs none: the dropped table's files are still there
statement ok
DROP TABLE my_datalake.default.written_files_ctas;

statement ok
CALL truncate_duckdb_logs();

statement error
CREATE TABLE my_datalake.default.written_files_ctas AS SELECT 1 AS id;
----
already holds files

query I
SELECT count(*) FROM duckdb_logs_parsed('GlueDataFileWritten');
----
0

statement ok
DROP TABLE my_datalake.default.written_files;

statement ok
DROP TABLE my_datalake.default.written_files_partitioned;

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files_ctas;
