# a TIMESTAMP injected column is never read (the scan refuses it, as Athena does), so nothing is written to it
statement ok
CREATE TABLE my_datalake.default.pw_inj_ts (id INTEGER, k TIMESTAMP) PARTITIONED BY (k)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_inj_ts',
    'projection.enabled' = 'true',
    'projection.k.type' = 'injected'
);

statement error
INSERT INTO my_datalake.default.pw_inj_ts VALUES (1, TIMESTAMP '2024-01-15 10:00:00');
----
Invalid Input Error: Glue table 'default.pw_inj_ts': partition value '2024-01-15 10:00:00'::TIMESTAMP of 'k' is not one its projection derives (projection.k.type = injected)

statement ok
DROP TABLE my_datalake.default.pw_inj_ts;

# a DATE injected column is read (test_partition_projection.test pp_inj_date) and so written as the date's text
statement ok
CREATE TABLE my_datalake.default.pw_inj_date (id INTEGER, k DATE) PARTITIONED BY (k)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_inj_date',
    'projection.enabled' = 'true',
    'projection.k.type' = 'injected'
);

query I
