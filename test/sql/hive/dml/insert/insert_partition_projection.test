# ---------------------------------------------------------------------------------------------------------------------
# Registered partitions are ignored on write as on read: the file goes to the projected location, not the registered
# one, and no GetPartitions call is made
# source: AWSHiveMetastore.getPartition returns the projected partition for a projected table (Athena's shim);
# partition-projection.html "Athena ignores any partition metadata registered to the table"
# ---------------------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.pw_registered (id INTEGER, region VARCHAR, hour INTEGER) PARTITIONED BY (region, hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_registered',
    'projection.enabled' = 'false',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu',
    'projection.hour.type' = 'integer',
    'projection.hour.range' = '0,23',
    'projection.hour.digits' = '2'
);

statement ok
CALL glue_add_partition('my_datalake.default.pw_registered', {region: 'us', hour: 7},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_registered_elsewhere/us7');

statement ok
ALTER TABLE my_datalake.default.pw_registered SET ('projection.enabled' = 'true');

statement ok
CALL truncate_duckdb_logs();

query I
INSERT INTO my_datalake.default.pw_registered VALUES (1, 'us', 7);
----
1

query II
SELECT api, n FROM glue_calls() WHERE api IN ('BatchCreatePartition', 'GetPartitions', 'GetPartition', 'CreatePartition');
----

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_registered/region=us/hour=07/*.parquet');
----
1

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_registered_elsewhere/**');
----
0

query III
SELECT id, region, hour FROM my_datalake.default.pw_registered;
----
1	us	7

statement ok
DROP TABLE my_datalake.default.pw_registered;

# ---------------------------------------------------------------------------------------------------------------------
# COPY ... FROM a file follows the same rules as INSERT: written where the projection reads, refused the same way
# ---------------------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.pw_copy (id INTEGER, region VARCHAR, hour INTEGER) PARTITIONED BY (region, hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_copy',
    'projection.enabled' = 'true',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu',
    'projection.hour.type' = 'integer',
    'projection.hour.range' = '0,23',
    'projection.hour.digits' = '2'
);

statement ok
COPY (SELECT 1 AS id, 'eu' AS region, 3 AS hour) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_copy_src_ok.parquet';

statement ok
COPY (SELECT 2 AS id, 'ap' AS region, 3 AS hour) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_copy_src_bad.parquet';

query I
COPY my_datalake.default.pw_copy FROM '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_copy_src_ok.parquet';
----
1

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_copy/region=eu/hour=03/*.parquet');
----
1

statement error
COPY my_datalake.default.pw_copy FROM '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_copy_src_bad.parquet';
----
Invalid Input Error: Glue table 'default.pw_copy': partition value 'ap' of 'region' is not one its projection derives (projection.region.values = us,eu)

query III
SELECT id, region, hour FROM my_datalake.default.pw_copy;
----
1	eu	3

statement ok
DROP TABLE my_datalake.default.pw_copy;

# ---------------------------------------------------------------------------------------------------------------------
# glue_cache_listings: the INSERT invalidates the connection's listing, so the next SELECT sees its rows
# ---------------------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.pw_cache (id INTEGER, region VARCHAR) PARTITIONED BY (region)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_cache',
    'projection.enabled' = 'true',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu'
);

statement ok
SET glue_cache_listings = true;

query I
SELECT count(*) FROM my_datalake.default.pw_cache;
----
0

query I
INSERT INTO my_datalake.default.pw_cache VALUES (1, 'us');
----
1

query I
SELECT count(*) FROM my_datalake.default.pw_cache;
----
1

statement ok
RESET glue_cache_listings;

statement ok
DROP TABLE my_datalake.default.pw_cache;
