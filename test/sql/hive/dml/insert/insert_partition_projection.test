1	2024-01-15

statement ok
DROP TABLE my_datalake.default.pw_inj_date;

# an enum key on an INTEGER column: the listed text whose value is the row's, spelled as listed (white space kept)
statement ok
CREATE TABLE my_datalake.default.pw_enum_int (id INTEGER, hour INTEGER) PARTITIONED BY (hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pw_enum_int',
    'projection.enabled' = 'true',
    'projection.hour.type' = 'enum',
    'projection.hour.values' = '1, 2'
);

query I
