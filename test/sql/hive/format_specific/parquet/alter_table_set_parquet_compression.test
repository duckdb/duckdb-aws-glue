# name: test/sql/hive/format_specific/parquet/alter_table_set_parquet_compression.test
# description: ALTER TABLE ... SET ('parquet.compression', compression_level) changes the codec of the next INSERT
# group: [parquet]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

# Parquet-specific: parquet.compression is a Parquet table property
statement ok
SET hive_default_format = 'parquet';

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.alter_parquet_codec;

statement ok
CREATE TABLE my_datalake.default.alter_parquet_codec (id INTEGER);

statement ok
INSERT INTO my_datalake.default.alter_parquet_codec SELECT range FROM range(100);

# a dotted Hive property name, and the value the way Glue stores it: a string
statement ok
ALTER TABLE my_datalake.default.alter_parquet_codec SET ('parquet.compression' = 'ZSTD', 'compression_level' = 4);

query II
SELECT parameters['parquet.compression'], parameters['compression_level']
FROM glue_get_table_response('my_datalake.default.alter_parquet_codec');
----
ZSTD	4

statement ok
INSERT INTO my_datalake.default.alter_parquet_codec SELECT range FROM range(100, 200);

# the file written before the ALTER keeps the default codec, the one after it uses ZSTD
query I
SELECT string_agg(DISTINCT compression ORDER BY compression)
FROM parquet_metadata('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/alter_parquet_codec/*.parquet');
----
SNAPPY,ZSTD

query III
SELECT count(*), min(id), max(id) FROM my_datalake.default.alter_parquet_codec;
----
200	0	199

statement ok
DROP TABLE my_datalake.default.alter_parquet_codec;
