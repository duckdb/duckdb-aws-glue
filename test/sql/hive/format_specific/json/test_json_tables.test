# name: test/sql/hive/format_specific/json/test_json_tables.test
# description: Hive tables with the json file format: CREATE TABLE ... WITH (format = 'json'), the SerDe Glue stores,
# group: [json]

#              INSERT writing one JSON object per line, reads through the catalog and through hive_scan(format := 'json')

require httpfs

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_json;

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_json_plain;

#---------------------------------------------------------------------------
# a partitioned json table
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_json (flight VARCHAR, delay INTEGER, year INTEGER) PARTITIONED BY (year) WITH (format = 'json');

# the Glue table describes a json table the way Hive / Athena expect it
query IIII
SELECT serde_library, parameters['classification'],
       response.StorageDescriptor.InputFormat::VARCHAR, response.StorageDescriptor.OutputFormat::VARCHAR
FROM glue_get_table_response('my_datalake.default.formats_json');
----
org.apache.hive.hcatalog.data.JsonSerDe	json	org.apache.hadoop.mapred.TextInputFormat	org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat

query IIII
SELECT columns[1].name, columns[1].type, columns[2].type, partition_keys[1].name
FROM glue_get_table_response('my_datalake.default.formats_json');
----
flight	string	int	year

statement ok
INSERT INTO my_datalake.default.formats_json VALUES
    ('AA4', 3, 1993),
    ('AA3', 12, 1999),
    ('AA1', 5, 2007),
    ('AA2', 0, 2015);

# a second insert appends a file to an existing partition and adds a new one
statement ok
INSERT INTO my_datalake.default.formats_json VALUES ('AA5', 7, 2015), ('AA6', 1, 2020);

# the files hold one JSON object per line, one directory per partition, without the partition column
query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_json/year=2015/*.json');
----
2

query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_json/year=1993/*.json');
----
{"flight":"AA4","delay":3}<nl>

query II
SELECT flight, delay FROM read_json('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_json/year=2015/*.json', format = 'newline_delimited') ORDER BY flight;
----
AA2	0
AA5	7

query II
SELECT year, count(*) FROM glue_partitions('my_datalake.default.formats_json') GROUP BY year ORDER BY year;
----
1993	1
1999	1
2007	1
2015	1
2020	1

query III
SELECT flight, delay, year FROM my_datalake.default.formats_json ORDER BY year, flight;
----
AA4	3	1993
AA3	12	1999
AA1	5	2007
AA2	0	2015
AA5	7	2015
AA6	1	2020

query I
SELECT flight FROM my_datalake.default.formats_json WHERE year = 2015 ORDER BY flight;
----
AA2
AA5

#---------------------------------------------------------------------------
# an unpartitioned json table with nested columns, and a column added after the first insert
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_json_plain (id INTEGER, name VARCHAR, tags VARCHAR[], attrs STRUCT(k VARCHAR, v INTEGER)) WITH (format = 'json');

query IIII
SELECT serde_library, parameters['classification'], columns[3].type, columns[4].type
FROM glue_get_table_response('my_datalake.default.formats_json_plain');
----
org.apache.hive.hcatalog.data.JsonSerDe	json	array<string>	struct<k:string,v:int>

statement ok
INSERT INTO my_datalake.default.formats_json_plain VALUES (1, 'a', ['x', 'y'], {'k': 'one', 'v': 1}), (2, 'b', [], NULL);

query I
SELECT replace(content, chr(10), '<nl>') FROM read_text('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_json_plain/*.json');
----
{"id":1,"name":"a","tags":["x","y"],"attrs":{"k":"one","v":1}}<nl>{"id":2,"name":"b","tags":[],"attrs":null}<nl>

statement ok
ALTER TABLE my_datalake.default.formats_json_plain ADD COLUMN score DOUBLE;

statement ok
INSERT INTO my_datalake.default.formats_json_plain VALUES (3, 'c', NULL, {'k': 'three', 'v': 3}, 3.5);

# keys are matched by name: the column the first file does not have reads as NULL
query IIIII
SELECT id, name, tags, attrs, score FROM my_datalake.default.formats_json_plain ORDER BY id;
----
1	a	[x, y]	{'k': one, 'v': 1}	NULL
2	b	[]	NULL	NULL
3	c	NULL	{'k': three, 'v': 3}	3.5

#---------------------------------------------------------------------------
# the same data through hive_scan(), without the catalog
#---------------------------------------------------------------------------
statement ok
DETACH my_datalake;

query III
SELECT flight, delay, year FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_json', format := 'json',
    schema := {flight: 'VARCHAR', delay: 'INTEGER', year: 'INTEGER'},
    partitions := [{year: 1993}, {year: 2015}, {year: 2020}])
ORDER BY year, flight;
----
AA4	3	1993
AA2	0	2015
AA5	7	2015
AA6	1	2020

query III
SELECT id, name, score FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_json_plain', format := 'json',
    schema := {id: 'INTEGER', name: 'VARCHAR', score: 'DOUBLE'})
ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	3.5

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE my_datalake.default.formats_json;

statement ok
DROP TABLE my_datalake.default.formats_json_plain;
