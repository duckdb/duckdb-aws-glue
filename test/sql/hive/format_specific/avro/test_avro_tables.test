# name: test/sql/hive/format_specific/avro/test_avro_tables.test
# description: Hive tables with the avro file format: CREATE TABLE ... WITH (format = 'avro'), the SerDe Glue stores,
# group: [avro]

#              INSERT writing avro container files, reads through the catalog and through hive_scan(format := 'avro')

require httpfs

require avro

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_avro;

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_avro_plain;

#---------------------------------------------------------------------------
# a partitioned avro table
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_avro (flight VARCHAR, delay INTEGER, year INTEGER) PARTITIONED BY (year) WITH (format = 'avro');

# the Glue table describes an avro table the way Hive / Athena expect it
query IIII
SELECT serde_library, parameters['classification'],
       response.StorageDescriptor.InputFormat::VARCHAR, response.StorageDescriptor.OutputFormat::VARCHAR
FROM glue_get_table_response('my_datalake.default.formats_avro');
----
org.apache.hadoop.hive.serde2.avro.AvroSerDe	avro	org.apache.hadoop.hive.ql.io.avro.AvroContainerInputFormat	org.apache.hadoop.hive.ql.io.avro.AvroContainerOutputFormat

query IIII
SELECT columns[1].name, columns[1].type, columns[2].type, partition_keys[1].name
FROM glue_get_table_response('my_datalake.default.formats_avro');
----
flight	string	int	year

statement ok
INSERT INTO my_datalake.default.formats_avro VALUES
    ('AA4', 3, 1993),
    ('AA3', 12, 1999),
    ('AA1', 5, 2007),
    ('AA2', 0, 2015);

# a second insert appends a file to an existing partition and adds a new one
statement ok
INSERT INTO my_datalake.default.formats_avro VALUES ('AA5', 7, 2015), ('AA6', 1, 2020);

# the files are avro container files, one directory per partition, without the partition column
query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_avro/year=2015/*.avro');
----
2

query II
SELECT flight, delay FROM read_avro('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_avro/year=1993/*.avro');
----
AA4	3

query II
SELECT year, count(*) FROM glue_partitions('my_datalake.default.formats_avro') GROUP BY year ORDER BY year;
----
1993	1
1999	1
2007	1
2015	1
2020	1

query III
SELECT flight, delay, year FROM my_datalake.default.formats_avro ORDER BY year, flight;
----
AA4	3	1993
AA3	12	1999
AA1	5	2007
AA2	0	2015
AA5	7	2015
AA6	1	2020

query I
SELECT flight FROM my_datalake.default.formats_avro WHERE year = 2015 ORDER BY flight;
----
AA2
AA5

#---------------------------------------------------------------------------
# an unpartitioned avro table, with a column added after the first insert
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_avro_plain (id INTEGER, name VARCHAR) WITH (format = 'avro');

query II
SELECT serde_library, parameters['classification'] FROM glue_get_table_response('my_datalake.default.formats_avro_plain');
----
org.apache.hadoop.hive.serde2.avro.AvroSerDe	avro

statement ok
INSERT INTO my_datalake.default.formats_avro_plain VALUES (1, 'a'), (2, 'b');

statement ok
ALTER TABLE my_datalake.default.formats_avro_plain ADD COLUMN score DOUBLE;

statement ok
INSERT INTO my_datalake.default.formats_avro_plain VALUES (3, 'c', 3.5);

# the files carry their schema: the column the first file does not have reads as NULL
query III
SELECT id, name, score FROM my_datalake.default.formats_avro_plain ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	3.5

#---------------------------------------------------------------------------
# the same data through hive_scan(), without the catalog
#---------------------------------------------------------------------------
statement ok
DETACH my_datalake;

query III
SELECT flight, delay, year FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_avro', format := 'avro',
    schema := {flight: 'VARCHAR', delay: 'INTEGER', year: 'INTEGER'},
    partitions := [{year: 1993}, {year: 2015}, {year: 2020}])
ORDER BY year, flight;
----
AA4	3	1993
AA2	0	2015
AA5	7	2015
AA6	1	2020

query III
SELECT id, name, score FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_avro_plain', format := 'avro',
    schema := {id: 'INTEGER', name: 'VARCHAR', score: 'DOUBLE'})
ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	3.5

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE my_datalake.default.formats_avro;

statement ok
DROP TABLE my_datalake.default.formats_avro_plain;
