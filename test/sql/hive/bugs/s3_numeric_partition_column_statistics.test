# name: test/sql/hive/bugs/s3_numeric_partition_column_statistics.test
# description: S3 - partition-column statistics for NUMERIC partition columns.
# group: [bugs]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.numpart;

statement ok
CREATE TABLE my_datalake.default.numpart (id INTEGER, sk INTEGER) PARTITIONED BY (sk);

statement ok
INSERT INTO my_datalake.default.numpart SELECT i, 2450000 + (i % 4) FROM generate_series(1,4000) t(i);

# assess where we are at
query II
SELECT sk, count(*) FROM my_datalake.default.numpart GROUP BY sk ORDER BY sk;
----
2450000	1000
2450001	1000
2450002	1000
2450003	1000

# and Glue holds the four values
query I
SELECT count(*) FROM glue_partitions('my_datalake.default.numpart');
----
4

# four partitions, so at most four groups, even on an INTEGER key.
query II
EXPLAIN SELECT sk, count(*) FROM my_datalake.default.numpart GROUP BY sk;
----
physical_plan	<REGEX>:.*Hash Group By.*~4 rows.*


# two partitions, so two groups.
query II
EXPLAIN SELECT sk, count(*) FROM my_datalake.default.numpart where sk < 2450002 GROUP BY sk;
----
physical_plan	<REGEX>:.*Hash Group By.*~2 rows.*

statement ok
DROP TABLE my_datalake.default.numpart;
