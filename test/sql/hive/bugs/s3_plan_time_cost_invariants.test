# name: test/sql/hive/bugs/s3_plan_time_cost_invariants.test
# description: S3 guard - planning a Glue table samples ONE partition.
# group: [bugs]

# A per-partition sample would improve the plan while making bind time grow with the table.


require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost;

statement ok
CREATE TABLE my_datalake.default.plancost (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plancost SELECT i, 'd' || (i % 4) FROM generate_series(1,4000) t(i);

# the listed prefix is in the URL's query string, which HTTP logs redact by default
statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost;

# planning lists exactly one partition -- four partitions, one listing
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1

# and asks Glue exactly twice: the table definition, and the partition list
query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

statement ok
DROP TABLE my_datalake.default.plancost;

# ----------------------------------------------------------------------------------------------------
# THE GUARD: the sample must not grow with the table.
# ----------------------------------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost_wide;

statement ok
CREATE TABLE my_datalake.default.plancost_wide (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plancost_wide SELECT i, 'd' || (i % 20) FROM generate_series(1,4000) t(i);

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.plancost_wide');
----
20

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost_wide;

# still ONE listing, for five times the partitions: the scan reads at least hive_partition_listing_threshold
# partitions, so the estimate takes the root listing the scan reuses rather than listing a partition on top
query II
SELECT count(*), count(*) FILTER (WHERE url_decode(regexp_extract(request.url, 'prefix=([^&]*)', 1)) LIKE '%/plancost_wide/dt=%')
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1	0

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

# Four scans of the table in one query, two pruned to one partition and two reading all twenty, share one sample:
# a predicate changes how many partitions a scan reads, not what a file of the table holds
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd3'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd7'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide
UNION ALL SELECT * FROM my_datalake.default.plancost_wide;

query II
SELECT count(*), count(*) FILTER (WHERE url_decode(regexp_extract(request.url, 'prefix=([^&]*)', 1)) LIKE '%/plancost_wide/dt=%')
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1	1

# Glue is asked for the table and its partitions once per query, not once per scan. Without the optimizer, so the
# common subplan optimizer can not fold the scans into one: these are four scans, each bound on its own
statement ok
PRAGMA disable_optimizer;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd3'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd7'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide
UNION ALL SELECT * FROM my_datalake.default.plancost_wide);
----
8400

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

# the next query asks again
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (SELECT * FROM my_datalake.default.plancost_wide UNION ALL SELECT * FROM my_datalake.default.plancost_wide);
----
8000

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

statement ok
PRAGMA enable_optimizer;

# and each scan scales that one sample by its own partitions: twenty partitions are 4,000 rows
query II
EXPLAIN SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd3'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd7'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide
UNION ALL SELECT * FROM my_datalake.default.plancost_wide;
----
physical_plan	<REGEX>:.*Hive Scan.*~4,000 rows.*

# and one partition is 200: the equality is always true of the partition left, so it takes no selectivity
query II
EXPLAIN SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd3'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide WHERE dt = 'd7'
UNION ALL SELECT * FROM my_datalake.default.plancost_wide
UNION ALL SELECT * FROM my_datalake.default.plancost_wide;
----
physical_plan	<REGEX>:.*Hive Scan.*~200 rows.*

statement ok
DROP TABLE my_datalake.default.plancost_wide;

# ----------------------------------------------------------------------------------------------------
# An unpartitioned table is one directory, its location, listed once per query whatever reads it.
# ----------------------------------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost_flat;

statement ok
CREATE TABLE my_datalake.default.plancost_flat (id INTEGER, v VARCHAR);

statement ok
INSERT INTO my_datalake.default.plancost_flat SELECT i, 'v' || (i % 7) FROM generate_series(1,1000) t(i);

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost_flat UNION ALL SELECT * FROM my_datalake.default.plancost_flat;

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1

# running the query does not list it again: the scans read the listing the estimate took
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (SELECT * FROM my_datalake.default.plancost_flat UNION ALL SELECT * FROM my_datalake.default.plancost_flat);
----
2000

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1

statement ok
DROP TABLE my_datalake.default.plancost_flat;

# ----------------------------------------------------------------------------------------------------
# When the sample yields no row count, the fallback must not list either.
# ----------------------------------------------------------------------------------------------------

# avro has no bounded row count to sample, so planning lists nothing
statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost_avro;

statement ok
CREATE TABLE my_datalake.default.plancost_avro (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'avro');

statement ok
INSERT INTO my_datalake.default.plancost_avro SELECT i, 'd' || (i % 4) FROM generate_series(1,400) t(i);

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost_avro;

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
0

# partitions registered without files: the sample stops at the first empty one rather than listing the next
statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost_empty;

statement ok
CREATE TABLE my_datalake.default.plancost_empty (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

loop i 0 4

statement ok
CALL glue_add_partition('my_datalake.default.plancost_empty', {dt: 'd${i}'});

endloop

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.plancost_empty');
----
4

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost_empty;

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1

statement ok
DROP TABLE my_datalake.default.plancost_avro;

statement ok
DROP TABLE my_datalake.default.plancost_empty;
