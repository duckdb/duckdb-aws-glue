# name: test/sql/hive/bugs/s3_cardinality_ignores_data.test
# description: S3 - the cardinality estimate for a partitioned Glue table must reflect partition count, file count and row count.
# group: [bugs]

#
# Measured law (2026-09-21), confirmed over actual row counts from 100 to 200,000:
#
#     estimate = 1000 x partition_count x 2
#
# Expected behaviour: the cardinality estimate responds to the data. The data here varies the number of partitions
# and the number of files and the rows per file.  The assertions verify that the estimate is near-enough.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# ----------------------------------------------------------------------------------------------------
# Two tables, SAME partition count (4), row counts differing by 50x.
# small: 4 partitions x 1 file  x 1,000 rows/file  =   4,000 rows
# large: 4 partitions x 10 files x 5,000 rows/file = 200,000 rows
# ----------------------------------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.card_small;

statement ok
CREATE TABLE my_datalake.default.card_small (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.card_small SELECT i, 'd' || (i % 4) FROM generate_series(1,4000) t(i);

statement ok
DROP TABLE IF EXISTS my_datalake.default.card_large;

statement ok
CREATE TABLE my_datalake.default.card_large (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

# ten inserts -> ten files per partition, 5,000 rows each
loop i 0 10

statement ok
INSERT INTO my_datalake.default.card_large SELECT i, 'd' || (i % 4) FROM generate_series(1,20000) t(i);

endloop

# verifying load
query IIII
SELECT
    (SELECT count(*) FROM glue_partitions('my_datalake.default.card_small')),
    (SELECT count(*) FROM glue_partitions('my_datalake.default.card_large')),
    (SELECT count(*) FROM my_datalake.default.card_small),
    (SELECT count(*) FROM my_datalake.default.card_large);
----
4	4	4000	200000

# A 200,000-row table must have a six-digit estimate of row count. EXPLAIN renders thousands with a comma
# ("~200,000 rows"), so the six-figure bound is written over digits AND commas.
query II
EXPLAIN SELECT * FROM my_datalake.default.card_large;
----
physical_plan	<REGEX>:.*Read Parquet.*~[1-9][0-9,]{6,} rows.*

query II
EXPLAIN SELECT * FROM my_datalake.default.card_small;
----
physical_plan	<REGEX>:.*Read Parquet.*~[1-9],?[0-9]{0,3} rows.*

statement ok
DROP TABLE IF EXISTS my_datalake.default.card_wide;

statement ok
CREATE TABLE my_datalake.default.card_wide (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.card_wide SELECT i, 'd' || (i % 20) FROM generate_series(1,4000) t(i);

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.card_wide')), (SELECT count(*) FROM my_datalake.default.card_wide);
----
20	4000

# 4,000 rows spread over 20 partitions should still be estimated as 4,000 rows.
query II
EXPLAIN SELECT * FROM my_datalake.default.card_wide;
----
physical_plan	<REGEX>:.*Read Parquet.*~[1-9],?[0-9]{0,3} rows.*

statement ok
DROP TABLE my_datalake.default.card_small;

statement ok
DROP TABLE my_datalake.default.card_large;

statement ok
DROP TABLE my_datalake.default.card_wide;
