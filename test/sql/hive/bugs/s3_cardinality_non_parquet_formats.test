# name: test/sql/hive/bugs/s3_cardinality_non_parquet_formats.test
# description: S3 - a csv, json or avro Glue table is estimated at ONE row, whatever it holds.
# group: [bugs]
#
# The parquet law (1000 x listing_jobs x 2, see the sibling tests) does not apply to the other three
# formats the extension supports, and what they get instead is worse. read_csv / read_json / read_avro
# have no cardinality callback that yields anything for our file list, so MultiFileCardinality returns
# nullptr and LogicalGet::EstimateCardinality reaches its literal fallback: return 1.
#
# Measured: 4,000 rows in each of csv, json and avro, all estimated at ~1 row.
#
# This is the most damaging shape of the defect. A one-row estimate does not merely mis-order joins -- it
# tells the optimizer the table is a scalar. It becomes the build side of every join, gets broadcast, and
# is not worth parallelising. A billion-row csv table looks like one row.
#
# It also settles a design question. Three of the four supported formats are broken here, so the fix has
# to live somewhere all four share: HiveMultiFileList::GetCardinality, which is OUR file list and which
# MultiFileCardinality consults before any format-specific path. A fix in the parquet interface would
# leave this test red.
#
# Correct behaviour: the estimate reflects the table, in every format.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.fmt_csv;

statement ok
CREATE TABLE my_datalake.default.fmt_csv (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.fmt_csv SELECT i, 'd' || (i % 4) FROM generate_series(1,4000) t(i);

query I
SELECT count(*) FROM my_datalake.default.fmt_csv;
----
4000

# 4,000 rows must not be estimated as a scalar. Today: ~1 row.
query II
EXPLAIN SELECT * FROM my_datalake.default.fmt_csv;
----
physical_plan	<REGEX>:.*Read Csv.*~[1-9][0-9]{2,} rows.*

statement ok
DROP TABLE IF EXISTS my_datalake.default.fmt_json;

statement ok
CREATE TABLE my_datalake.default.fmt_json (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'json');

statement ok
INSERT INTO my_datalake.default.fmt_json SELECT i, 'd' || (i % 4) FROM generate_series(1,4000) t(i);

query II
EXPLAIN SELECT * FROM my_datalake.default.fmt_json;
----
physical_plan	<REGEX>:.*Read Json.*~[1-9][0-9]{2,} rows.*

statement ok
DROP TABLE my_datalake.default.fmt_csv;

statement ok
DROP TABLE my_datalake.default.fmt_json;
