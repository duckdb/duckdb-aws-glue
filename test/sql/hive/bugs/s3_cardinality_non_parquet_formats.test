physical_plan	<REGEX>:.*Read Json.*~1,000 rows.*

statement ok
CREATE TABLE my_datalake.default.json_p3 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'json');

loop i 0 3

statement ok
INSERT INTO my_datalake.default.json_p3 SELECT i, 'd' || (i % 4) FROM generate_series(1,400) t(i);

endloop

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.json_p3')), (SELECT count(*) FROM my_datalake.default.json_p3);
----
4	1200

query II
EXPLAIN SELECT * FROM my_datalake.default.json_p3;
----
physical_plan	<REGEX>:.*Read Json.*~1,200 rows.*

statement ok
CREATE TABLE my_datalake.default.json_skw (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'json');

statement ok
INSERT INTO my_datalake.default.json_skw SELECT i, 'd0' FROM generate_series(1,10) t(i);

statement ok
INSERT INTO my_datalake.default.json_skw SELECT i, 'd1' FROM generate_series(1,10) t(i);

loop i 0 3

statement ok
INSERT INTO my_datalake.default.json_skw SELECT i, 'd2' FROM generate_series(1,200) t(i);

endloop

statement ok
INSERT INTO my_datalake.default.json_skw SELECT i, 'd3' FROM generate_series(1,1800) t(i);

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.json_skw')), (SELECT count(*) FROM my_datalake.default.json_skw);
----
4	2420

# the same 60x under-estimate as csv, which is what says it is the shared extrapolation and not the reader
query II
EXPLAIN SELECT * FROM my_datalake.default.json_skw;
----
physical_plan	<REGEX>:.*Read Json.*~40 rows.*

# ----------------------------------------------------------------------------------------------------
# compressed csv -- the lines of a compressed prefix are noise, and its size is not the file's. gzip
# records the uncompressed size in its last four bytes, so the prefix is read decompressed and scaled
# by that; zstd records it only optionally, so it is not measured.
# ----------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE my_datalake.default.csv_gz (id INTEGER, v VARCHAR) WITH (format = 'csv');

# 20,000 rows, well past the 64KB prefix uncompressed, so the recorded size is what scales it
statement ok
COPY (SELECT i AS id, 'r' || (i % 7) AS v FROM generate_series(1,20000) t(i))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_gz/data.csv.gz' (FORMAT csv, HEADER false, COMPRESSION gzip);

query I
SELECT count(*) FROM my_datalake.default.csv_gz;
----
20000

# was ~16, from newline bytes in the compressed stream
query II
EXPLAIN SELECT * FROM my_datalake.default.csv_gz;
----
physical_plan	<REGEX>:.*Read Csv.*~2[0-3],[0-9]{3} rows.*

statement ok
CREATE TABLE my_datalake.default.csv_zst (id INTEGER, v VARCHAR) WITH (format = 'csv');

statement ok
COPY (SELECT i AS id, 'r' || (i % 7) AS v FROM generate_series(1,20000) t(i))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_zst/data.csv.zst' (FORMAT csv, HEADER false, COMPRESSION zstd);

query I
SELECT count(*) FROM my_datalake.default.csv_zst;
----
20000

# not measured: the format's own estimate
query II
EXPLAIN SELECT * FROM my_datalake.default.csv_zst;
----
physical_plan	<REGEX>:.*Read Csv.*~1 row.*

# snappy, lz4, bzip2 and deflate are not measured either. DuckDB writes none of them, so gzip bytes stand in
# under each extension; that is what one of these files looks like to the sampler, and a line count of them
# was ~16. Only EXPLAIN is run: the scan cannot decompress these codecs and fails on the first line.
foreach codec snappy lz4 bz2 deflate

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_{codec};

statement ok
CREATE TABLE my_datalake.default.csv_{codec} (id INTEGER, v VARCHAR) WITH (format = 'csv');

statement ok
COPY (SELECT i AS id, 'r' || (i % 7) AS v FROM generate_series(1,20000) t(i))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_{codec}/data.csv.{codec}' (FORMAT csv, HEADER false, COMPRESSION gzip);

query II
EXPLAIN SELECT * FROM my_datalake.default.csv_{codec};
----
physical_plan	<REGEX>:.*Read Csv.*~1 row.*

statement ok
DROP TABLE my_datalake.default.csv_{codec};

endloop

# ----------------------------------------------------------------------------------------------------
# avro -- SampleFile has no avro case, so no row count is ever measured and every shape below is
# estimated at ~1 row. The five shapes are kept anyway: they are what shows the estimate is not merely
# imprecise but entirely absent, and a fix has to move all five.
#
# Note the plan says "~1 row", singular, so a "~1 rows" pattern can never match it.
# ----------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE my_datalake.default.avro_un1 (id INTEGER, v VARCHAR) WITH (format = 'avro');

statement ok
INSERT INTO my_datalake.default.avro_un1 SELECT i, 'r' || (i % 7) FROM generate_series(1,1000) t(i);

query I
SELECT count(*) FROM my_datalake.default.avro_un1;
----
1000

query II
EXPLAIN SELECT * FROM my_datalake.default.avro_un1;
----
physical_plan	<REGEX>:.*Read Avro.*~1 row.*

