# name: test/sql/hive/bugs/s3_cardinality_non_parquet_formats.test
# description: S3 - a csv, json or avro Glue table must have card estimates that reflect the table.
# group: [bugs]

#
# Parquet reads its row count from the footer. The other formats have no footer. We use one sampled file
# for csv and json count lines. Avro is binary and Duck has no cardinality estimate for avro. We follow
# that in this extension. Tests vary partitioning, file count and row count per file.
#
#
#   unpartitioned, one file      -- the sample IS the table
#   unpartitioned, three files   -- one sample x file count
#   partitioned, one file each   -- file count comes from the partitions
#   partitioned, three files each
#   partitioned, skewed          -- partitions differing in BOTH files per partition and rows per file

require httpfs

require avro

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# the table names live in the shared 'default' Glue database, not under {TEST_DIR}, so a run that stopped
# before the drops at the end would otherwise fail the next one on CREATE rather than on what it tests
statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_un1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_un3;

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_p1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_p3;

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_skw;

statement ok
DROP TABLE IF EXISTS my_datalake.default.json_un1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.json_un3;

statement ok
DROP TABLE IF EXISTS my_datalake.default.json_p1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.json_p3;

statement ok
DROP TABLE IF EXISTS my_datalake.default.json_skw;

statement ok
DROP TABLE IF EXISTS my_datalake.default.avro_un1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.avro_un3;

statement ok
DROP TABLE IF EXISTS my_datalake.default.avro_p1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.avro_p3;

statement ok
DROP TABLE IF EXISTS my_datalake.default.avro_skw;

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_gz;

statement ok
DROP TABLE IF EXISTS my_datalake.default.csv_zst;

# ----------------------------------------------------------------------------------------------------
# csv
# ----------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE my_datalake.default.csv_un1 (id INTEGER, v VARCHAR) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.csv_un1 SELECT i, 'r' || (i % 7) FROM generate_series(1,1000) t(i);

# unpartitioned, one file: the sampled file is the whole table, so the estimate is exact.
# EXPLAIN renders thousands with a comma ("~1,000 rows").
query I
SELECT count(*) FROM my_datalake.default.csv_un1;
----
1000

query II
EXPLAIN SELECT * FROM my_datalake.default.csv_un1;
----
physical_plan	<REGEX>:.*Read Csv.*~1,000 rows.*

statement ok
CREATE TABLE my_datalake.default.csv_un3 (id INTEGER, v VARCHAR) WITH (format = 'csv');

# three inserts, three files of 400 in the table root
loop i 0 3

statement ok
INSERT INTO my_datalake.default.csv_un3 SELECT i, 'r' || (i % 7) FROM generate_series(1,400) t(i);

endloop

query I
SELECT count(*) FROM my_datalake.default.csv_un3;
----
1200

# unpartitioned, many files of one size: rows per file x file count, and both factors must be right.
query II
EXPLAIN SELECT * FROM my_datalake.default.csv_un3;
----
physical_plan	<REGEX>:.*Read Csv.*~1,200 rows.*

statement ok
CREATE TABLE my_datalake.default.csv_p1 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.csv_p1 SELECT i, 'd' || (i % 4) FROM generate_series(1,1000) t(i);

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.csv_p1')), (SELECT count(*) FROM my_datalake.default.csv_p1);
----
4	1000

# partitioned, one file per partition: the file count comes from the partition list, not a listing per file.
query II
EXPLAIN SELECT * FROM my_datalake.default.csv_p1;
----
physical_plan	<REGEX>:.*Read Csv.*~1,000 rows.*

statement ok
CREATE TABLE my_datalake.default.csv_p3 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'csv');

# three inserts over the same four partitions: 4 partitions x 3 files, 100 rows per file
loop i 0 3

statement ok
INSERT INTO my_datalake.default.csv_p3 SELECT i, 'd' || (i % 4) FROM generate_series(1,400) t(i);

endloop

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.csv_p3')), (SELECT count(*) FROM my_datalake.default.csv_p3);
----
4	1200

# many partitions AND many files per partition, all alike: still exact.
query II
EXPLAIN SELECT * FROM my_datalake.default.csv_p3;
----
physical_plan	<REGEX>:.*Read Csv.*~1,200 rows.*

# ----------------------------------------------------------------------------------------------------
# csv, skewed: the partitions differ in files per partition AND in rows per file
#
#   dt=d0  1 file      10 rows
#   dt=d1  1 file      10 rows
#   dt=d2  3 files    600 rows
#   dt=d3  1 file   1,800 rows
#
# Only the first partition is listed when the cost is asked for, so d0 sets the rate for the whole table:
# EstimateTotalFileCount extrapolates 1 file per partition x 4 = 4 files, and 10 rows x 4 = ~40 against a
# true 2,420. The byte-scaling guard in HiveScanCardinality (largest > smallest x 2) cannot help, because
# every file it can see comes from that one uniform partition.
# ----------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE my_datalake.default.csv_skw (id INTEGER, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.csv_skw SELECT i, 'd0' FROM generate_series(1,10) t(i);

statement ok
INSERT INTO my_datalake.default.csv_skw SELECT i, 'd1' FROM generate_series(1,10) t(i);

loop i 0 3

statement ok
INSERT INTO my_datalake.default.csv_skw SELECT i, 'd2' FROM generate_series(1,200) t(i);

endloop

statement ok
INSERT INTO my_datalake.default.csv_skw SELECT i, 'd3' FROM generate_series(1,1800) t(i);

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.csv_skw')), (SELECT count(*) FROM my_datalake.default.csv_skw);
----
4	2420

# the fixture really is uneven, in files as well as rows -- if these four counts ever even out the
# assertion below stops testing skew at all
query IIII
SELECT
    (SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_skw/dt=d0/*')),
    (SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_skw/dt=d1/*')),
    (SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_skw/dt=d2/*')),
    (SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/csv_skw/dt=d3/*'));
----
1	1	3	1

# 2,420 rows estimated at ~40 today: the smallest partition, extrapolated over a file count taken from it.
query II
EXPLAIN SELECT * FROM my_datalake.default.csv_skw;
----
physical_plan	<REGEX>:.*Read Csv.*~40 rows.*

# ----------------------------------------------------------------------------------------------------
# json -- the same five shapes. json is written one object per line, so it is line-counted like csv.
# ----------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE my_datalake.default.json_un1 (id INTEGER, v VARCHAR) WITH (format = 'json');

statement ok
INSERT INTO my_datalake.default.json_un1 SELECT i, 'r' || (i % 7) FROM generate_series(1,1000) t(i);

query I
SELECT count(*) FROM my_datalake.default.json_un1;
----
1000

query II
EXPLAIN SELECT * FROM my_datalake.default.json_un1;
----
physical_plan	<REGEX>:.*Read Json.*~1,000 rows.*

