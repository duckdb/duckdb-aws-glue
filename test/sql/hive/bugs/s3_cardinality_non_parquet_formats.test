statement ok
INSERT INTO my_datalake.default.json_p1 SELECT i, 'd' || (i % 4) FROM generate_series(1,1000) t(i);

query II
SELECT (SELECT count(*) FROM glue_partitions('my_datalake.default.json_p1')), (SELECT count(*) FROM my_datalake.default.json_p1);
----
4	1000

query II
EXPLAIN SELECT * FROM my_datalake.default.json_p1;
