# name: test/sql/hive/bugs/s3_cardinality_distinct_counts.test
# description: S3 - the columns of an unpartitioned parquet table get distinct counts from the footers of its files
# group: [bugs]

# Without them an equality filter keeps a flat 20% of the rows, and a join on low-cardinality columns is costed
# as if every value matched one row (TPC-DS q85 joined customer_demographics to itself on two such columns first).

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ndv_dim;

statement ok
CREATE TABLE my_datalake.default.ndv_dim AS
SELECT range AS id, 'v' || (range % 10) AS low, range % 4 AS small_int, 'name_' || range AS high
FROM range(100000);

# the row count is the sum of the footers' row counts
query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_dim;
----
physical_plan	<REGEX>:.*Hive Scan.*~100,000 rows.*

# ten values: a tenth of the rows, not a fifth
query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_dim WHERE low = 'v3';
----
physical_plan	<REGEX>:.*Hive Scan.*~10,000 rows.*

# an integer column: the width of its bounds
query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_dim WHERE small_int = 2;
----
physical_plan	<REGEX>:.*Hive Scan.*~25,000 rows.*

# a column without a dictionary and without integer bounds keeps the default selectivity
query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_dim WHERE high = 'name_7';
----
physical_plan	<REGEX>:.*Hive Scan.*~20,000 rows.*

# a key: the width of its bounds, one row per value
query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_dim WHERE id = 42;
----
physical_plan	<REGEX>:.*Hive Scan.*~1 row.*

# a self join on the low-cardinality column is costed as the many-to-many join it is
query II
EXPLAIN SELECT count(*) FROM my_datalake.default.ndv_dim a, my_datalake.default.ndv_dim b WHERE a.low = b.low AND a.id < 10;
----
physical_plan	<REGEX>:.*Hash Join.*~[0-9]{2},[0-9]{3} rows.*

# the statistics are only a distinct count: no min/max, so nothing is pruned on them
query IIII
SELECT count(*), count(DISTINCT low), min(id), max(id) FROM my_datalake.default.ndv_dim WHERE small_int = 3 OR id = 99999;
----
25000	5	3	99999

query I
SELECT count(*) FROM my_datalake.default.ndv_dim a, my_datalake.default.ndv_dim b WHERE a.low = b.low AND a.id < 10;
----
100000

# ----------------------------------------------------------------------------------------------------
# Several files: their footers together. Two inserts of the same four values, as the threads of one write produce
# them: the files' dictionaries overlap, so the count is the largest of them, not their sum.
# ----------------------------------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.ndv_files;

statement ok
CREATE TABLE my_datalake.default.ndv_files (id BIGINT, v VARCHAR);

statement ok
INSERT INTO my_datalake.default.ndv_files SELECT range, 'v' || (range % 4) FROM range(50000);

statement ok
INSERT INTO my_datalake.default.ndv_files SELECT range + 50000, 'v' || (range % 4) FROM range(50000);

query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_files;
----
physical_plan	<REGEX>:.*Hive Scan.*~100,000 rows.*

query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_files WHERE v = 'v3';
----
physical_plan	<REGEX>:.*Hive Scan.*~25,000 rows.*

query II
SELECT count(*), count(DISTINCT v) FROM my_datalake.default.ndv_files WHERE id >= 25000;
----
75000	4

# ----------------------------------------------------------------------------------------------------
# A partitioned table: one file per partition says nothing about the others, so its data columns get none
# ----------------------------------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.ndv_part;

statement ok
CREATE TABLE my_datalake.default.ndv_part PARTITIONED BY (p) AS SELECT range AS id, 'v' || (range % 10) AS low, range % 3 AS p FROM range(30000);

query II
EXPLAIN SELECT * FROM my_datalake.default.ndv_part WHERE low = 'v3';
----
physical_plan	<REGEX>:.*Hive Scan.*~6,000 rows.*

statement ok
DROP TABLE my_datalake.default.ndv_dim;

statement ok
DROP TABLE my_datalake.default.ndv_files;

statement ok
DROP TABLE my_datalake.default.ndv_part;
