# name: test/sql/hive/bugs/s3_hive_scan_files_no_listing.test
# description: S3 guard - a hive_scan given its files sends no LIST, to plan, to estimate or to read
# group: [bugs]

require httpfs

require glue

require-env DEFAULT_S3_LOCATION

statement ok
COPY (SELECT * FROM (VALUES (1, 'd1'), (2, 'd1'), (3, 'd2')) t(id, dt))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs' (FORMAT parquet, PARTITION_BY (dt));

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d1/extra.parquet' (FORMAT parquet);

# the listed prefix is in the URL's query string, which HTTP logs redact by default
statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

# listing the partitions sends LISTs
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs', schema := {id: 'INTEGER', dt: 'VARCHAR'},
    partitions := [{dt: 'd1'}, {dt: 'd2'}]);
----
4

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
true

# given the files, planning (the row-count sample included) and reading send none
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs', schema := {id: 'INTEGER', dt: 'VARCHAR'},
    partitions := [{dt: 'd1', files: ['{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d1/data_0.parquet']},
                   {dt: 'd2', files: ['{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d2/data_0.parquet']}]);

query II
SELECT dt, count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs', schema := {id: 'INTEGER', dt: 'VARCHAR'},
    partitions := [{dt: 'd1', files: ['{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d1/data_0.parquet']},
                   {dt: 'd2', files: ['{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d2/data_0.parquet']}])
GROUP BY dt ORDER BY dt;
----
d1	2
d2	1

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
0

# the same for an unpartitioned table
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d1', schema := {id: 'INTEGER'},
    files := ['{DEFAULT_S3_LOCATION}/{TEST_DIR}/hfs/dt=d1/extra.parquet']);
----
1

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
0
