# name: test/sql/hive/bugs/s3_multi_key_partition_statistics.test
# description: With TWO partition keys, each key's statistics must describe that key, and neither may prune the other's rows.
# group: [bugs]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.mkey;

statement ok
CREATE TABLE my_datalake.default.mkey (id INTEGER, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

# 2 dt values x 3 country values = 6 partitions, deliberately disjoint value ranges per key
statement ok
INSERT INTO my_datalake.default.mkey SELECT i, 'd' || (i % 2), 'c' || (i % 3) FROM generate_series(1,600) t(i);

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.mkey');
----
6

# a filter on the FIRST key finds its rows
query I
SELECT count(*) FROM my_datalake.default.mkey WHERE dt = 'd1';
----
300

# a filter on the SECOND key finds its rows -- this is what an off-by-one in the key index breaks
query I
SELECT count(*) FROM my_datalake.default.mkey WHERE country = 'c2';
----
200

# both keys together
query I
SELECT count(*) FROM my_datalake.default.mkey WHERE dt = 'd1' AND country = 'c2';
----
100

# a value that exists for one key but is nonsense for the other must not be confused with it
query I
SELECT count(*) FROM my_datalake.default.mkey WHERE country = 'd1';
----
0

# ----------------------------------------------------------------------------------------------------
# The same predicates as estimates. Pushed-down equality gets a flat DEFAULT_SELECTIVITY of
# 0.2, because a filter on a partition column is not recognised as already true of every row that
# survived pruning. Each equality below is that 0.2 away from the truth.
# ----------------------------------------------------------------------------------------------------

# no predicate: every partition, and the estimate is the table
query II
EXPLAIN SELECT * FROM my_datalake.default.mkey;
----
physical_plan	<REGEX>:.*Read Parquet.*~600 rows.*

# FIRST key: 3 partitions of 6, holding 300 rows
query II
EXPLAIN SELECT * FROM my_datalake.default.mkey WHERE dt = 'd1';
----
physical_plan	<REGEX>:.*Read Parquet.*Scanning Files: 3/6.*~60 rows.*

# SECOND key: 2 of 6, holding 200. An off-by-one in the key index would prune the wrong ones
query II
EXPLAIN SELECT * FROM my_datalake.default.mkey WHERE country = 'c2';
----
physical_plan	<REGEX>:.*Read Parquet.*Scanning Files: 2/6.*~40 rows.*

# BOTH keys: down to the one partition they intersect in, holding 100. Still a single 0.2, not two
query II
EXPLAIN SELECT * FROM my_datalake.default.mkey WHERE dt = 'd1' AND country = 'c2';
----
physical_plan	<REGEX>:.*Read Parquet.*Scanning Files: 1/6.*~20 rows.*

# the other key's value: nothing survives, and 0 needs no selectivity to be right
query II
EXPLAIN SELECT * FROM my_datalake.default.mkey WHERE country = 'd1';
----
physical_plan	<REGEX>:.*Read Parquet.*Scanning Files: 0/6.*~0 rows.*

# an IN IS pushed into the scan but it arrives as an OPTIONAL
# filter, and the 0.2 is only applied when a non-optional filter is present.
query II
EXPLAIN SELECT * FROM my_datalake.default.mkey WHERE country IN ('c0','c1');
----
physical_plan	<REGEX>:.*Read Parquet.*Scanning Files: 4/6.*~400 rows.*

# three distinct countries, so three groups -- exact, because the partition values are the complete set
query II
EXPLAIN SELECT country, count(*) FROM my_datalake.default.mkey GROUP BY country;
----
physical_plan	<REGEX>:.*Hash Group By.*~3 rows.*

statement ok
DROP TABLE my_datalake.default.mkey;
