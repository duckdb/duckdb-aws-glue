# name: test/sql/hive/hive_scan/hive_scan_csv_options.test
# description: hive_scan() reads csv as a Glue text table does with skip, serde_fields, null_for_invalid_data and parallel (no catalog, no cloud)
# group: [hive_scan]

require glue

# two header lines, a short row, a field that does not parse and a field beyond the last column
statement ok
COPY (SELECT * FROM (VALUES ('generated by a job'), ('id,name,amount'), ('1,a,1.5'), ('2,b'), ('3,c,oops'), ('4,d,4.5,extra')) t(line))
TO '{TEST_DIR}/csvo' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', PER_THREAD_OUTPUT true);

# read_csv rules: the short row fails the scan
statement error
SELECT * FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});
----
<REGEX>:.*Expected Number of Columns: 3 Found: 2.*

# serde_fields: the short row is padded with NULL, the field that does not parse is NULL and the extra one is ignored
query III
SELECT id, name, amount FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, serde_fields := true,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'})
ORDER BY id;
----
1	a	1.5
2	b	NULL
3	c	NULL
4	d	4.5

# skip is the number of header lines, header := true one
query II
SELECT count(*), count(id) FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 1, serde_fields := true,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});
----
5	4

query II
SELECT count(*), count(id) FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', header := true, serde_fields := true,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});
----
5	4

query I
SELECT count(*) FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 0, serde_fields := true,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});
----
6

# null_for_invalid_data := false: the field that does not parse fails the query, as in an OpenCSVSerde table
statement error
SELECT id, name, amount FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, serde_fields := true,
    null_for_invalid_data := false, schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});
----
<REGEX>:.*Could not convert string 'oops' to DOUBLE.*

# only the columns read are converted
query II
SELECT id, name FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, serde_fields := true,
    null_for_invalid_data := false, schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'})
ORDER BY id;
----
1	a
2	b
3	c
4	d

#---------------------------------------------------------------------------
# parallel: a quoted line break next to the NULL padding of a short row, which the parallel scanner refuses
#---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM (VALUES ('1,"two' || chr(10) || 'lines"'), ('2,after'), ('3')) t(line))
TO '{TEST_DIR}/csvo_nl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', PER_THREAD_OUTPUT true);

statement error
SELECT id, name FROM hive_scan('{TEST_DIR}/csvo_nl', format := 'csv', serde_fields := true, schema := {id: 'INTEGER', name: 'VARCHAR'});
----
<REGEX>:.*parallel scanner does not support null_padding in conjunction with quoted new lines.*

# one thread per file reads the field as one value
query III
SELECT id, replace(name, chr(10), '<nl>'), name IS NULL FROM hive_scan('{TEST_DIR}/csvo_nl', format := 'csv', serde_fields := true,
    parallel := false, schema := {id: 'INTEGER', name: 'VARCHAR'})
ORDER BY id;
----
1	two<nl>lines	false
2	after	false
3	NULL	true

# hive_csv_parallel is the default, which the argument overrides
statement ok
SET hive_csv_parallel = false;

query II
SELECT id, replace(name, chr(10), '<nl>') FROM hive_scan('{TEST_DIR}/csvo_nl', format := 'csv', serde_fields := true,
    schema := {id: 'INTEGER', name: 'VARCHAR'})
ORDER BY id;
----
1	two<nl>lines
2	after
3	NULL

statement error
SELECT id, name FROM hive_scan('{TEST_DIR}/csvo_nl', format := 'csv', serde_fields := true, parallel := true,
    schema := {id: 'INTEGER', name: 'VARCHAR'});
----
<REGEX>:.*parallel scanner does not support null_padding in conjunction with quoted new lines.*

statement ok
RESET hive_csv_parallel;

#---------------------------------------------------------------------------
# the arguments are part of the plan: a deserialized plan reads the same way
#---------------------------------------------------------------------------
statement ok
SET debug_verify_serializer = true;

query III
SELECT id, replace(name, chr(10), '<nl>'), name IS NULL FROM hive_scan('{TEST_DIR}/csvo_nl', format := 'csv', serde_fields := true,
    parallel := false, schema := {id: 'INTEGER', name: 'VARCHAR'})
ORDER BY id;
----
1	two<nl>lines	false
2	after	false
3	NULL	true

query III
SELECT id, name, amount FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, serde_fields := true,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'})
ORDER BY id;
----
1	a	1.5
2	b	NULL
3	c	NULL
4	d	4.5

statement error
SELECT id, name, amount FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, serde_fields := true,
    null_for_invalid_data := false, schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});
----
<REGEX>:.*Could not convert string 'oops' to DOUBLE.*

statement ok
SET debug_verify_serializer = false;

#---------------------------------------------------------------------------
# what is refused
#---------------------------------------------------------------------------
statement error
SELECT * FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', header := true, skip := 2, schema := {id: 'INTEGER'});
----
<REGEX>:Binder Error.*give either 'header' or 'skip'.*

statement error
SELECT * FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := -1, schema := {id: 'INTEGER'});
----
<REGEX>:Binder Error.*'skip' must not be negative.*

statement error
SELECT * FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', skip := 2, null_for_invalid_data := true, schema := {id: 'INTEGER'});
----
<REGEX>:Binder Error.*'null_for_invalid_data' needs serde_fields := true.*

foreach argument header skip delim nullstr serde_fields null_for_invalid_data parallel ignore_errors

statement error
SELECT * FROM hive_scan('{TEST_DIR}/csvo', format := 'csv', {argument} := NULL, schema := {id: 'INTEGER'});
----
<REGEX>:Binder Error.*hive_scan: '[a-z_]+' must not be NULL.*

endloop
