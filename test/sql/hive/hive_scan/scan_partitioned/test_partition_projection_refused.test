# name: test/sql/hive/hive_scan/scan_partitioned/test_partition_projection_refused.test
# description: A partitioned table with Athena partition projection (projection.enabled) is read through its derived partitions; CREATE TABLE ... AS with projection parameters is refused
# group: [scan_partitioned]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_events;

statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_flat;

statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_ctas;

# the table has data Athena reads through its projection, and no registered partition (the derivation itself is covered
# by test_partition_projection.test)
statement ok
CREATE TABLE my_datalake.default.pp_events (id INTEGER, region VARCHAR, hour INTEGER) PARTITIONED BY (region, hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events',
    'projection.enabled' = 'true',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu',
    'projection.hour.type' = 'integer',
    'projection.hour.range' = '0,23'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region=us/hour=7/a.parquet';

# a read derives the partitions from the parameters and finds the file
query III
SELECT id, region, hour FROM my_datalake.default.pp_events;
----
1	us	7

query I
SELECT count(*) FROM my_datalake.default.pp_events WHERE region = 'us';
----
1

# INSERT writes the projected layout (test/sql/hive/dml/insert/insert_partition_projection.test); CREATE TABLE ... AS
# with projection parameters is refused before anything is created, as Athena's CTAS takes no projection property
statement error
CREATE TABLE my_datalake.default.pp_ctas PARTITIONED BY (region)
WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_ctas', 'projection.enabled' = 'true', 'projection.region.type' = 'enum', 'projection.region.values' = 'us,eu')
AS SELECT 1 AS id, 'us' AS region;
----
Not implemented Error: CREATE TABLE ... AS for Glue table 'pp_ctas' is not supported: Athena partition projection cannot be configured by CTAS. CREATE TABLE with the projection.* parameters, then INSERT

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'pp_ctas';
----
0

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_ctas/**');
----
0

# DESCRIBE binds the scan without deriving the partitions; the definition is readable through the catalog and the raw
# response
statement ok
DESCRIBE my_datalake.default.pp_events;

query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'pp_events' ORDER BY column_index;
----
id
region
hour

query I
SELECT parameters['projection.enabled'] FROM glue_get_table_response('my_datalake.default.pp_events');
----
true

# the value is matched trimmed and case-insensitively, as Athena does: still read through the projection
statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.enabled' = ' TRUE ');

query I
SELECT count(*) FROM my_datalake.default.pp_events;
----
1

# hive_scan without the catalog takes an explicit partition list and is unaffected
query II
SELECT id, region FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events', schema := {id: 'INTEGER', region: 'VARCHAR', hour: 'INTEGER'},
    partitions := [{region: 'us', hour: '7'}]);
----
1	us

# projection off: the registered partitions are read again, none here
statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.enabled' = 'false');

query I
SELECT count(*) FROM my_datalake.default.pp_events;
----
0

statement ok
CALL glue_add_partition('my_datalake.default.pp_events', {region: 'us', hour: 7});

query III
SELECT id, region, hour FROM my_datalake.default.pp_events;
----
1	us	7

statement ok
INSERT INTO my_datalake.default.pp_events VALUES (2, 'eu', 3);

query I
SELECT count(*) FROM my_datalake.default.pp_events;
----
2

# projection.* parameters on an unpartitioned table change nothing
statement ok
CREATE TABLE my_datalake.default.pp_flat (id INTEGER) WITH ('projection.enabled' = 'true');

statement ok
INSERT INTO my_datalake.default.pp_flat VALUES (1);

query I
SELECT id FROM my_datalake.default.pp_flat;
----
1

statement ok
DROP TABLE my_datalake.default.pp_events;

statement ok
DROP TABLE my_datalake.default.pp_flat;
