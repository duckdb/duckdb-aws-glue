statement ok
COPY (SELECT 12 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=a*/b.parquet';

statement ok
COPY (SELECT 13 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=a?c/c.parquet';

statement ok
