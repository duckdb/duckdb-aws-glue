statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.interval.unit' = 'YEARS');

# source: Athena ProjectedDateTimeColumn.isValueInDomain parses the directory text back with the format (a Year reads as
# its January 1st), so a DATE column over 'yyyy' stepped by weeks is one partition per year valued at the year's start,
# whichever week first lands in it (2021-01-06 for 2020-01-01 stepped by 7 days); the week after 2021-12-29 is past
# the upper bound 2022, so y=2022 is not derived: two partitions
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_year_date;

statement ok
CREATE TABLE my_datalake.default.pp_year_date (id INTEGER, y DATE) PARTITIONED BY (y)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_year_date',
    'projection.enabled' = 'true',
    'projection.y.type' = 'date',
    'projection.y.format' = 'yyyy',
    'projection.y.range' = '2020,2022',
    'projection.y.interval' = '7',
    'projection.y.interval.unit' = 'DAYS'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_year_date/y=2021/a.parquet';

query II
SELECT id, y FROM my_datalake.default.pp_year_date;
----
1	2021-01-01

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_year_date WHERE y = DATE '2021-01-01';
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/2.*

statement ok
DROP TABLE my_datalake.default.pp_year_date;

# source: Athena supported-types.html "Date type" - projection.<col>.interval is an integer; a decimal is an error
statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.interval' = '1.5', 'projection.y.interval.unit' = 'YEARS');

statement error
SELECT id FROM my_datalake.default.pp_year;
----
projection.y.interval must be a positive integer, got '1.5'

# deriving the partitions honours max_execution_time: a millisecond step over a month format is 7.9 billion steps
# for four partitions (no build finishes that inside the deadline, and the statement ends at the deadline either
# way), and the derivation runs at bind, inside the query's deadline (as DuckDB's own binder and optimizer loops do
# with ClientContext::InterruptCheck)
statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.format' = 'yyyy-MM', 'projection.y.range' = '2020-01,2020-04', 'projection.y.interval' = '1', 'projection.y.interval.unit' = 'MILLIS');

statement ok
SET max_execution_time = 500;

statement error
SELECT count(*) FROM my_datalake.default.pp_year;
----
Query exceeded maximum execution time

statement ok
RESET max_execution_time;

statement ok
DROP TABLE my_datalake.default.pp_year;

#---------------------------------------------------------------------------
# integer, enum, TIMESTAMP and DATE keys, template shapes, an unpartitioned table
#---------------------------------------------------------------------------
# integer keys: the sign counts in the digits width (-5 under digits 2, -05 under 3), digits is a minimum width (100
# under digits 2), a '+' sign is accepted, an interval beyond the range leaves the lower bound alone; parameter values
# are read in any case
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_int;

statement ok
CREATE TABLE my_datalake.default.pp_par_int (id INTEGER, n INTEGER) PARTITIONED BY (n)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_int',
    'projection.enabled' = 'TRUE',
    'projection.n.type' = 'Integer',
    'projection.n.range' = '-5,5',
    'projection.n.interval' = '5',
    'projection.n.digits' = '2'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_int/n=-05/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_int/n=00/b.parquet';

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_int/n=-5/c.parquet';

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_int/n=100/d.parquet';

statement ok
COPY (SELECT 5 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_int/n=0/e.parquet';

query II
SELECT id, n FROM my_datalake.default.pp_par_int ORDER BY id;
----
2	0
3	-5

statement ok
ALTER TABLE my_datalake.default.pp_par_int SET ('projection.n.digits' = '3');

query II
SELECT id, n FROM my_datalake.default.pp_par_int ORDER BY id;
----
1	-5

statement ok
ALTER TABLE my_datalake.default.pp_par_int SET ('projection.n.range' = '95,105', 'projection.n.digits' = '2');

query II
SELECT id, n FROM my_datalake.default.pp_par_int ORDER BY id;
----
4	100

statement ok
ALTER TABLE my_datalake.default.pp_par_int SET ('projection.n.range' = '+0,+3', 'projection.n.digits' = '1');

query II
SELECT id, n FROM my_datalake.default.pp_par_int ORDER BY id;
----
5	0

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_par_int WHERE n > 1;
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 0/1.*

statement ok
ALTER TABLE my_datalake.default.pp_par_int SET ('projection.n.interval' = '1');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_par_int WHERE n = 0;
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/4.*

# an enum on an INTEGER column: the directory spells the value as written, the column reads the number
statement ok
ALTER TABLE my_datalake.default.pp_par_int SET ('projection.n.type' = 'ENUM', 'projection.n.values' = '01,100,33');

query II
SELECT id, n FROM my_datalake.default.pp_par_int WHERE n = 100 ORDER BY id;
----
4	100

statement ok
DROP TABLE my_datalake.default.pp_par_int;

# the integer loop stops where the next step would overflow, and digits pad the smallest integer behind its sign
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_big;

statement ok
CREATE TABLE my_datalake.default.pp_par_big (id INTEGER, n BIGINT) PARTITIONED BY (n)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_big',
    'projection.enabled' = 'true',
    'projection.n.type' = 'integer',
    'projection.n.range' = '0,9223372036854775807',
    'projection.n.interval' = '9223372036854775807'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_big/n=9223372036854775807/a.parquet';

statement ok
CALL truncate_duckdb_logs();

query II
SELECT id, n FROM my_datalake.default.pp_par_big;
----
1	9223372036854775807

query I
SELECT DISTINCT dir FROM listed_dirs() ORDER BY dir;
----
pp_par_big/n=0/
pp_par_big/n=9223372036854775807/

statement ok
ALTER TABLE my_datalake.default.pp_par_big SET ('projection.n.range' = '-9223372036854775808,-9223372036854775807', 'projection.n.interval' = '1', 'projection.n.digits' = '21');

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_big/n=-09223372036854775808/b.parquet';

query II
SELECT id, n FROM my_datalake.default.pp_par_big ORDER BY id;
----
2	-9223372036854775808

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_par_big WHERE n = -9223372036854775807;
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/2.*

statement ok
DROP TABLE my_datalake.default.pp_par_big;

# enum white space is part of the value (' eu ' is not 'eu'); values may be any UTF-8 text
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_str;

statement ok
CREATE TABLE my_datalake.default.pp_par_str (id INTEGER, k VARCHAR) PARTITIONED BY (k)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_str',
    'projection.enabled' = 'true',
    'projection.k.type' = 'enum',
    'projection.k.values' = 'us, eu ,日本'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_str/k=us/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_str/k= eu /b.parquet';

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_str/k=eu/c.parquet';

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_str/k=日本/d.parquet';

query II
SELECT id, k FROM my_datalake.default.pp_par_str ORDER BY id;
----
1	us
2	 eu 
4	日本

statement ok
DROP TABLE my_datalake.default.pp_par_str;

# a TIMESTAMP column reads any format as a timestamp; the grid starts at the lower bound (05, 11, 17; 18 is not a step)
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_ts;

statement ok
CREATE TABLE my_datalake.default.pp_par_ts (id INTEGER, ts TIMESTAMP) PARTITIONED BY (ts)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts',
    'projection.enabled' = 'true',
    'projection.ts.type' = 'date',
    'projection.ts.format' = 'yyyy-MM-dd-HH',
    'projection.ts.range' = '2024-01-01-05,2024-01-01-18',
    'projection.ts.interval' = '6',
    'projection.ts.interval.unit' = 'HOURS'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts/ts=2024-01-01-05/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts/ts=2024-01-01-06/b.parquet';

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts/ts=2024-01-01-17/c.parquet';

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts/ts=2024-01-01-18/d.parquet';

query II
SELECT id, ts FROM my_datalake.default.pp_par_ts WHERE ts > TIMESTAMP '2024-01-01 06:00:00' ORDER BY id;
----
3	2024-01-01 17:00:00

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_par_ts WHERE ts = TIMESTAMP '2024-01-01 05:00:00';
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/3.*

# Hive's own timestamp format, with a space and colons in the directory name
statement ok
ALTER TABLE my_datalake.default.pp_par_ts SET ('projection.ts.format' = 'yyyy-MM-dd HH:mm:ss', 'projection.ts.range' = '2024-01-01 00:00:00,2024-01-01 03:00:00', 'projection.ts.interval' = '1');

statement ok
COPY (SELECT 5 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts/ts=2024-01-01 01:00:00/e.parquet';

statement ok
COPY (SELECT 6 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_ts/ts=2024-01-01 02:30:00/f.parquet';

query II
SELECT id, ts FROM my_datalake.default.pp_par_ts ORDER BY id;
----
5	2024-01-01 01:00:00

statement ok
DROP TABLE my_datalake.default.pp_par_ts;

# a DATE column: an enum of dates, and a date range pruned by BETWEEN and >
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_date;

statement ok
CREATE TABLE my_datalake.default.pp_par_date (id INTEGER, dt DATE) PARTITIONED BY (dt)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_date',
    'projection.enabled' = 'true',
    'projection.dt.type' = 'enum',
    'projection.dt.values' = '2024-01-01,2024-01-03'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_date/dt=2024-01-01/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_date/dt=2024-01-03/b.parquet';

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_date/dt=2024-01-06/c.parquet';

query II
