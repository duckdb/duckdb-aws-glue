# a finer step repeats a directory only in consecutive steps (the formatted sequence never wraps), so comparing with
# the previous directory deduplicates exactly: 25 days over yyyy-MM land twice in January and in May, 5 partitions
statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.format' = 'yyyy-MM', 'projection.y.range' = '2024-01,2024-06', 'projection.y.interval' = '25', 'projection.y.interval.unit' = 'DAYS');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_year WHERE y = '2024-05';
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/5.*

# the date loop stops where the next step would leave the timestamp range; a bound outside it is not a date
statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.format' = 'yyyy', 'projection.y.range' = '294240,294247', 'projection.y.interval' = '1', 'projection.y.interval.unit' = 'YEARS');

