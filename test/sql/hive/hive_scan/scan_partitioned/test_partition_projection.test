# name: test/sql/hive/hive_scan/scan_partitioned/test_partition_projection.test
# description: A partitioned table with Athena partition projection (projection.enabled) scans the partitions derived
# group: [scan_partitioned]

#              from the projection.* parameters, as Athena does: enum, integer and date keys, located by
#              storage.location.template or the <key>=<value> layout. Registered partitions are ignored.

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET enable_external_file_cache=false;

# The Glue API calls since the last truncate_duckdb_logs(), by operation
statement ok
CREATE MACRO glue_calls() AS TABLE
    SELECT regexp_extract(request.headers['x-amz-target'], 'AWSGlue\.(\w+)', 1) AS api, count(*) AS n
    FROM duckdb_logs_parsed('HTTP')
    WHERE request.headers['x-amz-target'] IS NOT NULL
    GROUP BY 1 ORDER BY 1;

# The directories listed since the last truncate_duckdb_logs(): the S3 ListObjectsV2 requests in the HTTP log, with
# the listed prefix decoded and made relative to the test's own prefix
statement ok
CREATE MACRO listed_dirs() AS TABLE
    SELECT regexp_replace(split_part(url_decode(regexp_extract(request.url, 'prefix=([^&]*)', 1)), '/duckdb_unittest_tempdir/', 2), '^[^/]+/[^/]+/', '') AS dir
    FROM duckdb_logs_parsed('HTTP')
    WHERE request.url LIKE '%list-type=2%';

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

#---------------------------------------------------------------------------
# enum x integer: the cross product of the keys' values, at <key>=<value> below the table location
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_events;

statement ok
CREATE TABLE my_datalake.default.pp_events (id INTEGER, region VARCHAR, hour INTEGER) PARTITIONED BY (region, hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events',
    'projection.enabled' = 'true',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu',
    'projection.hour.type' = 'integer',
    'projection.hour.range' = '0,23'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region=us/hour=7/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region=eu/hour=23/b.parquet';

# directories outside the projected values are not part of the table
statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region=apac/hour=7/c.parquet';

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region=us/hour=24/d.parquet';

statement ok
CALL truncate_duckdb_logs();

query III
SELECT id, region, hour FROM my_datalake.default.pp_events ORDER BY id;
----
1	us	7
2	eu	23

# the partitions come from the parameters: Glue is never asked for them
query I
SELECT api FROM glue_calls() WHERE api = 'GetPartitions';
----

# a projected partition without files holds no rows, a value outside the range is not an error
query I
SELECT count(*) FROM my_datalake.default.pp_events WHERE region = 'eu' AND hour = 0;
----
0

query I
SELECT count(*) FROM my_datalake.default.pp_events WHERE hour = 99;
----
0

# the table binds like any other
query I
SELECT column_name FROM (DESCRIBE my_datalake.default.pp_events);
----
id
region
hour

#---------------------------------------------------------------------------
# registered partitions are ignored while the projection is on
#---------------------------------------------------------------------------
statement ok
CALL glue_add_partition('my_datalake.default.pp_events', {region: 'apac', hour: 7});

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.pp_events');
----
1

query I
SELECT count(*) FROM my_datalake.default.pp_events;
----
2

statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.enabled' = 'false');

query II
SELECT id, region FROM my_datalake.default.pp_events;
----
3	apac

statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.enabled' = 'true');

#---------------------------------------------------------------------------
# enum values: split on commas, white space is part of the value
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.region.values' = 'us, eu');

statement ok
COPY (SELECT 5 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region= eu/hour=1/e.parquet';

query II
SELECT id, length(region) FROM my_datalake.default.pp_events WHERE region = ' eu';
----
5	3

query I
SELECT count(*) FROM my_datalake.default.pp_events WHERE region = 'eu';
----
0

statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.region.values' = 'us,eu');

#---------------------------------------------------------------------------
# integer: digits zero-pad the directory value, interval steps the range
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.hour.digits' = '2');

statement ok
COPY (SELECT 6 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_events/region=us/hour=07/f.parquet';

# hour=7 is no longer a projected directory, hour=07 is
query II
SELECT id, hour FROM my_datalake.default.pp_events WHERE region = 'us' AND hour = 7;
----
6	7

statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.hour.range' = ' 10 , 30 ', 'projection.hour.interval' = ' 10 ');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_events WHERE hour IN (10, 30);
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 4/6.*

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_events WHERE hour = 15;
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 0/6.*

statement ok
ALTER TABLE my_datalake.default.pp_events SET ('projection.hour.range' = '0,23', 'projection.hour.interval' = '1', 'projection.hour.digits' = '1');

query I
SELECT count(*) FROM my_datalake.default.pp_events;
----
2

statement ok
DROP TABLE my_datalake.default.pp_events;

#---------------------------------------------------------------------------
# date: the left bound stepped by the interval up to the right bound, bounds inclusive; a DATE column reads the value
# as a date whatever the directory format
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_daily;

statement ok
CREATE TABLE my_datalake.default.pp_daily (id INTEGER, dt DATE) PARTITIONED BY (dt)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_daily',
    'projection.enabled' = 'true',
    'projection.dt.type' = 'date',
    'projection.dt.format' = 'yyyy-MM-dd',
    'projection.dt.range' = '2024-01-30,2024-02-02'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_daily/dt=2024-01-31/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_daily/dt=2024-02-02/b.parquet';

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_daily/dt=2024-02-03/c.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_daily ORDER BY id;
----
1	2024-01-31
2	2024-02-02

# a day-precision format defaults to an interval of 1 DAYS: four partitions
query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_daily WHERE dt IN (DATE '2024-01-30', DATE '2024-02-01', DATE '2024-02-29');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/4.*

# a month-precision format steps by one month; an interval without its unit is ignored, as Athena reads the two only
# together (2 here, still five partitions); the DATE value is the first of the month
statement ok
ALTER TABLE my_datalake.default.pp_daily SET ('projection.dt.format' = 'yyyy-MM', 'projection.dt.range' = '2024-01,2024-05', 'projection.dt.interval' = '2');

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_daily/dt=2024-03/d.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_daily ORDER BY id;
----
4	2024-03-01

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_daily WHERE dt IN (DATE '2024-01-01', DATE '2024-02-01', DATE '2024-05-01');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 3/5.*

# stepping by months clamps the day to the month's length and carries on from there, as Java's plusMonths does:
# 01-31, 02-29, 03-29, 04-29
statement ok
ALTER TABLE my_datalake.default.pp_daily SET ('projection.dt.format' = 'yyyy-MM-dd', 'projection.dt.range' = '2024-01-31,2024-04-30', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'MONTHS');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_daily WHERE dt IN (DATE '2024-02-29', DATE '2024-03-29', DATE '2024-03-31', DATE '2024-04-30');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/4.*

# both bounds are truncated to the format's precision before stepping: equal bounds project one partition; the unit
# is read in any case
statement ok
ALTER TABLE my_datalake.default.pp_daily SET ('projection.dt.format' = 'yyyy-MM', 'projection.dt.range' = '2024-07,2024-07', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'months');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.pp_daily;
----
0

query I
SELECT DISTINCT dir FROM listed_dirs();
----
pp_daily/dt=2024-07/

statement ok
DROP TABLE my_datalake.default.pp_daily;

# hour precision: interval.unit is required, the string column holds the formatted value
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_hourly;

statement ok
CREATE TABLE my_datalake.default.pp_hourly (id INTEGER, dt VARCHAR) PARTITIONED BY (dt)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly',
    'projection.enabled' = 'true',
    'projection.dt.type' = 'date',
    'projection.dt.format' = 'yyyy-MM-dd-HH',
    'projection.dt.range' = '2024-01-01-00,2024-01-01-18',
    'projection.dt.interval' = '6',
    'projection.dt.interval.unit' = 'HOURS'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=2024-01-01-06/a.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
1	2024-01-01-06

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN ('2024-01-01-00', '2024-01-01-12', '2024-01-01-18', '2024-01-01-03');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 3/4.*

#---------------------------------------------------------------------------
# date format letters: Java's widths, text months, fractions and quoted literals
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyyMMdd', 'projection.dt.range' = '20240105,20240107', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'DAYS');

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=20240106/b.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
2	20240106

# three or more letters of y read at least that many digits
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyy-M', 'projection.dt.range' = '2024-1,2024-3', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'MONTHS');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN ('2024-1', '2024-3', '2024-4');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/3.*

# one letter is the minimum number of digits, yy the last two digits of the year; a '/' in the value nests directories
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'd/M/yy', 'projection.dt.range' = '5/1/24,7/1/24', 'projection.dt.interval.unit' = 'DAYS');

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=6/1/24/c.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
3	6/1/24

# quoted text is a literal, '' a single quote
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyy-MM-dd''T''HH', 'projection.dt.range' = '2024-01-01T00,2024-01-01T12', 'projection.dt.interval' = '12', 'projection.dt.interval.unit' = 'HOURS');

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=2024-01-01T12/d.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
4	2024-01-01T12

statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyy''''MM', 'projection.dt.range' = '2024''01,2024''02', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'MONTHS');

statement ok
COPY (SELECT 5 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=2024''02/e.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
5	2024'02

# MMM is the English short month name
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'MMM-yyyy', 'projection.dt.range' = 'Jan-2024,Mar-2024');

statement ok
COPY (SELECT 6 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=Feb-2024/f.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
6	Feb-2024

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN ('Jan-2024', 'Mar-2024', 'Apr-2024');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/3.*

# S is the fraction of a second, truncated to the count of letters; MILLIS steps
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyyMMdd-HHmmssSSS', 'projection.dt.range' = '20240101-000000000,20240101-000000500', 'projection.dt.interval' = '250', 'projection.dt.interval.unit' = 'MILLIS');

statement ok
COPY (SELECT 7 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_hourly/dt=20240101-000000250/g.parquet';

query II
SELECT id, dt FROM my_datalake.default.pp_hourly;
----
7	20240101-000000250

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN ('20240101-000000000', '20240101-000000500', '20240101-000000750');
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/3.*

# a DATE column with a compact format reads the directory as a date
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_compact;

statement ok
CREATE TABLE my_datalake.default.pp_compact (id INTEGER, d DATE) PARTITIONED BY (d)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_compact',
    'projection.enabled' = 'true',
    'projection.d.type' = 'date',
    'projection.d.format' = 'yyyyMMdd',
    'projection.d.range' = '20240105,20240107'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_compact/d=20240106/a.parquet';

query II
SELECT id, d FROM my_datalake.default.pp_compact WHERE d = DATE '2024-01-06';
----
1	2024-01-06

statement ok
DROP TABLE my_datalake.default.pp_compact;

#---------------------------------------------------------------------------
# NOW: the start of the transaction, in UTC, truncated to the format's precision
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyy-MM-dd', 'projection.dt.range' = 'NOW-2DAYS,NOW', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'DAYS');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN (strftime(make_timestamp(epoch_us(now())), '%Y-%m-%d'), strftime(make_timestamp(epoch_us(now())) - INTERVAL 1 DAY, '%Y-%m-%d'));
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/3.*

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN (strftime(make_timestamp(epoch_us(now())) - INTERVAL 3 DAY, '%Y-%m-%d'), strftime(make_timestamp(epoch_us(now())) + INTERVAL 1 DAY, '%Y-%m-%d'));
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 0/3.*

# white space around NOW and its offset, a singular unit, both bounds relative
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.range' = ' NOW - 1 MONTH , NOW + 2 WEEKS ', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'WEEKS');

# three days after the lower bound is never on a weekly grid
query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN (strftime(make_timestamp(epoch_us(now())) - INTERVAL 1 MONTH + INTERVAL 3 DAY, '%Y-%m-%d'));
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 0/[67].*

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN (strftime(make_timestamp(epoch_us(now())) - INTERVAL 1 MONTH, '%Y-%m-%d'), strftime(make_timestamp(epoch_us(now())) - INTERVAL 1 MONTH + INTERVAL 14 DAY, '%Y-%m-%d'));
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 2/[67].*

# NOW and its unit are read in any case, as Athena does (now-2days, NOW - 1 day and Now-2Days checked on engine v3)
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.range' = 'now - 2 days,Now', 'projection.dt.interval' = '1', 'projection.dt.interval.unit' = 'DAYS');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_hourly WHERE dt IN (strftime(make_timestamp(epoch_us(now())), '%Y-%m-%d'));
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/3.*

#---------------------------------------------------------------------------
# unsupported format: the offending letter or character is named
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyy-MM-dd EEE');

statement error
SELECT count(*) FROM my_datalake.default.pp_hourly;
----
pattern letter 'E'

statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'yyyy-MM-dd''T');

statement error
SELECT count(*) FROM my_datalake.default.pp_hourly;
----
unterminated quote

statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'ddd');

statement error
SELECT count(*) FROM my_datalake.default.pp_hourly;
----
'd' at most twice

statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = '[yyyy]');

statement error
SELECT count(*) FROM my_datalake.default.pp_hourly;
----
'[', which is reserved

statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'MMMMM-yyyy');

statement error
SELECT count(*) FROM my_datalake.default.pp_hourly;
----
'M' at most four times

# source: Athena's UniversalProjectedPartitionColumnFactory reads a date key as a LocalDateTime, LocalDate, YearMonth or
# Year, none of which parses without a year; a year-less format would otherwise read as 1970 and fail on a leap day
statement ok
ALTER TABLE my_datalake.default.pp_hourly SET ('projection.dt.format' = 'MM-dd', 'projection.dt.range' = '02-28,03-01');

statement error
SELECT count(*) FROM my_datalake.default.pp_hourly;
----
projection.dt.format 'MM-dd' has no year field (y), so its values do not name a date

statement ok
DROP TABLE my_datalake.default.pp_hourly;

#---------------------------------------------------------------------------
# storage.location.template: every ${key} replaced by the key's value; the <key>=<value> layout is then not read
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_tpl;

statement ok
CREATE TABLE my_datalake.default.pp_tpl (id INTEGER, region VARCHAR, hour INTEGER) PARTITIONED BY (region, hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_tpl',
    'projection.enabled' = 'true',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu',
    'projection.hour.type' = 'integer',
    'projection.hour.range' = '0,23',
    'storage.location.template' = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_tpl_data/${hour}/r=${region}/'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_tpl_data/7/r=us/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_tpl/region=us/hour=7/b.parquet';

query III
SELECT id, region, hour FROM my_datalake.default.pp_tpl;
----
1	us	7

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.pp_tpl WHERE region = 'eu' AND hour = 3;
----
0

query I
SELECT DISTINCT dir FROM listed_dirs();
----
pp_tpl_data/3/r=eu/

statement ok
DROP TABLE my_datalake.default.pp_tpl;

#---------------------------------------------------------------------------
# no escaping: Athena substitutes the value as written, in the <key>=<value> layout and in a template alike
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_esc;

statement ok
CREATE TABLE my_datalake.default.pp_esc (id INTEGER, k VARCHAR) PARTITIONED BY (k)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc',
    'projection.enabled' = 'true',
    'projection.k.type' = 'enum',
    'projection.k.values' = 'a:b,x y,p+q,100%'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=a:b/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=x y/b.parquet';

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=p+q/c.parquet';

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=100%/d.parquet';

# the escaped spellings Hive (k=a%3Ab) and DuckDB's hive partitioning (k=x%20y) would write are not what Athena reads
statement ok
COPY (SELECT 5 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=a%3Ab/e.parquet';

statement ok
COPY (SELECT 6 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=x%20y/f.parquet';

query II
SELECT id, k FROM my_datalake.default.pp_esc ORDER BY id;
----
1	a:b
2	x y
3	p+q
4	100%

statement ok
ALTER TABLE my_datalake.default.pp_esc SET ('storage.location.template' = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc_raw/${k}/');

statement ok
COPY (SELECT 7 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc_raw/a:b/a.parquet';

statement ok
COPY (SELECT 8 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc_raw/a%3Ab/b.parquet';

query II
SELECT id, k FROM my_datalake.default.pp_esc ORDER BY id;
----
7	a:b

statement ok
ALTER TABLE my_datalake.default.pp_esc SET ('storage.location.template' = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc_hive/k=${k}/');

statement ok
COPY (SELECT 9 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc_hive/k=a%3Ab/a.parquet';

statement ok
COPY (SELECT 10 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc_hive/k=a:b/b.parquet';

query II
SELECT id, k FROM my_datalake.default.pp_esc ORDER BY id;
----
10	a:b

# glob characters in a value name a directory, not a pattern: a[b] is not 'a' or 'b', a* is not every k=a..., a?c is
# not axc, x?*y is not xAy, a] is a]; the same from one listing per partition, from one listing of the root, and from
# the listing cache
statement ok
