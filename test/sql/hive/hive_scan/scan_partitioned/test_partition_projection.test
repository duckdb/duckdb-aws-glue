# a unit without an interval is ignored too: the step is one of the format's finest field (a day here, not a month)
statement ok
ALTER TABLE my_datalake.default.pp_year RESET ('projection.y.interval');

statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.format' = 'yyyy-MM-dd', 'projection.y.range' = '2024-01-01,2024-01-05', 'projection.y.interval.unit' = 'MONTHS');

