statement ok
COPY (SELECT 17 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=a]/g.parquet';

statement ok
COPY (SELECT 18 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=x?*y/h.parquet';

statement ok
COPY (SELECT 19 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_esc/k=xAy/i.parquet';

foreach threshold 1 100

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
