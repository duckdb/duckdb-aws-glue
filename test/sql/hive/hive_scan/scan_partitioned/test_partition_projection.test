2

statement ok
DROP TABLE my_datalake.default.pp_par_date;

# templates: a placeholder may abut text or another placeholder, appear twice, and the template needs no trailing slash
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_tpl;

statement ok
CREATE TABLE my_datalake.default.pp_par_tpl (id INTEGER, region VARCHAR, hour INTEGER) PARTITIONED BY (region, hour)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl',
    'projection.enabled' = 'true',
    'projection.region.type' = 'enum',
    'projection.region.values' = 'us,eu',
    'projection.hour.type' = 'integer',
    'projection.hour.range' = '7,8',
    'projection.hour.digits' = '2',
    'storage.location.template' = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl/${region}${hour}/h${hour}'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl/us07/h07/a.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl/us7/h7/b.parquet';

query III
SELECT id, region, hour FROM my_datalake.default.pp_par_tpl ORDER BY id;
----
1	us	7

statement ok
ALTER TABLE my_datalake.default.pp_par_tpl SET ('storage.location.template' = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl2/${region}/${hour}/x/${region}');

statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl2/eu/08/x/eu/a.parquet';

statement ok
COPY (SELECT 4 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_tpl2/eu/08/x/us/b.parquet';

query III
SELECT id, region, hour FROM my_datalake.default.pp_par_tpl ORDER BY id;
----
3	eu	8

statement ok
DROP TABLE my_datalake.default.pp_par_tpl;

# projection.enabled on an unpartitioned table changes nothing: the table reads its location
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_par_flat;

statement ok
CREATE TABLE my_datalake.default.pp_par_flat (id INTEGER)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_flat',
    'projection.enabled' = 'true'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_par_flat/a.parquet';

query I
SELECT id FROM my_datalake.default.pp_par_flat;
----
1

statement ok
DROP TABLE my_datalake.default.pp_par_flat;
