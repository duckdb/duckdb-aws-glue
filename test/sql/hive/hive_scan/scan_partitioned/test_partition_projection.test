statement ok
ALTER TABLE my_datalake.default.pp_par_date SET ('projection.dt.type' = 'date', 'projection.dt.format' = 'yyyy-MM-dd', 'projection.dt.range' = '2024-01-01,2024-01-05');

query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_par_date WHERE dt BETWEEN DATE '2024-01-02' AND DATE '2024-01-04';
