#---------------------------------------------------------------------------
# a year format steps by years; a step finer than the format spells one partition once, valued at its start
#---------------------------------------------------------------------------
# source: Athena's UniversalProjectedPartitionColumnFactory picks the step from the format's precision (LocalDateTime,
# LocalDate, YearMonth, Year): 'yyyy' is a Year and steps 1 YEAR without interval.unit (TestProjectedYearColumnFactory:
# 2018,2020 -> 2018, 2019, 2020); Trino DateProjection.adjustBoundToDateFormat truncates both bounds to the format
statement ok
DROP TABLE IF EXISTS my_datalake.default.pp_year;

statement ok
CREATE TABLE my_datalake.default.pp_year (id INTEGER, y VARCHAR) PARTITIONED BY (y)
WITH (
    location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_year',
    'projection.enabled' = 'true',
    'projection.y.type' = 'date',
    'projection.y.format' = 'yyyy',
    'projection.y.range' = '2020,2021'
);

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pp_year/y=2021/a.parquet';

statement ok
CALL truncate_duckdb_logs();

# two derived partitions: 2020 and 2021, one step each
query II
EXPLAIN SELECT count(*) FROM my_datalake.default.pp_year WHERE y = '2021';
----
physical_plan	<REGEX>:.*HIVE_SCAN.*Scanning Files: 1/2.*

query I
SELECT id FROM my_datalake.default.pp_year WHERE y = '2021';
----
1

query I
SELECT DISTINCT dir FROM listed_dirs();
----
pp_year/y=2021/

# source: Athena ProjectedYearColumnFactory uses interval and interval.unit only together; with the unit, 2020 and 2022
statement ok
ALTER TABLE my_datalake.default.pp_year SET ('projection.y.range' = '2020,2023', 'projection.y.interval' = '2');

query II
