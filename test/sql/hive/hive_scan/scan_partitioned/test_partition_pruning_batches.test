# name: test/sql/hive/hive_scan/scan_partitioned/test_partition_pruning_batches.test
# description: Partition filters are evaluated over chunks of partition values: pruning across several chunks, a chunk the filter throws for split down to the partition that fails, and values cast only where the filter reads them
# group: [scan_partitioned]

require parquet

require glue

# hive_scan reads no rows from partitions below the root on Windows, with or without batching: a separate issue
require linux

statement ok
COPY (SELECT * FROM (VALUES (1, 'k1'), (2, 'k2500'), (3, 'k4999'), (4, 'kx')) t(id, dt))
TO '{TEST_DIR}/pruning_batches' (FORMAT parquet, PARTITION_BY (dt));

# 5,001 partitions, three chunks of partition values; 'kx' is the last one
statement ok
SET VARIABLE parts = (
    SELECT list({dt: dt, location: NULL::VARCHAR} ORDER BY i)
    FROM (SELECT i, 'k' || i AS dt FROM range(5000) t(i) UNION ALL SELECT 5000, 'kx'));

statement ok
CREATE MACRO pb() AS TABLE
SELECT * FROM hive_scan('{TEST_DIR}/pruning_batches', schema := {id: 'INTEGER', dt: 'VARCHAR'},
    partitions := getvariable('parts'));

# one partition in each chunk
query I
SELECT id FROM pb() WHERE dt IN ('k1', 'k2500', 'k4999') ORDER BY id
----
1
2
3

query II
EXPLAIN SELECT id FROM pb() WHERE dt IN ('k1', 'k2500', 'k4999')
----
physical_plan	<REGEX>:.*File Filters:.*Scanning Files: 3/5001.*

# a function of the partition column next to a filter on a data column
query I
SELECT id FROM pb() WHERE upper(dt) = 'K2500' AND id > 0
----
2

query II
EXPLAIN SELECT id FROM pb() WHERE upper(dt) = 'K2500' AND id > 0
----
physical_plan	<REGEX>:.*Scanning Files: 1/5001.*

# two partition filters: the first that is false drops a partition, in every chunk
query I
SELECT id FROM pb() WHERE dt LIKE 'k4%' AND dt >= 'k4999' ORDER BY id
----
3

query II
EXPLAIN SELECT id FROM pb() WHERE dt LIKE 'k4%' AND dt >= 'k4999'
----
physical_plan	<REGEX>:.*Scanning Files: 1/5001.*

# TRY_CAST gives NULL for 'kx', so 'kx' is ruled in by the second filter
query I
SELECT id FROM pb() WHERE TRY_CAST(substr(dt, 2) AS INTEGER) < 3 OR TRY_CAST(substr(dt, 2) AS INTEGER) IS NULL ORDER BY id
----
1
4

query II
EXPLAIN SELECT id FROM pb() WHERE TRY_CAST(substr(dt, 2) AS INTEGER) < 3
----
physical_plan	<REGEX>:.*Scanning Files: 3/5001.*

# no partition is kept
query I
SELECT count(*) FROM pb() WHERE dt = 'none'
----
0

# an INTEGER partition key with a value that does not cast, in the second chunk: the cast inside the filter throws,
# the chunk is split in halves down to that partition, which fails with the error pruning always gave
statement ok
SET VARIABLE bad_parts = (
    SELECT list({n: CASE WHEN i = 2900 THEN 'abc' ELSE i::VARCHAR END, location: NULL::VARCHAR} ORDER BY i)
    FROM range(3000) t(i));

statement error
EXPLAIN SELECT id FROM hive_scan('{TEST_DIR}/pruning_batches', schema := {id: 'INTEGER', n: 'INTEGER'},
    partitions := getvariable('bad_parts')) WHERE n = 1
----
Unable to cast 'abc' (from Glue partition column 'N') to: 'INTEGER'

# as in core's hive partitioning, a value is cast only where the filter reads it: when another branch decides the
# partition first, a value that does not cast no longer fails the query
statement ok
SET VARIABLE guarded_parts = [{dt: 'skip', n: 'abc', location: NULL::VARCHAR}];

query I
SELECT count(*) FROM hive_scan('{TEST_DIR}/pruning_batches', schema := {id: 'INTEGER', dt: 'VARCHAR', n: 'INTEGER'},
    partitions := getvariable('guarded_parts')) WHERE CASE WHEN dt = 'skip' THEN false ELSE n = 1 END
----
0

statement error
SELECT count(*) FROM hive_scan('{TEST_DIR}/pruning_batches', schema := {id: 'INTEGER', dt: 'VARCHAR', n: 'INTEGER'},
    partitions := getvariable('guarded_parts')) WHERE n = 1
----
Unable to cast 'abc' (from Glue partition column 'N') to: 'INTEGER'

# an INTEGER key whose values load as strings and are cast inside the filter; Hive's default partition name is NULL
statement ok
SET VARIABLE int_parts = (
    SELECT list({n: CASE WHEN i = 4000 THEN '__HIVE_DEFAULT_PARTITION__' ELSE i::VARCHAR END, location: NULL::VARCHAR}
        ORDER BY i)
    FROM range(5000) t(i));

statement ok
CREATE MACRO pi() AS TABLE
SELECT * FROM hive_scan('{TEST_DIR}/pruning_batches', schema := {id: 'INTEGER', n: 'INTEGER'},
    partitions := getvariable('int_parts'));

query II
EXPLAIN SELECT id FROM pi() WHERE n BETWEEN 10 AND 12
----
physical_plan	<REGEX>:.*Scanning Files: 3/5000.*

query II
EXPLAIN SELECT id FROM pi() WHERE n IS NULL
----
physical_plan	<REGEX>:.*Scanning Files: 1/5000.*

query II
EXPLAIN SELECT id FROM pi() WHERE coalesce(n, -1) = -1
----
physical_plan	<REGEX>:.*Scanning Files: 1/5000.*

# a filter that can throw stays above the scan and prunes nothing: the scan applies it to every row
query II
EXPLAIN SELECT id FROM pb() WHERE CAST(substr(dt, 2) AS INTEGER) = 1
----
physical_plan	<!REGEX>:.*File Filters.*

statement error
SELECT id FROM pb() WHERE CAST(substr(dt, 2) AS INTEGER) = 1
----
Could not convert string 'x' to INT32

query I
SELECT id FROM pb() WHERE CASE WHEN dt = 'kx' THEN true ELSE CAST(substr(dt, 2) AS INTEGER) = 2500 END ORDER BY id
----
2
4
