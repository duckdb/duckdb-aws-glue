# name: test/sql/hive/hive_scan/scan_partitioned/test_hidden_partition_key.test
# description: A partition key starting with '_' is read when the table root is listed; hidden files below it are not
# group: [scan_partitioned]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET enable_external_file_cache=false;

statement ok
DROP TABLE IF EXISTS my_datalake.default.hidden_key;

statement ok
CREATE TABLE my_datalake.default.hidden_key (id INTEGER, _k INTEGER) PARTITIONED BY (_k);

# three partitions, in the directories _k=0, _k=1 and _k=2
statement ok
INSERT INTO my_datalake.default.hidden_key SELECT i, i % 3 FROM range(9) t(i);

# hidden below a partition: skipped
statement ok
COPY (SELECT 99 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hidden_key/_k=1/_temporary/data.parquet';

# hidden below the root, outside any partition: skipped
statement ok
COPY (SELECT 98 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hidden_key/_staging/data.parquet';

# 1 and 2 list the table root, 1000 lists each partition
foreach threshold 1 2 1000

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
SELECT count(*), sum(id) FROM my_datalake.default.hidden_key;
----
9	36

query II
SELECT _k, count(*) FROM my_datalake.default.hidden_key GROUP BY _k ORDER BY _k;
----
0	3
1	3
2	3

query I
SELECT count(*) FROM my_datalake.default.hidden_key WHERE _k < 2;
----
6

endloop

statement ok
RESET hive_partition_listing_threshold;

statement ok
DROP TABLE my_datalake.default.hidden_key;
