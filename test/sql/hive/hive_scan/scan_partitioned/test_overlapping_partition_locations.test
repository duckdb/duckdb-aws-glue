# name: test/sql/hive/hive_scan/scan_partitioned/test_overlapping_partition_locations.test
# description: A file under a partition location nested inside another partition's location belongs to the inner partition
# group: [scan_partitioned]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET enable_external_file_cache=false;

statement ok
DROP TABLE IF EXISTS my_datalake.default.overlap_orders;

statement ok
CREATE TABLE my_datalake.default.overlap_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
CALL glue_add_partition('my_datalake.default.overlap_orders', {dt: 'outer'});

# dt=inner is registered inside dt=outer's location
statement ok
CALL glue_add_partition('my_datalake.default.overlap_orders', {dt: 'inner'},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/overlap_orders/dt=outer/sub');

statement ok
COPY (SELECT 1 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/overlap_orders/dt=outer/f_outer.parquet';

statement ok
COPY (SELECT 2 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/overlap_orders/dt=outer/sub/f_inner.parquet';

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.overlap_orders');
----
2

# 1 lists the table root, 1000 lists each partition
foreach threshold 1 5

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
SELECT id, dt FROM my_datalake.default.overlap_orders ORDER BY id;
----
1	outer
2	inner

# pruning dt=inner does not hand its file to dt=outer
query I
SELECT id FROM my_datalake.default.overlap_orders WHERE dt = 'outer';
----
1

# nor does a copy of the pruned scan, which the window self join rewrite reads the table through
query II
SELECT id, count(*) OVER (PARTITION BY dt) FROM my_datalake.default.overlap_orders WHERE dt = 'outer';
----
1	1

# nor does a deserialized plan
statement ok
SET debug_verify_serializer = true;

query I
SELECT id FROM my_datalake.default.overlap_orders WHERE dt = 'outer';
----
1

statement ok
SET debug_verify_serializer = false;

query I
SELECT id FROM my_datalake.default.overlap_orders WHERE dt = 'inner';
----
2

endloop

statement ok
RESET hive_partition_listing_threshold;

# an unregistered subdirectory belongs to the enclosing partition
statement ok
COPY (SELECT 3 AS id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/overlap_orders/dt=outer/plain/f.parquet';

foreach threshold 1 10

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
SELECT id, dt FROM my_datalake.default.overlap_orders ORDER BY id;
----
1	outer
2	inner
3	outer

endloop

statement ok
RESET hive_partition_listing_threshold;

statement ok
DROP TABLE my_datalake.default.overlap_orders;
