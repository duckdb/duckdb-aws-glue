# name: test/sql/hive/hive_scan/scan_partitioned/test_nested_partition_files.test
# description: Files in nested subdirectories of a partition are read, regardless of hive_partition_listing_threshold
# group: [scan_partitioned]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET enable_external_file_cache=false;

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_orders;

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_orders_staging;

statement ok
CREATE TABLE my_datalake.default.nested_orders (id INTEGER, amount DOUBLE, dt VARCHAR) PARTITIONED BY (dt);

# two partitions, registered by the INSERT, each with a file directly in its directory
statement ok
INSERT INTO my_datalake.default.nested_orders VALUES (1, 10.0, '2016-05-14'), (2, 20.0, '2016-05-15');

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.nested_orders');
----
2

# files in nested subdirectories of registered partitions
# nested_orders_staging writes files in the default format at a given location; dropping it keeps the files
statement ok
CREATE TABLE my_datalake.default.nested_orders_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_orders/dt=2016-05-14/nested')
AS SELECT 3 AS id, 30.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.nested_orders_staging;

statement ok
CREATE TABLE my_datalake.default.nested_orders_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_orders/dt=2016-05-15/a/b')
AS SELECT 4 AS id, 40.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.nested_orders_staging;

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.nested_orders');
----
2

# 1 and 2 list the table root, 3, 10 and 1000 list each partition
foreach threshold 1 2 3 10 1000

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
SELECT count(*), sum(id) FROM my_datalake.default.nested_orders;
----
4	10

query III
SELECT id, amount, dt FROM my_datalake.default.nested_orders ORDER BY id;
----
1	10.0	2016-05-14
2	20.0	2016-05-15
3	30.0	2016-05-14
4	40.0	2016-05-15

query I
SELECT count(*) FROM my_datalake.default.nested_orders WHERE dt = '2016-05-14';
----
2

endloop

statement ok
RESET hive_partition_listing_threshold;

query II
SELECT count(*), sum(id) FROM my_datalake.default.nested_orders;
----
4	10

# files in hidden subdirectories are skipped
statement ok
CREATE TABLE my_datalake.default.nested_orders_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_orders/dt=2016-05-14/_temporary')
AS SELECT 99 AS id, 99.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.nested_orders_staging;

statement ok
CREATE TABLE my_datalake.default.nested_orders_staging WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_orders/dt=2016-05-15/.hive-staging')
AS SELECT 98 AS id, 98.0::DOUBLE AS amount;

statement ok
DROP TABLE my_datalake.default.nested_orders_staging;

foreach threshold 1 10

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
SELECT count(*), sum(id) FROM my_datalake.default.nested_orders;
----
4	10

endloop

statement ok
RESET hive_partition_listing_threshold;

statement ok
DROP TABLE my_datalake.default.nested_orders;
