# name: test/sql/hive/hive_scan/plan_serialization.test
# description: A plan scanning a Glue table round-trips through plan serialization: the deserialized hive_scan binds
# group: [hive_scan]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ps_orders;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ps_events;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ps_lines;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ps_text;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ps_opencsv;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ps_ts_formats;

statement ok
CREATE TABLE my_datalake.default.ps_orders (id INTEGER, amount DECIMAL(10,2), dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.ps_orders VALUES (1, 10.50, '2016-05-14'), (2, 20.25, '2016-05-15'), (3, 30.00, '2016-05-15');

statement ok
CREATE TABLE my_datalake.default.ps_events WITH (format = 'csv', delimiter = '|') AS
SELECT 1 AS id, 'start' AS kind UNION ALL SELECT 2, 'stop';

statement ok
CREATE TABLE my_datalake.default.ps_lines WITH (format = 'json') AS SELECT 7 AS n, {'a': 1} AS s;

# a header line, a NULL string, a quote that is a plain character, a short row and a value that does not parse
statement ok
CREATE TABLE my_datalake.default.ps_text (id INTEGER, name VARCHAR, amount DOUBLE)
WITH (format = 'csv', 'skip.header.line.count' = '1', 'serialization.null.format' = 'NA');

statement ok
COPY (SELECT * FROM (VALUES ('id,name,amount'), ('1,"a",1.5'), ('2,NA,x'), ('3,c')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ps_text/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# OpenCSVSerde booleans, integers and epoch timestamps
statement ok
CREATE TABLE my_datalake.default.ps_opencsv (id INTEGER, ok BOOLEAN, ts TIMESTAMP) WITH (format = 'csv', quote = '"');

statement ok
COPY (SELECT * FROM (VALUES ('1,TRUE,1579059880000'), ('2,yes,0'))
t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ps_opencsv/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# a timestamp in a format timestamp.formats lists
statement ok
CREATE TABLE my_datalake.default.ps_ts_formats (id INTEGER, ts TIMESTAMP) WITH (format = 'csv',
    'timestamp.formats' = 'dd/MM/yyyy HH:mm:ss,millis');

statement ok
COPY (SELECT * FROM (VALUES ('1,15/01/2020 06:24:40'), ('2,1579069480000'))
t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ps_ts_formats/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# with the verifier on, every plan below is serialized, deserialized and run as deserialized
statement ok
SET debug_verify_serializer = true;

query I
SELECT sum(amount) FROM my_datalake.default.ps_orders;
----
60.75

# the partitions the filter pruned stay pruned in the deserialized plan
query II
SELECT id, amount FROM my_datalake.default.ps_orders WHERE dt = '2016-05-15' ORDER BY id;
----
2	20.25
3	30.00

query II
SELECT dt, count(*) FROM my_datalake.default.ps_orders WHERE dt <> '2016-05-15' GROUP BY dt;
----
2016-05-14	1

# the two identical scans are still one common subplan
query I
SELECT count(*) FROM (
    SELECT id FROM my_datalake.default.ps_orders WHERE dt = '2016-05-15'
    UNION ALL
    SELECT id FROM my_datalake.default.ps_orders WHERE dt = '2016-05-15');
----
4

# a CTE read twice below a LIMIT is inlined into each reference as a copy of its plan, whose scans are the table's
query I
WITH pairs AS (
    SELECT a.dt FROM my_datalake.default.ps_orders a, my_datalake.default.ps_orders b
    WHERE a.dt = b.dt AND a.id <> b.id)
SELECT count(*) FROM my_datalake.default.ps_orders
WHERE dt IN (SELECT dt FROM pairs) AND dt IN (SELECT dt FROM pairs) LIMIT 10;
----
2

# a csv table keeps its reader and its dialect
query II
SELECT id, kind FROM my_datalake.default.ps_events ORDER BY id;
----
1	start
2	stop

query I
SELECT id FROM my_datalake.default.ps_events WHERE id + 1 > 2;
----
2

# a text table keeps its SerDe's rules
query IIII
SELECT id, name, name IS NULL, amount FROM my_datalake.default.ps_text ORDER BY id;
----
1	"a"	false	1.5
2	NULL	true	NULL
3	c	false	NULL

# an OpenCSVSerde table keeps its SerDe's conversions
query III
SELECT id, ok, ts FROM my_datalake.default.ps_opencsv ORDER BY id;
----
1	true	2020-01-15 03:44:40
2	false	1970-01-01 00:00:00

# a LazySimpleSerDe table keeps its timestamp formats
query II
SELECT id, ts FROM my_datalake.default.ps_ts_formats ORDER BY id;
----
1	2020-01-15 06:24:40
2	2020-01-15 06:24:40

# the reader call of a deserialized scan converts the fields as the scan does
query II
EXPLAIN (SQL) SELECT ok, ts FROM my_datalake.default.ps_opencsv;
----
sql	<REGEX>:.*\(lower\(__internal_barrier\(ok\)\) = 'true'\) AS ok,\s+make_timestamp_ms\(CAST\(__internal_barrier\(ts\) AS BIGINT\)\) AS ts.*

query II
EXPLAIN (SQL) SELECT ts FROM my_datalake.default.ps_ts_formats;
----
sql	<REGEX>:.*try_strptime\(.*'%d/%m/%Y %H:%M:%S'.*TRY\(make_timestamp_ms\(.*END AS ts.*

query II
SELECT n, s.a FROM my_datalake.default.ps_lines;
----
7	1

query II
EXPLAIN SELECT id FROM my_datalake.default.ps_orders;
----
physical_plan	<REGEX>:.*HIVE_SCAN.*

query II
EXPLAIN SELECT id FROM my_datalake.default.ps_events;
----
physical_plan	<REGEX>:.*HIVE_SCAN.*

statement error
SELECT * FROM hive_scan(['{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ps_orders']);
----
hive_scan takes a single root location, not a list of files

# read_parquet itself is still the format reader
query I
SELECT count(*) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ps_orders/*/*.parquet');
----
3

# a hive_scan() call is bound again from its arguments
query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ps_orders',
    schema := {id: 'INTEGER', amount: 'DECIMAL(10,2)', dt: 'VARCHAR'},
    partitions := [{dt: '2016-05-14'}, {dt: '2016-05-15'}]);
----
3

statement ok
SET debug_verify_serializer = false;

statement ok
DROP TABLE my_datalake.default.ps_text;

statement ok
DROP TABLE my_datalake.default.ps_opencsv;

statement ok
DROP TABLE my_datalake.default.ps_ts_formats;

statement ok
DROP TABLE my_datalake.default.ps_lines;

statement ok
DROP TABLE my_datalake.default.ps_events;

statement ok
DROP TABLE my_datalake.default.ps_orders;
