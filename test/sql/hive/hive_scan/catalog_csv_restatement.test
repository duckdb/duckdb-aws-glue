# name: test/sql/hive/hive_scan/catalog_csv_restatement.test
# description: hive_scan() given the dialect of a Glue text table reads the rows the scan of the table reads
# group: [hive_scan]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.hsr_lazy;

statement ok
DROP TABLE IF EXISTS my_datalake.default.hsr_opencsv;

# the rows one side reads and the other does not
statement ok
CREATE MACRO differences(a, b) AS TABLE
    (FROM query_table(a) EXCEPT ALL FROM query_table(b)) UNION ALL (FROM query_table(b) EXCEPT ALL FROM query_table(a));

#---------------------------------------------------------------------------
# LazySimpleSerDe: '|' delimited, NULL is 'NA', two header lines, no quoting
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.hsr_lazy (id INTEGER, name VARCHAR, amount DOUBLE)
WITH (format = 'csv', delimiter = '|', 'skip.header.line.count' = '2', 'serialization.null.format' = 'NA');

statement ok
COPY (SELECT * FROM (VALUES ('generated by a job'), ('id|name|amount'), ('1|a|1.5'), ('2|NA|NA'), ('3|c'), ('4|d|oops'),
    ('5|"e"|5.5|extra')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_lazy/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
CREATE VIEW hsr_lazy_restated AS
SELECT * FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_lazy', format := 'csv', delim := '|', quote := '',
    escape := '', nullstr := 'NA', skip := 2, serde_fields := true, schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});

query IIII
SELECT id, name, name IS NULL, amount FROM my_datalake.default.hsr_lazy ORDER BY id;
----
1	a	false	1.5
2	NULL	true	NULL
3	c	false	NULL
4	d	false	NULL
5	"e"	false	5.5

query II
SELECT (SELECT count(*) FROM hsr_lazy_restated), (SELECT count(*) FROM differences('my_datalake.default.hsr_lazy', 'hsr_lazy_restated'));
----
5	0

#---------------------------------------------------------------------------
# OpenCSVSerde: ',' separated, '"' quoted, one header line, no NULL, and a value that does not parse fails the query
# unless use.null.for.invalid.data is true
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.hsr_opencsv (id INTEGER, name VARCHAR, amount DOUBLE)
WITH (format = 'csv', quote = '"', 'skip.header.line.count' = '1');

statement ok
COPY (SELECT * FROM (VALUES ('id,name,amount'), ('1,"a,b",1.5'), ('2,'), ('3,"x ""y""",3.5,extra'), ('4')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_opencsv/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
CREATE VIEW hsr_opencsv_restated AS
SELECT * FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_opencsv', format := 'csv', delim := ',', quote := '"',
    escape := '"', nullstr := chr(10), skip := 1, serde_fields := true, null_for_invalid_data := false,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});

statement ok
CREATE VIEW hsr_opencsv_restated_null_invalid AS
SELECT * FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_opencsv', format := 'csv', delim := ',', quote := '"',
    escape := '"', nullstr := chr(10), skip := 1, serde_fields := true, schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});

query IIII
SELECT id, name, name IS NULL, amount FROM my_datalake.default.hsr_opencsv ORDER BY id;
----
1	a,b	false	1.5
2	(empty)	false	NULL
3	x "y"	false	3.5
4	NULL	true	NULL

query II
SELECT (SELECT count(*) FROM hsr_opencsv_restated), (SELECT count(*) FROM differences('my_datalake.default.hsr_opencsv', 'hsr_opencsv_restated'));
----
4	0

statement ok
COPY (SELECT * FROM (VALUES ('id,name,amount'), ('5,e,oops')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_opencsv/invalid.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT * FROM my_datalake.default.hsr_opencsv;
----
<REGEX>:.*Could not convert string 'oops' to DOUBLE.*

statement error
SELECT * FROM hsr_opencsv_restated;
----
<REGEX>:.*Could not convert string 'oops' to DOUBLE.*

statement ok
ALTER TABLE my_datalake.default.hsr_opencsv SET ('use.null.for.invalid.data' = 'true');

query II
SELECT (SELECT count(*) FROM hsr_opencsv_restated_null_invalid),
    (SELECT count(*) FROM differences('my_datalake.default.hsr_opencsv', 'hsr_opencsv_restated_null_invalid'));
----
5	0

# a line break inside a quoted field: the parallel scanner refuses it next to the NULL padding, one thread per file
# (hive_csv_parallel for the table, parallel for hive_scan) reads it
statement ok
COPY (SELECT * FROM (VALUES ('id,name,amount'), ('6,"two' || chr(10) || 'lines",6.5')) t(line))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_opencsv/line_break.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT * FROM my_datalake.default.hsr_opencsv;
----
<REGEX>:.*parallel scanner does not support null_padding in conjunction with quoted new lines.*

statement error
SELECT * FROM hsr_opencsv_restated_null_invalid;
----
<REGEX>:.*parallel scanner does not support null_padding in conjunction with quoted new lines.*

statement ok
CREATE VIEW hsr_opencsv_restated_one_thread AS
SELECT * FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hsr_opencsv', format := 'csv', delim := ',', quote := '"',
    escape := '"', nullstr := chr(10), skip := 1, serde_fields := true, parallel := false,
    schema := {id: 'INTEGER', name: 'VARCHAR', amount: 'DOUBLE'});

statement ok
SET hive_csv_parallel = false;

query II
SELECT (SELECT count(*) FROM hsr_opencsv_restated_one_thread),
    (SELECT count(*) FROM differences('my_datalake.default.hsr_opencsv', 'hsr_opencsv_restated_one_thread'));
----
6	0

query II
SELECT id, replace(name, chr(10), '<nl>') FROM my_datalake.default.hsr_opencsv WHERE id = 6;
----
6	two<nl>lines

statement ok
RESET hive_csv_parallel;

statement ok
DROP TABLE my_datalake.default.hsr_lazy;

statement ok
DROP TABLE my_datalake.default.hsr_opencsv;
