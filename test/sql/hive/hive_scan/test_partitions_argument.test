# name: test/sql/hive/hive_scan/test_partitions_argument.test
# description: hive_scan errors on partition_keys without partitions, and reads nothing for partitions := []
# group: [hive_scan]

require httpfs

require glue

require-env GLUE_CATALOG_ID

# this test is about Parquet tables, so they stay Parquet whatever the config's default format
statement ok
SET hive_default_format = 'parquet';

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.pa_orders;

statement ok
CREATE TABLE my_datalake.default.pa_orders (id INTEGER, amount DOUBLE, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.pa_orders VALUES (1, 10.0, '2016-05-14'), (2, 20.0, '2016-05-15');

query I
SELECT count(*) FROM my_datalake.default.pa_orders;
----
2

statement error
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/pa_orders',
    schema := {id: 'INTEGER', amount: 'DOUBLE', dt: 'VARCHAR'},
    partition_keys := ['dt']);
----
<REGEX>:.*'partition_keys' was given without 'partitions'.*partitions := \[\{dt: '...'\}\].*

# no registered partition reads nothing, like a Glue table without partitions
query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/pa_orders',
    schema := {id: 'INTEGER', amount: 'DOUBLE', dt: 'VARCHAR'},
    partition_keys := ['dt'],
    partitions := []);
----
0

# without partition_keys an empty list is unpartitioned and reads the whole root
query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/pa_orders',
    schema := {id: 'INTEGER', amount: 'DOUBLE', dt: 'VARCHAR'},
    partitions := []);
----
2

query II
SELECT id, dt FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/pa_orders',
    schema := {id: 'INTEGER', amount: 'DOUBLE', dt: 'VARCHAR'},
    partition_keys := ['dt'],
    partitions := [{dt: '2016-05-14'}, {dt: '2016-05-15'}])
ORDER BY id;
----
1	2016-05-14
2	2016-05-15

# the partition keys default to the fields of the first partition
query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/pa_orders',
    schema := {id: 'INTEGER', amount: 'DOUBLE', dt: 'VARCHAR'},
    partitions := [{dt: '2016-05-14'}]);
----
1

# neither argument: unpartitioned, the whole root is read
query I
SELECT count(*) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/pa_orders',
    schema := {id: 'INTEGER', amount: 'DOUBLE', dt: 'VARCHAR'});
----
2

statement ok
DROP TABLE my_datalake.default.pa_orders;
