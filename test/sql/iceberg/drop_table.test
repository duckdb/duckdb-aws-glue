# name: test/sql/iceberg/drop_table.test
# description: DROP TABLE of Iceberg tables in Glue, and the listing of the catalog afterwards
# group: [iceberg]

require httpfs

require glue

require iceberg

require-env GLUE_CATALOG_ID

# Glue's Iceberg REST endpoint, which moto does not serve
require-env ICEBERG_SUPPORTED

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_drop;

# load the listing before the table exists
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ice_drop';
----
0

statement ok
CREATE TABLE my_datalake.default.ice_drop (id INTEGER) WITH (table_type = 'iceberg');

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ice_drop';
----
1

statement ok
INSERT INTO my_datalake.default.ice_drop VALUES (1), (2);

statement ok
DROP TABLE my_datalake.default.ice_drop;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ice_drop';
----
0

statement error
SELECT * FROM my_datalake.default.ice_drop;
----
<REGEX>:.*Catalog Error.*Table with name ice_drop does not exist.*

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.ice_drop');
----
<REGEX>:.*does not exist in Glue catalog.*

statement error
DROP TABLE my_datalake.default.ice_drop;
----
<REGEX>:.*Catalog Error.*Table with name ice_drop does not exist.*

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_drop;

# the name can be used again, as Iceberg or as Hive table
statement ok
CREATE TABLE my_datalake.default.ice_drop (id INTEGER, extra VARCHAR) WITH (table_type = 'iceberg');

query II
SELECT * FROM my_datalake.default.ice_drop;
----

statement ok
DROP TABLE my_datalake.default.ice_drop;

statement ok
CREATE TABLE my_datalake.default.ice_drop (id INTEGER);

query I
SELECT tags['table_type'] FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ice_drop';
----
HIVE

statement ok
DROP TABLE my_datalake.default.ice_drop;

# DROP VIEW does not drop an Iceberg table
statement ok
CREATE TABLE my_datalake.default.ice_drop (id INTEGER) WITH (table_type = 'iceberg');

statement error
DROP VIEW my_datalake.default.ice_drop;
----
<REGEX>:.*Catalog Error.*Existing object ice_drop is of type Table, trying to drop type View.*

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ice_drop';
----
1

statement ok
DROP TABLE my_datalake.default.ice_drop;
