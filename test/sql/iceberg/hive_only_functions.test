# name: test/sql/iceberg/hive_only_functions.test
# description: the Hive partition functions, the Hive partition DDL and hive_scan reject Iceberg tables
# group: [iceberg]

require httpfs

require glue

require iceberg

require-env GLUE_CATALOG_ID

# Glue's Iceberg REST endpoint, which moto does not serve
require-env ICEBERG_SUPPORTED

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_hive_only;

statement ok
CREATE TABLE my_datalake.default.ice_hive_only (id INTEGER, region VARCHAR) PARTITIONED BY (region)
WITH (table_type = 'iceberg');

statement error
SELECT * FROM glue_partitions('my_datalake.default.ice_hive_only');
----
<REGEX>:.*Not implemented Error.*glue_partitions only works on Hive tables, 'default.ice_hive_only' is a ICEBERG table.*

statement error
CALL glue_add_partition('my_datalake.default.ice_hive_only', {'region': 'eu'});
----
<REGEX>:.*Not implemented Error.*glue_add_partition only works on Hive tables.*

statement error
CALL glue_drop_partition('my_datalake.default.ice_hive_only', {'region': 'eu'});
----
<REGEX>:.*Not implemented Error.*glue_drop_partition only works on Hive tables.*

statement error
CALL glue_set_table_location('my_datalake.default.ice_hive_only', 's3://bucket/elsewhere');
----
<REGEX>:.*Not implemented Error.*glue_set_table_location only works on Hive tables.*

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement error
ALTER TABLE my_datalake.default.ice_hive_only ADD PARTITION (region = 'eu');
----
<REGEX>:.*Not implemented Error.*only works on Hive tables.*

statement error
ALTER TABLE my_datalake.default.ice_hive_only SET LOCATION 's3://bucket/elsewhere';
----
<REGEX>:.*Not implemented Error.*only works on Hive tables.*

statement ok
RESET active_grammar_extensions;

# the table is unchanged
query I
SELECT location LIKE '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ice_hive_only%' FROM glue_get_table_response('my_datalake.default.ice_hive_only');
----
true

statement ok
DROP TABLE my_datalake.default.ice_hive_only;
