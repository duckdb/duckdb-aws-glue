# name: test/sql/iceberg/create_table.test
# description: CREATE TABLE ... WITH (table_type = 'iceberg') creates an Iceberg table through Glue's Iceberg REST endpoint
# group: [iceberg]

require httpfs

require glue

require iceberg

require-env GLUE_CATALOG_ID

# Glue's Iceberg REST endpoint, which moto does not serve
require-env ICEBERG_SUPPORTED

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_create;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_create_upper;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_create_location;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_create_partitioned;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_create_hive;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_create_props;

#---------------------------------------------------------------------------
# table_type
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.ice_create (id INTEGER, name VARCHAR) WITH (table_type = 'iceberg');

# Glue registers it as an Iceberg table, under DEFAULT_LOCATION/<database>/<table>
query III
SELECT table_type, glue_table_type, location LIKE '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ice_create%'
FROM glue_get_table_response('my_datalake.default.ice_create');
----
ICEBERG	EXTERNAL_TABLE	true

query I
SELECT response.Parameters.metadata_location::VARCHAR LIKE '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ice_create%/metadata/%.metadata.json'
FROM glue_get_table_response('my_datalake.default.ice_create');
----
true

query II
SELECT table_name, tags['table_type'] FROM duckdb_tables()
WHERE database_name = 'my_datalake' AND table_name = 'ice_create';
----
ice_create	ICEBERG

query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.ice_create);
----
id	INTEGER
name	VARCHAR

query II
SELECT * FROM my_datalake.default.ice_create;
----

# the value of table_type is case insensitive
statement ok
CREATE TABLE my_datalake.default.ice_create_upper (id INTEGER) WITH (table_type = 'ICEBERG');

query I
SELECT table_type FROM glue_get_table_response('my_datalake.default.ice_create_upper');
----
ICEBERG

# table_type 'hive' is the default
statement ok
CREATE TABLE my_datalake.default.ice_create_hive (id INTEGER) WITH (table_type = 'Hive');

query I
SELECT table_type FROM glue_get_table_response('my_datalake.default.ice_create_hive');
----
HIVE

#---------------------------------------------------------------------------
# location, partitioning and table properties
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.ice_create_location (id INTEGER)
WITH (table_type = 'iceberg', location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/custom/ice_create_location/');

query I
SELECT location FROM glue_get_table_response('my_datalake.default.ice_create_location');
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/custom/ice_create_location

statement ok
CREATE TABLE my_datalake.default.ice_create_partitioned (id INTEGER, region VARCHAR)
PARTITIONED BY (region) WITH (table_type = 'iceberg');

statement ok
INSERT INTO my_datalake.default.ice_create_partitioned VALUES (1, 'eu'), (2, 'us'), (3, 'eu');

query II
SELECT * FROM my_datalake.default.ice_create_partitioned WHERE region = 'eu' ORDER BY id;
----
1	eu
3	eu

# the files are written in one directory per partition value
query I
SELECT count(*) > 0 FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ice_create_partitioned*/data/region=eu/*.parquet');
----
true

# other options are Iceberg table properties
statement ok
CREATE TABLE my_datalake.default.ice_create_props (id INTEGER)
WITH (table_type = 'iceberg', 'format-version' = 1, 'write.parquet.compression-codec' = 'zstd');

query I
SELECT value FROM iceberg_table_properties('my_datalake.default.ice_create_props')
WHERE key = 'write.parquet.compression-codec';
----
zstd

#---------------------------------------------------------------------------
# existing tables
#---------------------------------------------------------------------------
statement error
CREATE TABLE my_datalake.default.ice_create (id INTEGER) WITH (table_type = 'iceberg');
----
<REGEX>:.*Catalog Error.*Table with name "ice_create" already exists in Glue database "default".*

statement ok
CREATE TABLE IF NOT EXISTS my_datalake.default.ice_create (other BIGINT) WITH (table_type = 'iceberg');

# an existing Hive table is a conflict as well
statement error
CREATE TABLE my_datalake.default.ice_create_hive (id INTEGER) WITH (table_type = 'iceberg');
----
<REGEX>:.*Catalog Error.*Table with name "ice_create_hive" already exists in Glue database "default".*

statement error
CREATE OR REPLACE TABLE my_datalake.default.ice_create (id INTEGER) WITH (table_type = 'iceberg');
----
<REGEX>:.*Not implemented Error.*CREATE OR REPLACE TABLE is not supported for Glue catalogs.*

# a failed statement does not break the next lookups of the table
query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.ice_create);
----
id	INTEGER
name	VARCHAR

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'delta');
----
<REGEX>:.*Binder Error.*Unknown Glue table type 'delta' for option 'table_type', accepted values are 'hive' and 'iceberg'.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = NULL);
----
<REGEX>:.*Binder Error.*NULL is not a valid value for CREATE TABLE option 'table_type'.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', location = '');
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'location' must not be empty.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', location = '/');
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'location' must not be empty.*

# the options of Hive tables are rejected rather than stored as Iceberg table properties
statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', format = 'csv');
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'format' is only supported for Hive tables.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', delimiter = '|');
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'delimiter' is only supported for Hive tables.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', header = true);
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'header' is only supported for Hive tables.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', BucketColumns = ['id']);
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'BucketColumns' is only supported for Hive tables.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) WITH (table_type = 'iceberg', bucket_columns = ['id']);
----
<REGEX>:.*Binder Error.*CREATE TABLE option 'bucket_columns' is only supported for Hive tables.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER PRIMARY KEY) WITH (table_type = 'iceberg');
----
<REGEX>:.*Not implemented Error.*Only NOT NULL constraints are supported for Iceberg tables.*

statement error
CREATE TABLE my_datalake.default.ice_create_error (id INTEGER) PARTITIONED BY (missing) WITH (table_type = 'iceberg');
----
<REGEX>:.*missing.*

# none of the failed statements created a table
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ice_create_error';
----
0

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.ice_create_error');
----
<REGEX>:.*does not exist in Glue catalog.*

statement ok
DROP TABLE my_datalake.default.ice_create;

statement ok
DROP TABLE my_datalake.default.ice_create_upper;

statement ok
DROP TABLE my_datalake.default.ice_create_location;

statement ok
DROP TABLE my_datalake.default.ice_create_partitioned;

statement ok
DROP TABLE my_datalake.default.ice_create_hive;

statement ok
DROP TABLE my_datalake.default.ice_create_props;
