# name: test/sql/iceberg/time_travel.test
# description: Iceberg tables in Glue can be read at an earlier snapshot; Hive tables and views can not
# group: [iceberg]

require httpfs

require glue

require iceberg

require-env GLUE_CATALOG_ID

# Glue's Iceberg REST endpoint, which moto does not serve
require-env ICEBERG_SUPPORTED

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_tt;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_tt_hive;

statement ok
DROP VIEW IF EXISTS my_datalake.default.ice_tt_view;

statement ok
CREATE TABLE my_datalake.default.ice_tt (id INTEGER) WITH (table_type = 'iceberg');

statement ok
INSERT INTO my_datalake.default.ice_tt VALUES (1), (2);

statement ok
SET VARIABLE first_snapshot = (SELECT max(snapshot_id) FROM iceberg_snapshots('my_datalake.default.ice_tt'));

statement ok
INSERT INTO my_datalake.default.ice_tt VALUES (3);

statement ok
DELETE FROM my_datalake.default.ice_tt WHERE id = 1;

query I
SELECT count(*) FROM iceberg_snapshots('my_datalake.default.ice_tt');
----
3

query I
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM my_datalake.default.ice_tt;
----
2,3

query I
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM my_datalake.default.ice_tt AT (VERSION => getvariable('first_snapshot'));
----
1,2

statement error
SELECT * FROM my_datalake.default.ice_tt AT (VERSION => 1234);
----
<REGEX>:.*1234.*

#---------------------------------------------------------------------------
# only Iceberg tables support time travel
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.ice_tt_hive (id INTEGER);

statement ok
CREATE VIEW my_datalake.default.ice_tt_view AS SELECT 1 AS id;

statement error
SELECT * FROM my_datalake.default.ice_tt_hive AT (VERSION => 1);
----
<REGEX>:.*Binder Error.*Time travel is only supported for Iceberg tables in a Glue catalog, "ice_tt_hive" is not one.*

statement error
SELECT * FROM my_datalake.default.ice_tt_view AT (VERSION => 1);
----
<REGEX>:.*Binder Error.*Time travel is only supported for Iceberg tables in a Glue catalog, "ice_tt_view" is not one.*

statement error
SELECT * FROM my_datalake.default.ice_tt_missing AT (VERSION => 1);
----
<REGEX>:.*Catalog Error.*ice_tt_missing does not exist.*

statement ok
DROP TABLE my_datalake.default.ice_tt;

statement ok
DROP TABLE my_datalake.default.ice_tt_hive;

statement ok
DROP VIEW my_datalake.default.ice_tt_view;
