# name: test/sql/iceberg/dml.test
# description: SELECT, INSERT, UPDATE, DELETE and MERGE INTO on Iceberg tables in Glue
# group: [iceberg]

require httpfs

require glue

require iceberg

require-env GLUE_CATALOG_ID

# Glue's Iceberg REST endpoint, which moto does not serve
require-env ICEBERG_SUPPORTED

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_dml_orders;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ice_dml_customers;

statement ok
CREATE TABLE my_datalake.default.ice_dml_orders (order_id INTEGER, customer VARCHAR, amount DECIMAL(10,2), order_date DATE)
WITH (table_type = 'iceberg');

statement ok
CREATE TABLE my_datalake.default.ice_dml_customers (customer VARCHAR, country VARCHAR) WITH (table_type = 'iceberg');

#---------------------------------------------------------------------------
# INSERT
#---------------------------------------------------------------------------
query I
INSERT INTO my_datalake.default.ice_dml_orders VALUES
    (1, 'alice', 10.50, '2024-01-01'),
    (2, 'bob', 20.00, '2024-01-02'),
    (3, 'alice', 5.25, '2024-01-03');
----
3

query I
INSERT INTO my_datalake.default.ice_dml_orders
SELECT 3 + range, 'carol', range, DATE '2024-02-01' + range::INTEGER FROM range(1, 4);
----
3

# column lists in a different order, the missing column is NULL
statement ok
INSERT INTO my_datalake.default.ice_dml_orders (customer, order_id) VALUES ('dave', 7);

statement ok
INSERT INTO my_datalake.default.ice_dml_customers VALUES ('alice', 'NL'), ('bob', 'DE'), ('carol', 'NL');

query IIII
SELECT * FROM my_datalake.default.ice_dml_orders ORDER BY order_id;
----
1	alice	10.50	2024-01-01
2	bob	20.00	2024-01-02
3	alice	5.25	2024-01-03
4	carol	1.00	2024-02-02
5	carol	2.00	2024-02-03
6	carol	3.00	2024-02-04
7	dave	NULL	NULL

#---------------------------------------------------------------------------
# SELECT
#---------------------------------------------------------------------------
query II
SELECT customer, sum(amount) FROM my_datalake.default.ice_dml_orders
WHERE amount IS NOT NULL GROUP BY customer ORDER BY customer;
----
alice	15.75
bob	20.00
carol	6.00

query II
SELECT c.country, count(*) FROM my_datalake.default.ice_dml_orders o
JOIN my_datalake.default.ice_dml_customers c USING (customer)
GROUP BY c.country ORDER BY c.country;
----
DE	1
NL	5

query I
WITH big AS (SELECT * FROM my_datalake.default.ice_dml_orders WHERE amount >= 10)
SELECT string_agg(customer, ',' ORDER BY order_id) FROM big;
----
alice,bob

query I
SELECT count(*) FROM my_datalake.default.ice_dml_orders WHERE order_date BETWEEN '2024-02-01' AND '2024-02-03';
----
2

# unqualified names resolve through USE
statement ok
USE my_datalake.default;

query I
SELECT count(*) FROM ice_dml_orders;
----
7

statement ok
USE memory;

#---------------------------------------------------------------------------
# UPDATE
#---------------------------------------------------------------------------
query I
UPDATE my_datalake.default.ice_dml_orders SET amount = amount * 2 WHERE customer = 'carol';
----
3

query I
UPDATE my_datalake.default.ice_dml_orders SET amount = 0, order_date = '2024-03-01' WHERE customer = 'dave';
----
1

query III
SELECT order_id, amount, order_date FROM my_datalake.default.ice_dml_orders WHERE customer IN ('carol', 'dave') ORDER BY order_id;
----
4	2.00	2024-02-02
5	4.00	2024-02-03
6	6.00	2024-02-04
7	0.00	2024-03-01

#---------------------------------------------------------------------------
# DELETE
#---------------------------------------------------------------------------
query I
DELETE FROM my_datalake.default.ice_dml_orders WHERE order_id = 2;
----
1

query I
DELETE FROM my_datalake.default.ice_dml_orders WHERE order_id > 100;
----
0

query I
SELECT string_agg(order_id::VARCHAR, ',' ORDER BY order_id) FROM my_datalake.default.ice_dml_orders;
----
1,3,4,5,6,7

#---------------------------------------------------------------------------
# MERGE INTO
#---------------------------------------------------------------------------
statement ok
MERGE INTO my_datalake.default.ice_dml_customers t
USING (VALUES ('alice', 'BE'), ('erin', 'FR')) src(customer, country) ON t.customer = src.customer
WHEN MATCHED THEN UPDATE SET country = src.country
WHEN NOT MATCHED THEN INSERT VALUES (src.customer, src.country);

query II
SELECT * FROM my_datalake.default.ice_dml_customers ORDER BY customer;
----
alice	BE
bob	DE
carol	NL
erin	FR

#---------------------------------------------------------------------------
# explicit transactions are not supported for Iceberg tables
#---------------------------------------------------------------------------
statement ok
BEGIN;

statement error
INSERT INTO my_datalake.default.ice_dml_customers VALUES ('frank', 'IT');
----
<REGEX>:.*TransactionContext Error.*Transaction support is not provided for Glue catalogs.*

statement ok
ROLLBACK;

statement ok
BEGIN;

statement error
SELECT * FROM my_datalake.default.ice_dml_customers;
----
<REGEX>:.*TransactionContext Error.*Transaction support is not provided for Glue catalogs.*

statement ok
ROLLBACK;

statement ok
BEGIN;

statement error
UPDATE my_datalake.default.ice_dml_customers SET country = 'AT' WHERE customer = 'bob';
----
<REGEX>:.*TransactionContext Error.*Transaction support is not provided for Glue catalogs.*

statement ok
ROLLBACK;

statement ok
BEGIN;

statement error
DELETE FROM my_datalake.default.ice_dml_customers;
----
<REGEX>:.*TransactionContext Error.*Transaction support is not provided for Glue catalogs.*

statement ok
ROLLBACK;

# nothing was changed, and the next auto-commit statements work as before
query II
SELECT * FROM my_datalake.default.ice_dml_customers ORDER BY customer;
----
alice	BE
bob	DE
carol	NL
erin	FR

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
statement error
INSERT INTO my_datalake.default.ice_dml_orders VALUES (1, 'x', 1.0, '2024-01-01') RETURNING *;
----
<REGEX>:.*RETURNING clause not yet supported for insertion into Iceberg table.*

statement error
INSERT INTO my_datalake.default.ice_dml_orders VALUES (1, 'x');
----
<REGEX>:.*Binder Error.*table "ice_dml_orders" has 4 columns but 2 values were supplied.*

statement error
INSERT INTO my_datalake.default.ice_dml_orders (missing) VALUES (1);
----
<REGEX>:.*Binder Error.*does not have a column with name "missing".*

statement error
SELECT missing FROM my_datalake.default.ice_dml_orders;
----
<REGEX>:.*Binder Error.*Referenced column "missing" not found.*

statement error
SELECT * FROM my_datalake.default.ice_dml_does_not_exist;
----
<REGEX>:.*Catalog Error.*Table with name ice_dml_does_not_exist does not exist.*

# a failed write leaves the table as it was
statement error
INSERT INTO my_datalake.default.ice_dml_orders SELECT 100, error('boom'), 1.0, DATE '2024-01-01';
----
<REGEX>:.*boom.*

query I
SELECT count(*) FROM my_datalake.default.ice_dml_orders;
----
6

statement ok
DROP TABLE my_datalake.default.ice_dml_orders;

statement ok
DROP TABLE my_datalake.default.ice_dml_customers;
