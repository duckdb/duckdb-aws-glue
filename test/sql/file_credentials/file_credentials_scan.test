# name: test/sql/file_credentials/file_credentials_scan.test
# description: a table read with credentials lists and opens every file with them; a table without reads by path, through the listing cache
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/cred_scan' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/plain_scan' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

# the tables, created in Glue
statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_scan", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_scan", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/cred_scan/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "plain_scan", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/plain_scan", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}');

#---------------------------------------------------------------------------
# with credentials: the cardinality sample lists the root once and the scan reads the same listing, cached under the
# credentials; every listing and open carries the credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.cred_scan;
----
3

query IIII
SELECT count(*) FILTER (listing), count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
1	true	true	true

query I
SELECT count(*) FROM glue_test_credentials_reads() WHERE listing AND path = '{TEST_DIR}/cred_scan/**';
----
1

# a read of the same files by path carries no credentials
statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM read_parquet('{TEST_DIR}/cred_scan/*.parquet');
----
3

query I
SELECT count(*) FROM glue_test_credentials_reads() WHERE has_credentials;
----
0

#---------------------------------------------------------------------------
# a DESCRIBE lists and opens none of the files of a table read with credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT column_name, column_type FROM (DESCRIBE cred.default.cred_scan);
----
i	BIGINT

query I
SELECT count(*) FROM glue_test_credentials_reads();
----
0

#---------------------------------------------------------------------------
# without credentials: the sample and the scan share one cached listing, and nothing carries credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.plain_scan;
----
3

query III
SELECT count(*) FILTER (listing), count(*) FILTER (NOT listing) > 0, bool_or(has_credentials) FROM glue_test_credentials_reads();
----
1	true	false

#---------------------------------------------------------------------------
# a write uses no credentials, so INSERT into a table with credentials is refused
#---------------------------------------------------------------------------
statement error
INSERT INTO cred.default.cred_scan VALUES (42);
----
Not implemented Error: INSERT into Glue table 'cred_scan', which is read with file credentials, is not supported

#---------------------------------------------------------------------------
# a CTE referenced twice over a table with credentials: the scan is not copied through serialization, which would drop
# the credentials, so every open carries it
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
WITH c AS (SELECT i FROM cred.default.cred_scan) SELECT (SELECT sum(i) FROM c), (SELECT count(*) FROM c);
----
3	3

query II
SELECT count(*) FILTER (NOT listing) > 0, bool_and(has_credentials AND key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true

# NOT MATERIALIZED has no effect here: CTE inlining copies the definition through serialization, which the scan
# refuses, so the CTE stays materialized and every open carries the credentials
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
WITH c AS NOT MATERIALIZED (SELECT i FROM cred.default.cred_scan) SELECT (SELECT sum(i) FROM c), (SELECT count(*) FROM c);
----
3	3

query II
SELECT count(*) FILTER (NOT listing) > 0, bool_and(has_credentials AND key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true

#---------------------------------------------------------------------------
# a window aggregate over the whole partition: the window self-join rewrite joins the scan with a copy of it made
# through serialization. It rewrites the query over the table without credentials, and not over the table with one,
# whose opens all carry the credentials
#---------------------------------------------------------------------------
query II
EXPLAIN SELECT i, count(*) OVER (PARTITION BY i) FROM cred.default.plain_scan;
----
physical_plan	<REGEX>:.*(HASH_JOIN|Hash Join).*

query II
EXPLAIN SELECT i, count(*) OVER (PARTITION BY i) FROM cred.default.cred_scan;
----
physical_plan	<!REGEX>:.*(HASH_JOIN|Hash Join).*

statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT i, count(*) OVER (PARTITION BY i) FROM cred.default.cred_scan ORDER BY i;
----
0	1
1	1
2	1

query II
SELECT count(*) FILTER (NOT listing) > 0, bool_and(has_credentials AND key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true

#---------------------------------------------------------------------------
# with the serializer verifier on, a plan is serialized, deserialized and run as deserialized. The scan with credentials
# cannot be serialized, so the verifier keeps the plan as bound and every open carries the credentials
#---------------------------------------------------------------------------
statement ok
SET debug_verify_serializer = true;

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.cred_scan;
----
3

query II
SELECT count(*) FILTER (NOT listing) > 0, bool_and(has_credentials AND key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true

statement ok
SET debug_verify_serializer = false;

statement ok
DROP TABLE IF EXISTS cred.default.cred_scan;

statement ok
DROP TABLE IF EXISTS cred.default.plain_scan;
