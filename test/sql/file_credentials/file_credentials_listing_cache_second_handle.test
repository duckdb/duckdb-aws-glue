# name: test/sql/file_credentials/file_credentials_listing_cache_second_handle.test
# description: listing cache for reads with credentials: one query, two tables at the same location with different credentials of the same scope, and one without credentials: each table's credentials list on their own, and so does the table without one, and each table's opens carry its own credentials
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/lc' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

# lc_a and lc_b are at the same location, each with its own credentials and the same scope, to secrets with key ids LC_A and
# LC_B; lc_plain has no credentials
statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_a", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/lc/', key_id = 'LC_A');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_b", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/lc/', key_id = 'LC_B');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_plain", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}');

#---------------------------------------------------------------------------
# one query, two tables at the same location with different credentials of the same scope, and one without credentials:
# each table's credentials list on their own, and so does the table without any
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query III
SELECT (SELECT sum(i) FROM cred.default.lc_a), (SELECT sum(i) FROM cred.default.lc_b), (SELECT sum(i) FROM cred.default.lc_plain);
----
3	3	3

query II
SELECT count(*) FILTER (listing AND has_credentials), count(*) FILTER (listing AND NOT has_credentials) FROM glue_test_credentials_reads();
----
2	1

# the three scans are not merged into one: each table's files are opened as many times with its own credentials (lc_a's,
# lc_b's) or with none (lc_plain)
query III
SELECT count(*) FILTER (NOT listing AND key_id = 'LC_A') > 0, count(*) FILTER (NOT listing AND key_id = 'LC_A') = count(*) FILTER (NOT listing AND key_id = 'LC_B'), count(*) FILTER (NOT listing AND key_id = 'LC_A') = count(*) FILTER (NOT listing AND NOT has_credentials) FROM glue_test_credentials_reads();
----
true	true	true

statement ok
DROP TABLE IF EXISTS cred.default.lc_a;

statement ok
DROP TABLE IF EXISTS cred.default.lc_b;

statement ok
DROP TABLE IF EXISTS cred.default.lc_plain;
