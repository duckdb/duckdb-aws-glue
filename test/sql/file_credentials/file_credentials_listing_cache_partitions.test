# name: test/sql/file_credentials/file_credentials_listing_cache_partitions.test
# description: listing cache for reads with credentials: a partitioned table lists each partition, or the root, once per query, also with two scans of the table in the query; a second query in the same transaction lists again; a table without credentials at the same location is unchanged
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

# the table and its partitions are registered in Glue through plain; cred reads the partitions from Glue, and its
# scans of the table with credentials
statement ok
attach '{GLUE_CATALOG_ID}' as plain (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}', DEFAULT_LOCATION '{TEST_DIR}');

statement ok
DROP TABLE IF EXISTS plain.default.lc_part;

statement ok
CREATE TABLE plain.default.lc_part (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

# the first COPY creates the directory that holds the table root
statement ok
COPY (SELECT 1 AS i) TO '{TEST_DIR}/default' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT 1 AS id, 'a' AS dt UNION ALL SELECT 2, 'b') TO '{TEST_DIR}/default/lc_part' (FORMAT parquet, PARTITION_BY (dt));

statement ok
CALL glue_add_partition('plain.default.lc_part', {dt: 'a'});

statement ok
CALL glue_add_partition('plain.default.lc_part', {dt: 'b'});

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

# scans of lc_part through cred read with credentials; through plain, without
statement ok
PRAGMA glue_test_credentials('cred', 'lc_part', '{TEST_DIR}/default/lc_part/');

#---------------------------------------------------------------------------
# below the threshold each partition is listed on its own: the sample's listing of the first partition and the
# scan's listing of each partition share one listing per partition
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(id) FROM cred.default.lc_part;
----
3

query IIII
SELECT path, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() WHERE listing GROUP BY path ORDER BY path;
----
{TEST_DIR}/default/lc_part/dt=a/**	1	true	true
{TEST_DIR}/default/lc_part/dt=b/**	1	true	true

# two scans of the table in one query: still one listing per partition
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT (SELECT sum(id) FROM cred.default.lc_part), (SELECT count(*) FROM cred.default.lc_part WHERE dt = 'b');
----
3	1

query IIII
SELECT path, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() WHERE listing GROUP BY path ORDER BY path;
----
{TEST_DIR}/default/lc_part/dt=a/**	1	true	true
{TEST_DIR}/default/lc_part/dt=b/**	1	true	true

# two queries in one transaction: the second query lists each partition again
statement ok
BEGIN;

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(id) FROM cred.default.lc_part;
----
3

query I
SELECT sum(id) FROM cred.default.lc_part;
----
3

query II
SELECT path, count(*) FROM glue_test_credentials_reads() WHERE listing AND has_credentials GROUP BY path ORDER BY path;
----
{TEST_DIR}/default/lc_part/dt=a/**	2
{TEST_DIR}/default/lc_part/dt=b/**	2

statement ok
COMMIT;

#---------------------------------------------------------------------------
# at the threshold the root is listed once for the partitions below it: the sample and both scans share it
#---------------------------------------------------------------------------
statement ok
SET hive_partition_listing_threshold = 1;

statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT (SELECT sum(id) FROM cred.default.lc_part), (SELECT count(*) FROM cred.default.lc_part WHERE dt = 'b');
----
3	1

query IIII
SELECT path, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() WHERE listing GROUP BY path ORDER BY path;
----
{TEST_DIR}/default/lc_part/**	1	true	true

statement ok
RESET hive_partition_listing_threshold;

#---------------------------------------------------------------------------
# the same table through plain, without credentials: one listing per partition and query, none with credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT (SELECT sum(id) FROM plain.default.lc_part), (SELECT count(*) FROM plain.default.lc_part WHERE dt = 'b');
----
3	1

query III
SELECT path, count(*), bool_or(has_credentials) FROM glue_test_credentials_reads() WHERE listing GROUP BY path ORDER BY path;
----
{TEST_DIR}/default/lc_part/dt=a/**	1	false
{TEST_DIR}/default/lc_part/dt=b/**	1	false

statement ok
DROP TABLE plain.default.lc_part;
