# name: test/sql/file_credentials/file_credentials_csv.test
# description: the cardinality sample of a csv or gzip csv table read with credentials opens the file it measures with the credentials, as the scan does
# group: [file_credentials]

require httpfs

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(5) t(i)) TO '{TEST_DIR}/cred_csv' (FORMAT csv, HEADER false, PER_THREAD_OUTPUT true);

# large enough to compress below its size, which the sample reads from the gzip trailer
statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_csv_gzip' (FORMAT csv, HEADER false, COMPRESSION gzip, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_csv", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_csv", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe", "Parameters": {"field.delim": ","}}}}', credentials = '{TEST_DIR}/cred_csv/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_csv_gzip", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_csv_gzip", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe", "Parameters": {"field.delim": ","}}}}', credentials = '{TEST_DIR}/cred_csv_gzip/');

#---------------------------------------------------------------------------
# csv: planning runs the cardinality sample alone, which lists the root and opens the file it measures to count its
# lines
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_csv;

query IIII
SELECT listing, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() GROUP BY listing ORDER BY listing;
----
false	1	true	true
true	1	true	true

#---------------------------------------------------------------------------
# gzip csv: the sample also opens the file to read the uncompressed size its gzip trailer records
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_csv_gzip;

query IIII
SELECT listing, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() GROUP BY listing ORDER BY listing;
----
false	2	true	true
true	1	true	true

#---------------------------------------------------------------------------
# the scans read every row with the credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT (SELECT sum(i) FROM cred.default.cred_csv), (SELECT sum(i) FROM cred.default.cred_csv_gzip);
----
10	49995000

query II
SELECT count(*) > 0, bool_and(has_credentials AND key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true

statement ok
DROP TABLE IF EXISTS cred.default.cred_csv;

statement ok
DROP TABLE IF EXISTS cred.default.cred_csv_gzip;
