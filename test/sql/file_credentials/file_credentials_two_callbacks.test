# name: test/sql/file_credentials/file_credentials_two_callbacks.test
# description: with two credentials callbacks registered, a scan of a Glue table fails rather than pick one of them
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/two_callbacks' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "two_callbacks", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/two_callbacks", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/two_callbacks/');

query I
SELECT sum(i) FROM cred.default.two_callbacks;
----
3

statement ok
PRAGMA glue_test_credentials_register;

statement error
SELECT sum(i) FROM cred.default.two_callbacks;
----
More than one extension registered a GlueFileCredentialsCallback

statement ok
DROP TABLE IF EXISTS cred.default.two_callbacks;
