# name: test/sql/file_credentials/file_credentials_listing_cache_connections.test
# description: listing cache for reads with credentials: concurrent queries on several connections each list the table once per query, with the credentials their own transaction gives it
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/lc' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_connections", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/lc/');

statement ok
PRAGMA glue_test_credentials_clear_reads;

# two scans of the table per query, on eight connections at once
concurrentloop i 0 8

query I
SELECT (SELECT sum(i) FROM cred.default.lc_connections) + (SELECT count(*) FROM cred.default.lc_connections);
----
6

endloop

# one listing per query, made and read with the credentials; with no cache for them there would be three per query
# (the sample's and each scan's)
query IIII
SELECT count(*) FILTER (listing), count(*) FILTER (listing AND key_id = 'GLUE_TEST_CREDENTIALS'), count(*) FILTER (NOT listing) > 0, bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
8	8	true	true

statement ok
DROP TABLE IF EXISTS cred.default.lc_connections;
