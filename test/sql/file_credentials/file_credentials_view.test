# name: test/sql/file_credentials/file_credentials_view.test
# description: a Glue view reads no files itself; in one query of a view that joins a table read with credentials and one without, each table's files are read with its own credentials or with none
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/view_handle' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/view_plain' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "view_handle", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/view_handle", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/view_handle/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "view_plain", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/view_plain", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}');

statement ok
DROP VIEW IF EXISTS cred.default.view_join;

statement ok
CREATE VIEW cred.default.view_join AS SELECT h.i FROM cred.default.view_handle h JOIN cred.default.view_plain p ON h.i = p.i;

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.view_join;
----
3

query IIII
SELECT count(*) FILTER (listing) > 0, count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() WHERE starts_with(path, '{TEST_DIR}/view_handle/');
----
true	true	true	true

query III
SELECT count(*) FILTER (listing) > 0, count(*) FILTER (NOT listing) > 0, bool_or(has_credentials) FROM glue_test_credentials_reads() WHERE starts_with(path, '{TEST_DIR}/view_plain/');
----
true	true	false

statement ok
DROP TABLE IF EXISTS cred.default.view_handle;

statement ok
DROP TABLE IF EXISTS cred.default.view_plain;

statement ok
DROP VIEW IF EXISTS cred.default.view_join;
