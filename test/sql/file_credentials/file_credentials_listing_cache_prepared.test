# name: test/sql/file_credentials/file_credentials_listing_cache_prepared.test
# description: listing cache for reads with credentials: a prepared statement executed in later transactions binds the table again, with a new credentials, and lists again
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(3) t(i)) TO '{TEST_DIR}/lc' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

# lc_a and lc_b are at the same location, each with its own credentials and the same scope; lc_plain has no credentials
statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_a", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/lc/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_b", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}', credentials = '{TEST_DIR}/lc/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "lc_plain", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/lc", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"}}}');

statement ok
COPY (SELECT 10 AS i) TO '{TEST_DIR}/lc/f2.parquet' (FORMAT parquet);

#---------------------------------------------------------------------------
# a prepared statement executed in later transactions binds the table again, with a new credentials, and lists again
#---------------------------------------------------------------------------
statement ok
PREPARE scan_a AS SELECT sum(i) FROM cred.default.lc_a;

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
EXECUTE scan_a;
----
13

statement ok
BEGIN;

query I
EXECUTE scan_a;
----
13

statement ok
COMMIT;

query I
EXECUTE scan_a;
----
13

query II
SELECT count(*) FILTER (listing AND has_credentials), bool_and(has_credentials) FROM glue_test_credentials_reads();
----
3	true

statement ok
DROP TABLE IF EXISTS cred.default.lc_a;

statement ok
DROP TABLE IF EXISTS cred.default.lc_b;

statement ok
DROP TABLE IF EXISTS cred.default.lc_plain;
