#---------------------------------------------------------------------------
# avro: there is no sample, so planning reads nothing; the scan lists the root once and opens every file, all with
# the credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_avro;

query I
SELECT count(*) FROM glue_test_credentials_reads();
----
0

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.cred_avro;
----
49995000

query IIII
SELECT count(*) FILTER (listing), count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
1	true	true	true

statement ok
DROP TABLE IF EXISTS cred.default.cred_json;

statement ok
DROP TABLE IF EXISTS cred.default.cred_json_gzip;

statement ok
DROP TABLE IF EXISTS cred.default.cred_json_zstd;

statement ok
DROP TABLE IF EXISTS cred.default.cred_opencsv;

statement ok
DROP TABLE IF EXISTS cred.default.cred_csv_zstd;

statement ok
DROP TABLE IF EXISTS cred.default.cred_avro;
