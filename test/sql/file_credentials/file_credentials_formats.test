# name: test/sql/file_credentials/file_credentials_formats.test
# description: a json, OpenCSVSerde csv, zstd csv, zstd json or avro table read with credentials lists and opens every file with it, in the cardinality sample and in the scan
# group: [file_credentials]

require httpfs

require json

require avro

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_json' (FORMAT json, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_json_gzip' (FORMAT json, COMPRESSION gzip, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_json_zstd' (FORMAT json, COMPRESSION zstd, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_opencsv' (FORMAT csv, HEADER false, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_csv_zstd' (FORMAT csv, HEADER false, COMPRESSION zstd, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT * FROM range(10000) t(i)) TO '{TEST_DIR}/cred_avro' (FORMAT avro, PER_THREAD_OUTPUT true);

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_json", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_json", "SerdeInfo": {"SerializationLibrary": "org.apache.hive.hcatalog.data.JsonSerDe"}}}', credentials = '{TEST_DIR}/cred_json/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_json_gzip", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_json_gzip", "SerdeInfo": {"SerializationLibrary": "org.apache.hive.hcatalog.data.JsonSerDe"}}}', credentials = '{TEST_DIR}/cred_json_gzip/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_json_zstd", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_json_zstd", "SerdeInfo": {"SerializationLibrary": "org.apache.hive.hcatalog.data.JsonSerDe"}}}', credentials = '{TEST_DIR}/cred_json_zstd/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_opencsv", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_opencsv", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.serde2.OpenCSVSerde", "Parameters": {"separatorChar": ","}}}}', credentials = '{TEST_DIR}/cred_opencsv/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_csv_zstd", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_csv_zstd", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe", "Parameters": {"field.delim": ","}}}}', credentials = '{TEST_DIR}/cred_csv_zstd/');

statement ok
PRAGMA glue_test_credentials_create('cred', '{"Name": "cred_avro", "DatabaseName": "default", "TableType": "EXTERNAL_TABLE", "StorageDescriptor": {"Columns": [{"Name": "i", "Type": "bigint"}], "Location": "{TEST_DIR}/cred_avro", "SerdeInfo": {"SerializationLibrary": "org.apache.hadoop.hive.serde2.avro.AvroSerDe"}}}', credentials = '{TEST_DIR}/cred_avro/');

#---------------------------------------------------------------------------
# json: the sample lists the root and opens the file it measures to count its lines; a query runs the sample and the
# scan, and the scan reads the sample's listing of the root (cached under the credentials) and opens every file, all with the
# credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_json;

query IIII
SELECT listing, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() GROUP BY listing ORDER BY listing;
----
false	1	true	true
true	1	true	true

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.cred_json;
----
49995000

query IIII
SELECT count(*) FILTER (listing), count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
1	true	true	true

#---------------------------------------------------------------------------
# gzip json: the sample also opens the file to read the uncompressed size its gzip trailer records; a query runs the
# sample and the scan, and the scan reads the sample's listing of the root (cached under the credentials) and opens every
# file, all with the credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_json_gzip;

query IIII
SELECT listing, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() GROUP BY listing ORDER BY listing;
----
false	2	true	true
true	1	true	true

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.cred_json_gzip;
----
49995000

query IIII
SELECT count(*) FILTER (listing), count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
1	true	true	true

#---------------------------------------------------------------------------
# zstd json: the sample lists the root and skips the .zst file without opening it; a query runs the sample and the
# scan, and the scan reads the sample's listing of the root (cached under the credentials) and opens every file, all with the
# credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_json_zstd;

query IIII
SELECT listing, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() GROUP BY listing ORDER BY listing;
----
true	1	true	true

statement ok
PRAGMA glue_test_credentials_clear_reads;

query I
SELECT sum(i) FROM cred.default.cred_json_zstd;
----
49995000

query IIII
SELECT count(*) FILTER (listing), count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
1	true	true	true

