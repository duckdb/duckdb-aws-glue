#---------------------------------------------------------------------------
# zstd csv: the sample lists the root and skips the .zst file without opening it; a query runs the sample and the
# scan, and the scan reads the sample's listing of the root (cached under the credentials) and opens every file, all with the
# credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement ok
EXPLAIN SELECT sum(i) FROM cred.default.cred_csv_zstd;

query IIII
SELECT listing, count(*), bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads() GROUP BY listing ORDER BY listing;
----
true	1	true	true

