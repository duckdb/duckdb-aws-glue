# name: test/sql/file_credentials/file_credentials_partitions.test
# description: a partitioned table read with credentials lists every partition with it, whether each partition is listed on its own or the root is listed once; listing a partition outside the table location fails
# group: [file_credentials]

require httpfs

require parquet

require glue

require glue_test_credentials

require-env GLUE_CATALOG_ID

statement ok
PRAGMA glue_test_credentials_record('{TEST_DIR}');

# the table and its partitions are registered in Glue through plain; cred reads the partitions from Glue, and its
# scans of the table with credentials
statement ok
attach '{GLUE_CATALOG_ID}' as plain (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}', DEFAULT_LOCATION '{TEST_DIR}');

statement ok
DROP TABLE IF EXISTS plain.default.cred_part;

statement ok
CREATE TABLE plain.default.cred_part (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

# two partitions below the table root (the first COPY creates the directory that holds the table root)
statement ok
COPY (SELECT 1 AS i) TO '{TEST_DIR}/default' (FORMAT parquet, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT 1 AS id, 'a' AS dt UNION ALL SELECT 2, 'b') TO '{TEST_DIR}/default/cred_part' (FORMAT parquet, PARTITION_BY (dt));

statement ok
CALL glue_add_partition('plain.default.cred_part', {dt: 'a'});

statement ok
CALL glue_add_partition('plain.default.cred_part', {dt: 'b'});

# a partition registered at a location outside the table root
statement ok
COPY (SELECT 3 AS id, 'c' AS dt) TO '{TEST_DIR}/elsewhere' (FORMAT parquet, PARTITION_BY (dt));

statement ok
CALL glue_add_partition('plain.default.cred_part', {dt: 'c'}, location := '{TEST_DIR}/elsewhere/dt=c');

# a partition registered beside the table root, in a directory whose name starts with the table root's name: it is
# outside the table location, and outside the credentials' scope (the location followed by '/')
statement ok
COPY (SELECT 4 AS id, 'x' AS dt) TO '{TEST_DIR}/default/cred_part_archive' (FORMAT parquet, PARTITION_BY (dt));

statement ok
CALL glue_add_partition('plain.default.cred_part', {dt: 'x'}, location := '{TEST_DIR}/default/cred_part_archive/dt=x');

query II
SELECT dt, location FROM glue_partitions('plain.default.cred_part') ORDER BY dt;
----
a	{TEST_DIR}/default/cred_part/dt=a
b	{TEST_DIR}/default/cred_part/dt=b
c	{TEST_DIR}/elsewhere/dt=c
x	{TEST_DIR}/default/cred_part_archive/dt=x

statement ok
attach '{GLUE_CATALOG_ID}' as cred (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA glue_test_credentials('cred', 'cred_part', '{TEST_DIR}/default/cred_part/');

#---------------------------------------------------------------------------
# below the threshold each partition is listed on its own (ListPartition, and the sample's listing of the first
# partition in ListSampleDirectory)
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT id, dt FROM cred.default.cred_part WHERE dt IN ('a', 'b') ORDER BY id;
----
1	a
2	b

query III
SELECT count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true	true

query I
SELECT DISTINCT path FROM glue_test_credentials_reads() WHERE listing ORDER BY path;
----
{TEST_DIR}/default/cred_part/dt=a/**
{TEST_DIR}/default/cred_part/dt=b/**

#---------------------------------------------------------------------------
# at the threshold the root is listed once for the partitions below it (ListRoot, and SampleRootPartition)
#---------------------------------------------------------------------------
statement ok
SET hive_partition_listing_threshold = 1;

statement ok
PRAGMA glue_test_credentials_clear_reads;

query II
SELECT id, dt FROM cred.default.cred_part WHERE dt IN ('a', 'b') ORDER BY id;
----
1	a
2	b

query III
SELECT count(*) FILTER (NOT listing) > 0, bool_and(has_credentials), bool_and(key_id = 'GLUE_TEST_CREDENTIALS') FROM glue_test_credentials_reads();
----
true	true	true

query I
SELECT DISTINCT path FROM glue_test_credentials_reads() WHERE listing ORDER BY path;
----
{TEST_DIR}/default/cred_part/**

statement ok
RESET hive_partition_listing_threshold;

#---------------------------------------------------------------------------
# a partition outside the table root is not read: listing it with the table's credentials fails, also when the scan
# reads partitions below the root as well
#---------------------------------------------------------------------------
statement ok
PRAGMA glue_test_credentials_clear_reads;

statement error
SELECT id FROM cred.default.cred_part WHERE dt = 'c';
----
The file secret of '{TEST_DIR}/default/cred_part/' cannot be used for '{TEST_DIR}/elsewhere/dt=c/**'

statement error
SELECT id FROM cred.default.cred_part WHERE dt = 'x';
----
The file secret of '{TEST_DIR}/default/cred_part/' cannot be used for '{TEST_DIR}/default/cred_part_archive/dt=x/**'

statement error
SELECT id FROM cred.default.cred_part;
----
cannot be used for

# no listing or open outside the scope was made with the credentials
query I
SELECT count(*) FROM glue_test_credentials_reads() WHERE key_id IS NOT NULL AND NOT starts_with(path, '{TEST_DIR}/default/cred_part/');
----
0

statement ok
DROP TABLE plain.default.cred_part;
