# name: test/sql/child_catalogs/child_catalog_listing_all.test
# description: with LIST_CHILD_CATALOGS a listing asks Glue for the child catalogs and their databases: one GetCatalogs and one GetDatabases per catalog
# group: [child_catalogs]

require httpfs

require glue

require-env GLUE_FLOCI_ENDPOINT

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok
SET redact_http_logs = false;

statement ok
attach '{GLUE_FLOCI_CATALOG_ID}' as lake (
    TYPE glue,
    ENDPOINT '{GLUE_FLOCI_ENDPOINT}',
    LIST_CHILD_CATALOGS true
);

statement ok
CALL enable_logging('HTTP', storage := 'memory');

statement ok
CALL truncate_duckdb_logs();

query II
SELECT schema_name, parent_schema FROM duckdb_schemas() WHERE database_name = 'lake'
AND schema_name IN ('s3tablescatalog', 'salesdemo', 'archive', 'retail') AND parent_schema IS DISTINCT FROM NULL
OR database_name = 'lake' AND schema_name = 's3tablescatalog' ORDER BY ALL;
----
archive	s3tablescatalog
retail	archive
retail	salesdemo
s3tablescatalog	NULL
salesdemo	s3tablescatalog

# the attached catalog, s3tablescatalog with its two table buckets, and the two catalogs the fault tests use
query II
SELECT glue_calls('GetCatalogs'), glue_calls('GetDatabases');
----
1	6

# listed once: the next listing asks nothing
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'lake' AND parent_schema IN ('salesdemo', 'archive');
----
2

query II
SELECT glue_calls('GetCatalogs'), glue_calls('GetDatabases');
----
0	0

statement ok
CALL disable_logging();

query III
SELECT s.parent_schema, t.table_name, t.tags['table_type'] FROM duckdb_tables() t JOIN duckdb_schemas() s
ON t.schema_oid = s.oid WHERE t.database_name = 'lake' AND s.parent_schema IN ('salesdemo', 'archive') ORDER BY ALL;
----
archive	widget_sales	ICEBERG
salesdemo	pending	ICEBERG
salesdemo	widget_sales	ICEBERG

# the option changes what is listed, not what a path reaches
statement error
SELECT * FROM lake.s3tablescatalog.salesdemo.retail.widget_sales;
----
can not read yet

statement error
attach '{GLUE_FLOCI_CATALOG_ID}' as bad_option (TYPE glue, ENDPOINT '{GLUE_FLOCI_ENDPOINT}', LIST_CHILD_CATALOGS 'maybe');
----
