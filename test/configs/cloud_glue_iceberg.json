{
	"description": "duckdb-iceberg's catalog_agnostic sqllogictests against the Iceberg tables of a live AWS Glue Data Catalog, attached with TYPE GLUE as my_datalake; run from the duckdb-iceberg source directory (make test-cloud-iceberg). Credentials from the AWS credential chain",
	"comment": "DEFAULT_LOCATION gives the tables and schemas the tests create a location (Glue databases usually have no LocationUri). glue_default_table_type makes their plain CREATE TABLE an Iceberg table. glue_network_calls_via_duckdb = false keeps the Glue API calls out of the HTTP log, which some tests count requests in. skip_error_messages replaces the runner's default ('HTTP', ...), so REST errors fail a test instead of skipping it",
	"on_init": "CREATE SECRET (TYPE S3, PROVIDER credential_chain, REGION '{GLUE_REGION}'); SET GLOBAL glue_network_calls_via_duckdb = false; SET GLOBAL glue_default_table_type = 'iceberg'; ATTACH IF NOT EXISTS '{GLUE_CATALOG_ID}' AS my_datalake (TYPE GLUE, REGION '{GLUE_REGION}', DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}'); CREATE SCHEMA IF NOT EXISTS my_datalake.default;",
	"skip_error_messages": [
		"Transaction support is not provided for Glue catalogs",
		"is not an Iceberg catalog (type='glue')",
		"Cannot call set_iceberg_schema_properties on non-iceberg schema",
		"RenameTable endpoint is not supported for Glue Catalog"
	],
	"statically_loaded_extensions": [
		"core_functions",
		"parquet",
		"json",
		"avro",
		"httpfs",
		"aws",
		"iceberg",
		"glue"
	],
	"test_env": [
		{
			"env_name": "CATALOG_TEST_CONFIG_SETUP",
			"env_value": "glue"
		},
		{
			"env_name": "GLUE_CATALOG_ID",
			"env_value": "847122343688"
		},
		{
			"env_name": "GLUE_REGION",
			"env_value": "eu-north-1"
		},
		{
			"env_name": "DEFAULT_S3_LOCATION",
			"env_value": "s3://tom-glue-tables-test-bucket/duckdb-iceberg-catalog-agnostic"
		},
		{
			"env_name": "SCAN_PLANNING_MODE",
			"env_value": "client"
		},
		{
			"env_name": "TIMETRAVEL_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SNAPSHOT_HISTORY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_FILE_READ_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "FORMAT_V3_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "GEOMETRY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "UNKNOWN_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "VARIANT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "COLUMN_DEFAULT_SUPPORT",
			"env_value": "true"
		}
	],
	"skip_tests": [
		{
			"reason": "DROP SCHEMA my_datalake.default CASCADE expects duckdb-iceberg's refusal, but a Glue catalog drops the database 'default' with all of its tables",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/test_cascade.test"
			]
		},
		{
			"reason": "keeps SF1 TPC-H tables in my_datalake.default across runs, but every run writes under its own S3 prefix and deletes it afterwards",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/test_tpch.test"
			]
		},
		{
			"reason": "Glue catalogs refuse Iceberg tables in explicit transactions, and these tests clear skip_error_messages (set ignore_error_messages) before their first transaction",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_multi_table_commit.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_staged_create.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_view.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_view_transactions.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/alter_unknown_type.test"
			]
		},
		{
			"reason": "clear skip_error_messages (set ignore_error_messages) before calling a duckdb-iceberg function that refuses a Glue catalog (iceberg_rewrite_data_files, set_iceberg_schema_properties)",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_data_files_plan_shape.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_namespace_properties.test"
			]
		},
		{
			"reason": "Glue's Iceberg REST endpoint does not plan scans on the server",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_partition_value_encoding.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_plan.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_plan_batches.test_slow",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_plan_equality.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_plan_with_defaults.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_tasks.test"
			]
		},
		{
			"reason": "MERGE INTO binds its target to the hidden Iceberg catalog, so the target's qualified name (my_datalake.default.t.id) does not resolve",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/merge_timestamp.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/merge_partition_update.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/merge_partition_insert.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/merge_multi_partition_timestamp.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/merge_partition.test"
			]
		},
		{
			"reason": "expect duckdb-iceberg's error messages for a missing or non-empty schema; the Glue catalog reports them itself",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_missing_schema.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_table_non_existent_schema.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_and_delete_schema_table.test"
			]
		},
		{
			"reason": "USE of the catalog without a default schema, or of a schema that does not exist, fails on a Glue catalog attached without DEFAULT_SCHEMA",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/test_use.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_request_nonexistent_table.test"
			]
		},
		{
			"reason": "CREATE TABLE binds against the Glue catalog, and DuckDB only allows ICEBERG_FIXED columns in an Iceberg catalog",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_fixed_type.test"
			]
		},
		{
			"reason": "count Iceberg log entries of a scan, which come out twice the expected number when the table is read through the Glue catalog (not yet investigated)",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/combined/test_identity_and_year.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/multi_insert/test_manifest_skip_combined_transforms.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/multi_insert/test_multiple_inserts_manifest_list_skip.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/multi_insert/test_manifest_skip_year_transform.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/test_insert_into_partitioned_table_month.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/large/test_large_multiple_inserts.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/logging/test_partition_read_logging.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/logging/test_partition_read_logic_month.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/logging/test_reads_on_bounds.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/partitioning/struct_filter_issue.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads/test_in_filter_partition_pruning.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_requests_to_partitioned_table.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_struct_field_pruning.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/should_do_filter_pruning_on_expressionless_string_filters.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads_v3/test_partitioned_reads_v3.test"
			]
		}
	]
}
